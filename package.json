{
  "name": "medcid-planner",
  "version": "1.0.0",
  "description": "MEDCID Planner app",
  "scripts": {
    "start": "npx serve .",
    "cap:init": "npx cap init \"MEDCID Planner\" \"com.medcid.planner\" --web-dir .",
    "cap:android": "npx cap add android && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:sync": "npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/core": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "serve": "latest"
  }
}