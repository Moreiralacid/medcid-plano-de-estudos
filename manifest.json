    function editSubject(id){
      const subject=state.subjects.find(s=>s.id===id);if(!subject)return;const oldName=subject.name,name=prompt('Nome da disciplina:',subject.name);if(name===null)return;const clean=name.trim();if(!clean)return toast('O nome não pode ficar vazio.');if(state.subjects.some(s=>s.id!==id&&normalize(s.name)===normalize(clean)))return toast('Já existe uma disciplina com esse nome.');const weight=prompt('Peso da disciplina:',subject.weight),goal=prompt('Meta semanal em horas:',subject.goal),priority=prompt('Prioridade (Prioritária ou Complementar):',subject.priority);subject.name=clean;subject.weight=Math.max(1,Number(weight)||subject.weight);subject.goal=Math.max(1,Number(goal)||subject.goal);subject.priority=priority?.trim()||subject.priority;state.reviews.forEach(r=>{if(normalize(r.subject)===normalize(oldName))r.subject=clean;});state.tasks.forEach(t=>{if(normalize(t.subject)===normalize(oldName))t.subject=clean;});state.flashcards.forEach(c=>{if(normalize(c.subject)===normalize(oldName))c.subject=clean;});save();renderAll();toast('Disciplina atualizada.');
