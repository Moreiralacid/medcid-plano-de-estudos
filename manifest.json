    .device-status:before{content:"↔"}.device-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.device-tip{border:1px solid var(--line);border-radius:16px;background:var(--surface);padding:12px}.device-tip b{display:block;margin-bottom:4px}.device-tip span{color:var(--muted);font-size:.88rem;line-height:1.45}.rotate-hint{display:none;margin-top:10px;border:1px dashed var(--line);border-radius:16px;background:rgba(109,40,217,.08);padding:10px;color:var(--muted);font-weight:800}
