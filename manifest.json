    function loadState(){
      const start = todayISO();
      const examples=createSixthPeriodExamples(start);
      const defaults = {
        dataVersion:CURRENT_DATA_VERSION,config:{startDate:start, weeklyGoal:16, dailyQuestionsGoal:30, cycleName:'6º período'}, subjects:examples.subjects, schedule:[], reviews:examples.reviews, tasks:examples.tasks, questions:[], xp:0, dark:false,
        aiConnector:{mode:'external',provider:'chatgpt',customUrl:'',pendingFlashcards:null},customPrompts:[],
        pomodoro:{mode:'focus',focusMinutes:25,shortMinutes:5,longMinutes:15,remaining:1500,running:false,endAt:null,selectedTaskId:'',completedToday:0,sessionsDate:start},
        learningProfile:{goal:'',subject:'',style:'Casos clínicos',material:'',interests:[]},
        flashcards:[], habits:[
          {id:'habit-review',name:'Revisar flashcards',checks:{}},
          {id:'habit-questions',name:'Resolver questões',checks:{}},
          {id:'habit-active',name:'Fazer recordação ativa',checks:{}}
        ],
        recovery:{
          profile:{hours:3,reason:'Falta de planejamento',exams:0,projects:0,backlog:0,start:start},
          selfScores:Array(10).fill(3),assessments:{},plan:[],errors:[],checkins:[],
          weights:{urgency:25,importance:20,difficulty:15,backlog:15,weight:15,recovery:10}
        },
        sessionId:uid(),
      };
      try{
        const raw = localStorage.getItem(STORAGE_KEY);
        if(raw){
          const saved=JSON.parse(raw);
          const recovery=saved.recovery||{};
          const savedVersion=Number(saved.dataVersion||0),mustResetProgress=savedVersion<3,mustMigrateData=savedVersion<CURRENT_DATA_VERSION;
          const merged={...defaults,...saved,dataVersion:CURRENT_DATA_VERSION,xp:mustResetProgress?0:Number(saved.xp||0),config:{...defaults.config,...(saved.config||{})},aiConnector:{...defaults.aiConnector,...(saved.aiConnector||{}),mode:'external'},customPrompts:Array.isArray(saved.customPrompts)?saved.customPrompts:[],pomodoro:{...defaults.pomodoro,...(saved.pomodoro||{})},learningProfile:{...defaults.learningProfile,...(saved.learningProfile||{})},flashcards:Array.isArray(saved.flashcards)?saved.flashcards:[],habits:Array.isArray(saved.habits)&&saved.habits.length?saved.habits:defaults.habits,recovery:{...defaults.recovery,...recovery,profile:{...defaults.recovery.profile,...(recovery.profile||{})},weights:{...defaults.recovery.weights,...(recovery.weights||{})},selfScores:Array.isArray(recovery.selfScores)?recovery.selfScores:defaults.recovery.selfScores,assessments:recovery.assessments||{},plan:Array.isArray(recovery.plan)?recovery.plan:[],errors:Array.isArray(recovery.errors)?recovery.errors:[],checkins:Array.isArray(recovery.checkins)?recovery.checkins:[]},sessionId:saved.sessionId||uid()};
          delete merged.teacherChat;
          if(mustResetProgress){if(!Array.isArray(saved.subjects)||!saved.subjects.length)merged.subjects=defaults.subjects;if(!Array.isArray(saved.reviews)||!saved.reviews.length)merged.reviews=defaults.reviews;if(!Array.isArray(saved.tasks)||!saved.tasks.length)merged.tasks=defaults.tasks;}
          if(mustMigrateData)try{localStorage.setItem(STORAGE_KEY,JSON.stringify(merged));}catch(e){}
          return merged;
        }
      }catch(e){}
      return defaults;
    }
    function save(){
      try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); return true; }
      catch(e){ toast('Não foi possível salvar. Exporte um backup e libere espaço no navegador.'); return false; }
    }
    function toast(msg){ const t=$('#toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(toast._timer); toast._timer=setTimeout(()=>t.classList.remove('show'),2200); }
    function award(points){ state.xp = (state.xp||0)+Number(points||0); save(); renderAll(); }


    let deferredInstallPrompt = null;
    function setupPWA(){
      if(document.body.dataset.pwaReady) return;
      document.body.dataset.pwaReady = 'true';
      const installBtn = $('#installApp');
      if('serviceWorker' in navigator){
        window.addEventListener('load',()=>{
          navigator.serviceWorker.register('./service-worker.js').catch(()=>{});
        });
      }
      window.addEventListener('beforeinstallprompt', (event)=>{
        event.preventDefault();
        deferredInstallPrompt = event;
        if(installBtn) installBtn.style.display = 'inline-flex';
      });
      if(installBtn){
        installBtn.addEventListener('click', async ()=>{
          if(deferredInstallPrompt){
            deferredInstallPrompt.prompt();
            await deferredInstallPrompt.userChoice;
            deferredInstallPrompt = null;
            installBtn.style.display = 'none';
          } else {
            toast('No iPhone: Safari > Compartilhar > Adicionar à Tela de Início. No Android: Chrome > Instalar app.');
          }
        });
      }
      window.addEventListener('appinstalled',()=>toast('MEDCID instalado na tela inicial.'));
    }


    function setupResponsiveMode(){
      const apply = () => {
        const w = window.innerWidth || document.documentElement.clientWidth;
        const h = window.innerHeight || document.documentElement.clientHeight;
        const landscape = w > h;
        const device = w >= 1180 ? 'Computador' : w >= 721 ? 'Tablet' : 'Celular';
        document.body.dataset.device = device.toLowerCase();
        document.body.dataset.orientation = landscape ? 'paisagem' : 'retrato';
        const status = $('#deviceStatus');
        if(status) status.textContent = `${device} • ${landscape ? 'paisagem' : 'retrato'} • ${w}×${h}px`;
      };
      apply();
      if(document.body.dataset.responsiveReady) return;
      document.body.dataset.responsiveReady = 'true';
      window.addEventListener('resize', apply, {passive:true});
      window.addEventListener('orientationchange', () => setTimeout(apply, 250), {passive:true});
      if(screen.orientation && screen.orientation.addEventListener){
        screen.orientation.addEventListener('change', apply);
      }
    }

    function init(){
      document.body.classList.toggle('dark', !!state.dark);
      setupPWA();
      setupResponsiveMode();
      setupAccessibility();
