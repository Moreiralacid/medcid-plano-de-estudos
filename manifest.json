      .app{padding:8px}.hero{grid-template-columns:1fr auto;gap:10px;padding:12px 14px;border-radius:18px}.hero h1{font-size:1.55rem;letter-spacing:-.035em;margin:2px 0}.hero p:not(.eyebrow){display:none}.eyebrow{font-size:.68rem}.hero-actions{display:flex;gap:6px;max-width:52vw;justify-content:flex-end}.hero-actions .btn{font-size:.78rem;padding:7px 9px}.shell{grid-template-columns:190px 1fr;gap:10px;margin-top:10px}.sidebar{position:sticky;top:8px;max-height:calc(100vh - 16px);overflow:auto;border-radius:18px;padding:8px}.tabs{display:grid;gap:3px;overflow:visible}.tab{padding:8px;font-size:.84rem}.tab .ico{width:22px;height:22px}.quick-stats{display:none}.card{padding:12px;border-radius:18px}.dashboard{grid-template-columns:1.15fr .85fr}.stat-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.stat{padding:9px}.stat strong{font-size:1.35rem}.section-head{margin-bottom:10px}.section-head p{font-size:.88rem}.week-grid{grid-template-columns:60px repeat(7,minmax(120px,1fr))}.week-cell{min-height:50px;padding:5px}.week-pill{font-size:.7rem;line-height:1.2}.form.grid.five{grid-template-columns:repeat(5,minmax(0,1fr))}.form.grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}.subject-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.rotate-hint{display:none}.device-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
