    function handleDialogKeydown(e){
      const promptModal=$('#promptModal'),topicModal=$('#topicModal');
      const modal=promptModal.classList.contains('open')?promptModal:topicModal.classList.contains('open')?topicModal:null;
      if(!modal) return;
      if(e.key==='Escape'){ e.preventDefault(); modal===promptModal?closePromptModal():closeTopicModal(); return; }
      if(e.key!=='Tab') return;
      const focusable=$$('button,input,select,textarea').filter(el=>modal.contains(el)&&!el.disabled);
      if(!focusable.length) return;
      const first=focusable[0], last=focusable[focusable.length-1];
      if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}
      else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}
    }
