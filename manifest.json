      area.innerHTML=state.subjects.length?state.subjects.slice(0,7).map(s=>{const topics=s.topics||[];const done=topics.filter(t=>t.done).length;const pct=topics.length?Math.round(done/topics.length*100):0;return `<div class="subject-progress-row"><span class="subject-dot" style="background:${s.color}"></span><b>${escapeHtml(s.name)}</b><div class="progress"><span style="width:${pct}%"></span></div><small>${pct}%</small></div>`;}).join(''):'<div class="empty">Adicione suas matérias para acompanhar o progresso aqui.</div>';
    }
    function activityDates(){
      const dates=new Set();
      state.habits.forEach(h=>Object.entries(h.checks||{}).forEach(([date,done])=>{if(done)dates.add(date);}));
      state.tasks.filter(t=>t.done&&t.date).forEach(t=>dates.add(t.date));
      state.reviews.forEach(r=>(r.items||[]).filter(i=>i.done).forEach(i=>dates.add(i.completedAt||i.date)));
      state.flashcards.filter(c=>c.lastReviewed).forEach(c=>dates.add(c.lastReviewed));
      state.recovery.plan.filter(t=>t.status==='Concluída').forEach(t=>dates.add(addDays(state.recovery.profile.start||todayISO(),t.day||0)));
      state.recovery.checkins.forEach(c=>dates.add(c.date));
      return dates;
    }
    function calcStudyStreak(){
      const dates=activityDates(); let streak=0; const d=new Date();
      if(!dates.has(todayISO())) d.setDate(d.getDate()-1);
      while(dates.has(d.toISOString().slice(0,10))){streak++;d.setDate(d.getDate()-1);}
      return streak;
    }
    function weekDates(){const now=new Date();const day=now.getDay();const monday=new Date(now);monday.setDate(now.getDate()-((day+6)%7));return Array.from({length:7},(_,i)=>{const d=new Date(monday);d.setDate(monday.getDate()+i);return d.toISOString().slice(0,10);});}
    function weeklyStudyDays(){const active=activityDates();return weekDates().filter(date=>active.has(date)).length;}
    function renderDashboardWeek(){const area=$('#dashboardMiniWeek');if(!area)return;const dates=activityDates(),week=weekDates(),labels=['SEG','TER','QUA','QUI','SEX','SÁB','DOM'];area.innerHTML=week.map((date,i)=>`<div class="mini-day ${dates.has(date)?'done':''} ${date===todayISO()?'today':''}"><small>${labels[i]}</small><span>${date.slice(-2)}</span></div>`).join('');$('#dashboardWeekCaption').textContent=`Semana de ${fmtDate(week[0])} a ${fmtDate(week[6])} · hoje está destacado.`;}
    function renderPriorityBars(){
