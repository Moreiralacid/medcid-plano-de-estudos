      state.subjects.forEach(s=>(s.topics||[]).filter(t=>t.done).forEach(t=>{
        const exists=state.reviews.some(r=>normalize(r.subject)===normalize(s.name)&&normalize(r.topic)===normalize(t.name));
        if(!exists){ state.reviews.push({id:uid(),subject:s.name,topic:t.name,baseDate:t.created||todayISO(),priority:t.heat==='Muito cobrado'?'Alta':'Média',kind:'Teoria',items:REVIEW_STEPS.map(step=>({id:uid(),label:step.label,date:addDays(t.created||todayISO(),step.days),done:false,xp:step.xp}))}); count++; }
      }));
      save(); renderAll(); toast(`${count} revisões criadas a partir dos assuntos concluídos.`);
    }
    function renderReviews(){
      const filter=normalize($('#reviewFilter')?.value||''); const status=$('#reviewStatus')?.value||'all'; const t=todayISO();
      let rows=[]; state.reviews.forEach(r=>(r.items||[]).forEach(it=>rows.push({...it,parent:r})));
      rows=rows.filter(it=>{
        const text=normalize(`${it.parent.subject} ${it.parent.topic} ${it.date} ${it.label}`);
        const okText=!filter||text.includes(filter); const okStatus=status==='all'||(status==='today'&&it.date===t&&!it.done)||(status==='overdue'&&it.date<t&&!it.done)||(status==='pending'&&!it.done)||(status==='done'&&it.done);
        return okText&&okStatus;
      }).sort((a,b)=>a.date.localeCompare(b.date));
      $('#reviewTable').innerHTML = `<thead><tr><th>Status</th><th>Data</th><th>Rev.</th><th>Disciplina</th><th>Assunto</th><th>Prioridade</th><th>Ações</th></tr></thead><tbody>${rows.map(it=>{
        const cls=it.done?'green':it.date<t?'red':it.date===t?'orange':'blue'; const label=it.done?'Concluída':it.date<t?'Atrasada':it.date===t?'Hoje':'Programada';
        return `<tr><td><span class="badge ${cls}">${label}</span></td><td>${fmtDate(it.date)}</td><td><b>${it.label}</b></td><td>${escapeHtml(it.parent.subject)}</td><td>${escapeHtml(it.parent.topic)}</td><td>${priorityBadge(it.parent.priority)}</td><td class="actions"><button class="btn small soft" onclick="completeReview('${it.parent.id}','${it.id}')">${it.done?'Desmarcar':'Check'}</button><button class="btn small ghost" onclick="editReviewGroup('${it.parent.id}')">Editar grupo</button><button class="btn small ghost" onclick="deleteReviewGroup('${it.parent.id}')">Excluir grupo</button></td></tr>`;
      }).join('') || `<tr><td colspan="7"><div class="empty">Nenhuma revisão encontrada.</div></td></tr>`}</tbody>`;
    }
    function priorityBadge(p){ const c=p==='Alta'?'red':p==='Média'?'orange':'green'; return `<span class="badge ${c}">${escapeHtml(p||'Média')}</span>`; }
    function completeReview(rid,iid){ const r=state.reviews.find(x=>x.id===rid); const it=r?.items?.find(x=>x.id===iid); if(it){ it.done=!it.done; it.completedAt=it.done?todayISO():null; if(it.done) state.xp=(state.xp||0)+(it.xp||20); save(); renderAll(); } }
    function editReviewGroup(id){const group=state.reviews.find(r=>r.id===id);if(!group)return;if(group.examSubjectId)return toast('Edite a data da prova na matriz de prioridades.');const subject=prompt('Disciplina da revisão:',group.subject);if(subject===null)return;const topic=prompt('Assunto da revisão:',group.topic);if(topic===null)return;const baseDate=prompt('Data-base no formato AAAA-MM-DD:',group.baseDate||todayISO());if(baseDate===null)return;if(!/^\d{4}-\d{2}-\d{2}$/.test(baseDate))return toast('Use a data no formato AAAA-MM-DD.');group.subject=subject.trim()||group.subject;group.topic=topic.trim()||group.topic;group.baseDate=baseDate;group.items=REVIEW_STEPS.map(step=>{const current=(group.items||[]).find(item=>item.label===step.label);return {id:current?.id||uid(),label:step.label,date:addDays(baseDate,step.days),done:!!current?.done,completedAt:current?.completedAt||null,xp:current?.xp||step.xp};});save();renderAll();toast('Grupo de revisões atualizado.');}
    function deleteReviewGroup(id){const group=state.reviews.find(r=>r.id===id);if(!group)return;if(group.examSubjectId){if(!confirm('Excluir esta agenda pré-prova e apagar a data da prova vinculada?'))return;const assessment=state.recovery.assessments[String(group.examSubjectId)];if(assessment)assessment.exam='';}else if(!confirm('Excluir este grupo de revisões?'))return;state.reviews=state.reviews.filter(r=>r.id!==id);save();renderAll();}

    function syncExamReview(subject,examDate){
      const subjectId=String(subject.id),index=state.reviews.findIndex(r=>String(r.examSubjectId||'')===subjectId),current=index>=0?state.reviews[index]:null;
      if(!examDate){if(index>=0){state.reviews.splice(index,1);return true;}return false;}
      const previous=current?.items||[];
      const items=EXAM_REVIEW_OFFSETS.map(offset=>{const old=previous.find(item=>Number(item.examOffset)===offset);return {id:old?.id||uid(),label:`D-${offset}`,date:addDays(examDate,-offset),done:!!old?.done,completedAt:old?.completedAt||null,xp:old?.xp||25,examOffset:offset};});
      const next={id:current?.id||uid(),subject:subject.name,topic:`Preparação para prova de ${subject.name}`,baseDate:items[0].date,priority:'Alta',kind:'Pré-prova',examSubjectId:subjectId,examDate,items};
      if(current){const changed=JSON.stringify(current)!==JSON.stringify(next);state.reviews[index]=next;return changed;}
      state.reviews.push(next);return true;
    }
    function syncAllExamReviews(){let changed=false;const validIds=new Set(state.subjects.map(s=>String(s.id)));const before=state.reviews.length;state.reviews=state.reviews.filter(r=>!r.examSubjectId||validIds.has(String(r.examSubjectId)));changed=state.reviews.length!==before||changed;state.subjects.forEach(subject=>{const exam=subjectAssessment(subject).exam;if(syncExamReview(subject,exam))changed=true;});return changed;}
    function moveReviewCalendar(months){calendarCursor=new Date(calendarCursor.getFullYear(),calendarCursor.getMonth()+months,1);renderReviewCalendar();}

    function renderReviewCalendar(){
      const area=$('#reviewCalendarGrid'); if(!area) return;
      const year=calendarCursor.getFullYear(); const month=calendarCursor.getMonth();
      $('#calendarMonthLabel').textContent=new Date(year,month,1).toLocaleDateString('pt-BR',{month:'long',year:'numeric'}).replace(/^./,m=>m.toUpperCase());
      const heads=['SEG','TER','QUA','QUI','SEX','SÁB','DOM'].map(x=>`<div class="month-head">${x}</div>`).join('');
      const first=new Date(year,month,1); const startOffset=(first.getDay()+6)%7; const start=new Date(year,month,1-startOffset);
      const reviews=state.reviews.flatMap(r=>(r.items||[]).filter(i=>!i.done).map(i=>({date:i.date,type:r.examSubjectId?'exam-review':'review',title:`${r.examSubjectId?'Pré-prova':'Revisão'}: ${r.subject} · ${i.label}`})));
      const cards=state.flashcards.map(c=>({date:c.nextReview||todayISO(),type:'flash',title:`Flashcard: ${c.subject} · ${c.topic}`}));
      const exams=state.subjects.flatMap(subject=>{const exam=subjectAssessment(subject).exam;return exam?[{date:exam,type:'exam',title:`Prova: ${subject.name}`,subject:subject.name}]:[];});
      const all=[...exams,...reviews,...cards];
      const days=Array.from({length:42},(_,i)=>{const d=new Date(start);d.setDate(start.getDate()+i);const iso=d.toISOString().slice(0,10);const events=all.filter(e=>e.date===iso).sort((a,b)=>a.type==='exam'?-1:b.type==='exam'?1:0).slice(0,7);const exam=events.find(e=>e.type==='exam');return `<div class="month-day ${d.getMonth()!==month?'muted':''} ${iso===todayISO()?'today':''}" aria-label="${fmtDate(iso)}">${d.getDate()}${exam?`<span class="exam-chip" title="${escapeHtml(exam.title)}">PROVA · ${escapeHtml(exam.subject)}</span>`:''}<div class="day-dots">${events.map(e=>`<i class="${e.type}" title="${escapeHtml(e.title)}"></i>`).join('')}</div></div>`;}).join('');
      area.innerHTML=heads+days;
    }

    /* ===== Projeto Angels ===== */
    function hydrateRecoveryForms(){
      const p=state.recovery.profile;
      $('#angelsHours').value=p.hours||3;$('#angelsBacklog').value=p.backlog||0;$('#angelsExams').value=p.exams||0;$('#angelsProjects').value=p.projects||0;$('#angelsReason').value=p.reason||'Falta de planejamento';
      const check=state.recovery.checkins.find(c=>c.date===todayISO());
      if(check){$('#checkinExecution').value=check.execution;$('#checkinEnergy').value=check.energy;$('#checkinFocus').value=check.focus;$('#checkinChallenge').value=check.challenge||'';$('#checkinWin').value=check.win||'';$('#checkinExecutionValue').textContent=check.execution+'%';$('#checkinEnergyValue').textContent=check.energy+'/5';$('#checkinFocusValue').textContent=check.focus+'/5';}
    }
    function diagnosisPercent(){const scores=state.recovery.selfScores||[];return scores.length?Math.round(scores.reduce((a,b)=>a+Number(b||0),0)/(scores.length*5)*100):0;}
    function renderDiagnosis(){
      const area=$('#diagnosisQuestionList');if(!area)return;
      const profile=state.recovery.profile;$('#angelsHours').value=profile.hours||3;$('#angelsBacklog').value=profile.backlog||0;$('#angelsExams').value=profile.exams||0;$('#angelsProjects').value=profile.projects||0;$('#angelsReason').value=profile.reason||'Falta de planejamento';
      area.innerHTML=DIAGNOSIS_QUESTIONS.map((question,i)=>`<div class="score-question"><header><b>${i+1}. ${escapeHtml(question)}</b><output>${state.recovery.selfScores[i]||3}</output></header><input id="diagnosisScore${i}" type="range" min="1" max="5" value="${state.recovery.selfScores[i]||3}" oninput="this.previousElementSibling.querySelector('output').textContent=this.value"><div class="scale-labels"><span>Discordo</span><span>Concordo</span></div></div>`).join('');
      const pct=diagnosisPercent();$('#diagnosisScoreValue').textContent=pct+'%';$('#diagnosisScoreRing').style.setProperty('--score-deg',pct*3.6+'deg');
      $('#diagnosisReading').textContent=pct<45?'O cenário pede simplificação: escolha uma prioridade e proteja um bloco curto por dia.':pct<70?'Você já possui alguma estrutura, mas há pontos frágeis que o plano pode estabilizar.':'Sua base de organização está consistente; o foco agora é manter execução e qualidade.';
    }
    function saveDiagnosis(){
      state.recovery.profile={...state.recovery.profile,hours:Number($('#angelsHours').value||3),backlog:Number($('#angelsBacklog').value||0),exams:Number($('#angelsExams').value||0),projects:Number($('#angelsProjects').value||0),reason:$('#angelsReason').value,start:state.recovery.profile.start||todayISO()};
      state.recovery.selfScores=DIAGNOSIS_QUESTIONS.map((_,i)=>Number($(`#diagnosisScore${i}`).value||3));state.xp=(state.xp||0)+15;save();renderAll();toast('Diagnóstico salvo. Agora avalie as prioridades.');showTab('prioridades');
    }
    function assessmentDefaults(subject){return {exam:'',grade:0,backlog:0,difficulty:3,mastery:3,urgency:subject.priority==='Prioritária'?4:3,importance:Math.max(2,Math.min(5,Math.round((subject.weight||3)/2))),recovery:3,hours:subject.goal||4,note:''};}
    function subjectAssessment(subject){return {...assessmentDefaults(subject),...(state.recovery.assessments[String(subject.id)]||{})};}
    function recoveryPriorityScore(subject){const a=subjectAssessment(subject),w=state.recovery.weights;return Math.round((Number(a.urgency)*w.urgency+Number(a.importance)*w.importance+Number(a.difficulty)*w.difficulty+Math.min(Number(a.backlog),5)*w.backlog+Math.min(Math.max(Number(subject.weight||1),1),5)*w.weight+Number(a.recovery)*w.recovery)/5);}
    function rankedRecoverySubjects(){return [...state.subjects].map(s=>({...s,recoveryScore:recoveryPriorityScore(s)})).sort((a,b)=>b.recoveryScore-a.recoveryScore);}
    function recoveryPriorityLabel(score){return score>=80?'Crítica':score>=65?'Alta':score>=45?'Moderada':score>=25?'Baixa':'Monitorar';}
    function renderPriorities(){
      const weights=$('#priorityWeightGrid');if(!weights)return;const total=Object.values(state.recovery.weights).reduce((a,b)=>a+Number(b),0);$('#priorityWeightTotal').textContent=total+'%';
      weights.innerHTML=Object.entries(state.recovery.weights).map(([key,value])=>`<label class="weight-row"><span>${PRIORITY_LABELS[key]} <b>${value}%</b></span><input type="range" min="0" max="40" value="${value}" onchange="updatePriorityWeight('${key}',this.value)"></label>`).join('');
      const ranked=rankedRecoverySubjects();$('#topPriorityName').textContent=ranked[0]?.name||'Nenhuma matéria';$('#highPriorityCount').textContent=ranked.filter(s=>s.recoveryScore>=65).length;$('#assessedSubjectCount').textContent=state.subjects.length;
      const area=$('#priorityCards');area.innerHTML=ranked.length?ranked.map((s,index)=>{const a=subjectAssessment(s),label=recoveryPriorityLabel(s.recoveryScore);return `<article class="priority-card"><div class="priority-score"><div><strong>${s.recoveryScore}</strong><small>${label}</small></div></div><div><span class="badge ${s.recoveryScore>=80?'red':s.recoveryScore>=65?'orange':s.recoveryScore>=45?'yellow':'green'}">#${index+1} · ${label}</span><h3>${escapeHtml(s.name)}</h3><p>${escapeHtml(a.note||'Preencha os dados para refinar o cálculo.')}</p><div class="priority-factors"><span class="badge gray">Peso ${s.weight||1}</span><span class="badge gray">Meta ${s.goal||1}h/sem</span><span class="badge gray">Domínio ${a.mastery}/5</span></div></div><div class="priority-fields"><div class="field"><label>Próxima prova</label><input type="date" value="${a.exam||''}" onchange="updateSubjectAssessment('${s.id}','exam',this.value)"></div><div class="field"><label>Nota atual</label><input type="number" min="0" max="10" step="0.1" value="${a.grade||0}" onchange="updateSubjectAssessment('${s.id}','grade',this.value)"></div><div class="field"><label>Atrasos</label><input type="number" min="0" max="20" value="${a.backlog||0}" onchange="updateSubjectAssessment('${s.id}','backlog',this.value)"></div>${['difficulty','mastery','urgency','importance','recovery'].map(key=>`<div class="field"><label>${{difficulty:'Dificuldade',mastery:'Domínio',urgency:'Urgência',importance:'Importância',recovery:'Recuperação'}[key]}</label><select onchange="updateSubjectAssessment('${s.id}','${key}',this.value)">${[1,2,3,4,5].map(n=>`<option value="${n}" ${Number(a[key])===n?'selected':''}>${n}/5</option>`).join('')}</select></div>`).join('')}<div class="field" style="grid-column:1/-1"><label>Observação</label><input value="${escapeHtml(a.note||'')}" placeholder="Ponto de atenção" onchange="updateSubjectAssessment('${s.id}','note',this.value)"></div></div></article>`;}).join(''):'<div class="empty">Cadastre suas disciplinas antes de calcular as prioridades. <button class="btn small soft" onclick="showTab(\'disciplinas\')">Abrir disciplinas</button></div>';
    }
    function updateSubjectAssessment(id,key,value){const subject=state.subjects.find(s=>String(s.id)===String(id));if(!subject)return;const numeric=['grade','backlog','difficulty','mastery','urgency','importance','recovery','hours'].includes(key);state.recovery.assessments[String(id)]={...subjectAssessment(subject),[key]:numeric?Number(value):value};if(key==='exam'){syncExamReview(subject,value);if(value){calendarCursor=new Date(parseISO(value).getFullYear(),parseISO(value).getMonth(),1);toast('Prova salva e revisões D-30, D-15, D-7, D-3 e D-1 agendadas.');}else toast('Data da prova e agenda pré-prova removidas.');}save();renderPriorities();renderReviews();renderReviewCalendar();renderAngelsDashboard();renderRecoveryReport();}
    function updatePriorityWeight(key,value){state.recovery.weights[key]=Number(value);save();renderPriorities();renderAngelsDashboard();renderRecoveryReport();}
    function recoveryPlanMetrics(){const tasks=state.recovery.plan;const done=tasks.filter(t=>t.status==='Concluída'),partial=tasks.filter(t=>t.status==='Parcial');const execution=tasks.length?Math.round((done.length+partial.length*.5)/tasks.length*100):0;const minutes=done.reduce((a,t)=>a+Number(t.minutes||0),0)+partial.reduce((a,t)=>a+Number(t.minutes||0)*.5,0);const questions=done.reduce((a,t)=>a+Number(t.questions||0),0)+Math.round(partial.reduce((a,t)=>a+Number(t.questions||0)*.5,0));return {tasks:tasks.length,done:done.length,execution,minutes:Math.round(minutes),questions};}
    function generateRecoveryPlan(){
      const ranked=rankedRecoverySubjects();if(!ranked.length){toast('Cadastre ao menos uma disciplina.');showTab('disciplinas');return;}if(state.recovery.plan.length&&!confirm('Substituir o plano atual por um novo ciclo de sete dias?'))return;
      const daily=Math.max(60,Number(state.recovery.profile.hours||3)*60),top=ranked.slice(0,Math.min(3,ranked.length));let plan=[];for(let day=0;day<7;day++){const s=top[day%top.length],topics=(s.topics||[]).filter(t=>!t.done),topic=topics[day%Math.max(1,topics.length)]?.name||subjectAssessment(s).note||`Fundamentos prioritários de ${s.name}`;plan.push({id:uid(),day,type:'Estudo principal',subject:s.name,topic,method:'Teoria direcionada + recordação ativa',minutes:Math.round(daily*.6),questions:0,status:'Pendente'});plan.push({id:uid(),day,type:'Revisão',subject:s.name,topic:`Revisar ${topic}`,method:'Recordação ativa',minutes:Math.round(daily*.2),questions:0,status:'Pendente'});plan.push({id:uid(),day,type:'Questões',subject:s.name,topic:`Aplicar ${topic}`,method:'Questões comentadas',minutes:Math.round(daily*.15),questions:Math.max(5,Math.round(daily*.15/3)),status:'Pendente'});}state.recovery.profile.start=todayISO();state.recovery.plan=plan;state.xp=(state.xp||0)+20;save();renderAll();showTab('plano7');toast('Plano de sete dias criado com disciplina e assunto definidos.');
    }
    function renderRecoveryPlan(){const area=$('#planWeek');if(!area)return;const m=recoveryPlanMetrics();$('#planTaskCount').textContent=m.tasks;$('#planExecutionRate').textContent=m.execution+'%';$('#planMinutesDone').textContent=(m.minutes/60).toFixed(1)+'h';$('#planQuestionsDone').textContent=m.questions;$('#planEmpty').style.display=m.tasks?'none':'block';area.style.display=m.tasks?'grid':'none';const start=state.recovery.profile.start||todayISO();area.innerHTML=Array.from({length:7},(_,day)=>{const date=addDays(start,day),weekday=parseISO(date).toLocaleDateString('pt-BR',{weekday:'short'}).replace('.','').toUpperCase(),tasks=state.recovery.plan.filter(t=>t.day===day);return `<article class="plan-day ${date===todayISO()?'today':''}"><header><div><b>${weekday} · Dia ${day+1}</b><br><span>${fmtDate(date)}</span></div><span>${tasks.filter(t=>t.status==='Concluída').length}/${tasks.length}</span></header>${tasks.map(t=>`<div class="plan-task ${t.status==='Concluída'?'completed':t.status==='Parcial'?'partial':''}" onclick="advancePlanTask('${t.id}')"><span class="task-type">${escapeHtml(t.type)}</span><b>Disciplina: ${escapeHtml(t.subject)}</b><small><strong>Assunto:</strong> ${escapeHtml(t.topic)}</small><small>${escapeHtml(t.method||'Estudo ativo')} · ${t.minutes} min${t.questions?' · '+t.questions+' questões':''} · ${t.status}</small></div>`).join('')}</article>`;}).join('');}
    function advancePlanTask(id){const task=state.recovery.plan.find(t=>t.id===id);if(!task)return;const states=['Pendente','Parcial','Concluída'];task.status=states[(states.indexOf(task.status)+1)%states.length];if(task.status==='Concluída')state.xp=(state.xp||0)+10;save();renderAll();}
    function addRecoveryError(){const subject=$('#errorSubject').value.trim(),topic=$('#errorTopic').value.trim(),concept=$('#errorConcept').value.trim();if(!subject||!topic||!concept)return toast('Informe disciplina, assunto e conceito correto.');state.recovery.errors.unshift({id:uid(),date:todayISO(),subject,topic,origin:$('#errorOrigin').value,type:$('#errorType').value,importance:Number($('#errorImportance').value),status:$('#errorStatus').value,concept});$('#errorTopic').value='';$('#errorConcept').value='';state.xp=(state.xp||0)+5;save();renderAll();toast('Erro registrado e conectado ao seu progresso.');}
    function renderRecoveryErrors(){const area=$('#errorList');if(!area)return;const filter=$('#errorFilter').value;let errors=state.recovery.errors;if(filter!=='Todos')errors=errors.filter(e=>e.status===filter);const open=state.recovery.errors.filter(e=>e.status!=='Corrigido').length;$('#openErrorsBadge').textContent=open+' aberto'+(open===1?'':'s');const types={};state.recovery.errors.forEach(e=>types[e.type]=(types[e.type]||0)+1);const top=Object.entries(types).sort((a,b)=>b[1]-a[1])[0];$('#errorPatternSummary').textContent=top?`Padrão mais frequente: ${top[0]} (${top[1]} registro${top[1]===1?'':'s'}).`:'Os padrões aparecerão após os primeiros registros.';area.innerHTML=errors.length?errors.map(e=>`<article class="error-card ${e.status==='Recorrente'?'recurring':''}"><header><div><span class="badge ${e.status==='Corrigido'?'green':e.status==='Recorrente'?'red':'orange'}">${escapeHtml(e.status)}</span><span class="badge gray">Importância ${e.importance}/5</span></div><small class="muted">${fmtDate(e.date)}</small></header><h3>${escapeHtml(e.topic)} · ${escapeHtml(e.subject)}</h3><div class="error-meta"><span class="badge gray">${escapeHtml(e.origin)}</span><span class="badge gray">${escapeHtml(e.type)}</span></div><p class="error-concept"><b>Correção:</b> ${escapeHtml(e.concept)}</p><div class="error-actions"><button class="btn small soft" onclick="errorToReview('${e.id}')">Criar revisão + card</button><button class="btn small soft" onclick="askProfessorAboutError('${e.id}')">Perguntar à IA</button><button class="btn small ghost" onclick="markErrorCorrected('${e.id}')">${e.status==='Corrigido'?'Reabrir':'Marcar corrigido'}</button><button class="btn small ghost" onclick="deleteRecoveryError('${e.id}')">Excluir</button></div></article>`).join(''):'<div class="empty">Nenhum erro neste filtro.</div>';}
    function errorToReview(id){const e=state.recovery.errors.find(x=>x.id===id);if(!e)return;const exists=state.reviews.some(r=>normalize(r.subject)===normalize(e.subject)&&normalize(r.topic)===normalize(e.topic));if(!exists)state.reviews.push({id:uid(),subject:e.subject,topic:e.topic,baseDate:todayISO(),priority:e.importance>=4?'Alta':'Média',kind:'Erro',items:REVIEW_STEPS.map(step=>({id:uid(),label:step.label,date:addDays(todayISO(),step.days),done:false,xp:step.xp}))});state.flashcards.unshift({id:uid(),subject:e.subject,topic:e.topic,question:`Qual conceito corrige o erro em ${e.topic}?`,answer:e.concept,tip:`Erro do tipo: ${e.type}`,difficulty:e.importance>=4?'Difícil':'Médio',createdAt:todayISO(),nextReview:todayISO(),stage:0,reviewCount:0,correctCount:0});e.status='Em revisão';save();renderAll();toast('Revisão e flashcard criados a partir do erro.');}
    function askProfessorAboutError(id){const e=state.recovery.errors.find(x=>x.id===id);if(!e)return;showTab('professor');$('#promptSubject').value=e.subject;$('#promptTopic').value=e.topic;$('#promptObjective').value='Corrigir meu raciocínio e impedir que o erro se repita';$('#promptMaterial').value=`Tipo de erro: ${e.type}. Conceito correto registrado: ${e.concept}`;const template=PROMPT_TEMPLATES.find(item=>item.id==='auditor-erros');openPromptModal('Auditor de erros',adaptPrompt(template.body));}
    function markErrorCorrected(id){const e=state.recovery.errors.find(x=>x.id===id);if(!e)return;e.status=e.status==='Corrigido'?'Em revisão':'Corrigido';save();renderAll();}
    function deleteRecoveryError(id){if(!confirm('Excluir este registro do banco de erros?'))return;state.recovery.errors=state.recovery.errors.filter(e=>e.id!==id);save();renderAll();}
    function saveRecoveryCheckin(){const entry={date:todayISO(),execution:Number($('#checkinExecution').value),energy:Number($('#checkinEnergy').value),focus:Number($('#checkinFocus').value),challenge:$('#checkinChallenge').value.trim(),win:$('#checkinWin').value.trim()};state.recovery.checkins=state.recovery.checkins.filter(c=>c.date!==entry.date);state.recovery.checkins.unshift(entry);state.xp=(state.xp||0)+5;save();renderAll();toast('Check-in de hoje salvo.');}
    function renderRecoveryProgress(){const m=recoveryPlanMetrics();if(!$('#progressExecution'))return;$('#progressExecution').textContent=m.execution+'%';$('#progressHours').textContent=(m.minutes/60).toFixed(1)+'h';$('#progressQuestions').textContent=m.questions;$('#progressRecurringErrors').textContent=state.recovery.errors.filter(e=>e.status==='Recorrente').length;const chart=$('#executionChart');chart.innerHTML=Array.from({length:7},(_,day)=>{const tasks=state.recovery.plan.filter(t=>t.day===day),done=tasks.filter(t=>t.status==='Concluída').length,partial=tasks.filter(t=>t.status==='Parcial').length,pct=tasks.length?Math.round((done+partial*.5)/tasks.length*100):0;return `<div><b>${pct}%</b><i style="height:${Math.max(4,pct)}%"></i><small>D${day+1}</small></div>`;}).join('');const history=$('#checkinHistory');history.innerHTML=state.recovery.checkins.length?state.recovery.checkins.slice(0,7).map(c=>`<div class="checkin-row"><b>${fmtDate(c.date)}</b><div><span class="badge blue">Execução ${c.execution}%</span> <span class="badge gray">Energia ${c.energy}/5</span> <span class="badge gray">Foco ${c.focus}/5</span><br><small class="muted">${escapeHtml(c.challenge||'Sem desafio registrado')}${c.win?' · Vitória: '+escapeHtml(c.win):''}</small></div><span>${c.win?'✓':'•'}</span></div>`).join(''):'<div class="empty">Faça o primeiro check-in para acompanhar energia e foco.</div>';}
    function reportRecommendations(){const m=recoveryPlanMetrics(),list=[];if(!state.subjects.length)list.push('Cadastre as disciplinas e respectivos assuntos.');else list.push(`Proteja primeiro o bloco de ${rankedRecoverySubjects()[0]?.name}.`);if(m.execution<60)list.push('Reduza a duração dos blocos e mantenha apenas a prioridade principal até recuperar consistência.');else list.push('Mantenha o volume atual e preserve uma margem livre para imprevistos.');if(state.recovery.errors.some(e=>e.status==='Recorrente'))list.push('Converta os erros recorrentes em flashcards e revisões curtas.');if(dueFlashcards().length||overdueReviews().length)list.push('Comece pelas revisões vencidas antes de abrir teoria nova.');list.push('Faça um check-in no fim do dia e ajuste amanhã com base na energia real.');return list;}
    function recoveryReportText(){const m=recoveryPlanMetrics(),top=rankedRecoverySubjects()[0],open=state.recovery.errors.filter(e=>e.status!=='Corrigido').length;return `MEDCID · PROJETO ANGELS\nExecução: ${m.execution}%\nPrioridade principal: ${top?.name||'não definida'}\nHoras realizadas: ${(m.minutes/60).toFixed(1)}h\nQuestões realizadas: ${m.questions}\nErros abertos: ${open}\nClareza do diagnóstico: ${diagnosisPercent()}%\n\nRecomendações:\n- ${reportRecommendations().join('\n- ')}`;}
    function renderRecoveryReport(){if(!$('#reportStats'))return;const m=recoveryPlanMetrics(),top=rankedRecoverySubjects()[0],open=state.recovery.errors.filter(e=>e.status!=='Corrigido').length,recurring=state.recovery.errors.filter(e=>e.status==='Recorrente').length;$('#reportExecutionBig').textContent=m.execution;$('#reportCycleSummary').textContent=`Ciclo iniciado em ${fmtDate(state.recovery.profile.start||todayISO())} · ${state.config.cycleName} · dados armazenados neste dispositivo`;$('#reportStats').innerHTML=[[state.subjects.length,'disciplinas mapeadas'],[m.done,'tarefas concluídas'],[m.questions,'questões realizadas'],[open,'erros abertos']].map(([v,l])=>`<div class="report-stat"><strong>${v}</strong><span>${l}</span></div>`).join('');$('#reportObservedText').innerHTML=`A principal dificuldade informada foi <b>${escapeHtml(state.recovery.profile.reason.toLowerCase())}</b>. Há ${state.recovery.profile.backlog} conteúdo(s) atrasado(s), disponibilidade média de ${state.recovery.profile.hours} hora(s) por dia e ${recurring} erro(s) recorrente(s).`;$('#reportPriorityTitle').textContent=top?`${top.name} é a prioridade atual`:'A prioridade principal ainda não foi definida';$('#reportInferenceText').textContent=top?`${top.name} alcançou ${top.recoveryScore}/100 (${recoveryPriorityLabel(top.recoveryScore).toLowerCase()}) pela combinação dos critérios registrados. A execução do plano está em ${m.execution}%.`:'Cadastre disciplinas e preencha os critérios da matriz para gerar uma interpretação comparativa.';$('#reportRecommendations').innerHTML=reportRecommendations().map(x=>`<li>${escapeHtml(x)}</li>`).join('');}
    function renderAngelsDashboard(){const ranked=rankedRecoverySubjects(),m=recoveryPlanMetrics(),open=state.recovery.errors.filter(e=>e.status!=='Corrigido').length;$('#angelsDiagnosisMetric').textContent=diagnosisPercent()+'%';$('#angelsPriorityMetric').textContent=ranked[0]?.name||'—';$('#angelsExecutionMetric').textContent=m.execution+'%';$('#angelsErrorsMetric').textContent=open;}
    function copyRecoveryReport(){navigator.clipboard.writeText(recoveryReportText()).then(()=>toast('Resumo copiado.')).catch(()=>toast('Não foi possível copiar.'));}
    function csvCell(value){const text=String(value??'');return /[",\n]/.test(text)?`"${text.replace(/"/g,'""')}"`:text;}
    function downloadTextFile(name,content,type){const blob=new Blob([content],{type});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),0);}
    function exportRecoveryPlanCsv(){const rows=[['dia','data','tipo','disciplina','conteudo','minutos','questoes','status'],...state.recovery.plan.map(t=>[t.day+1,addDays(state.recovery.profile.start||todayISO(),t.day),t.type,t.subject,t.topic,t.minutes,t.questions,t.status])];downloadTextFile(`medcid-angels-plano-${todayISO()}.csv`,rows.map(r=>r.map(csvCell).join(',')).join('\n'),'text/csv;charset=utf-8');toast('Plano exportado.');}

    function hydrateAIConnector(){
      const connector=state.aiConnector||{};
      $('#aiProvider').value=AI_PROVIDERS[connector.provider]?connector.provider:'chatgpt';
      $('#aiCustomUrl').value=connector.customUrl||'';
      toggleCustomProviderField();
      renderAIConnector();
    }
    function toggleCustomProviderField(){
      const field=$('#customProviderField');if(field)field.style.display=$('#aiProvider')?.value==='custom'?'grid':'none';
    }
    function selectedProvider(connector=state.aiConnector||{}){
      return AI_PROVIDERS[connector.provider]||AI_PROVIDERS.chatgpt;
    }
    function validatedProviderUrl(connector=state.aiConnector||{}){
      const raw=connector.provider==='custom'?String(connector.customUrl||'').trim():selectedProvider(connector).url;
      try{const url=new URL(raw);return url.protocol==='https:'?url.href:'';}catch(e){return '';}
    }
    function saveAIConnector(){
      const connector={...(state.aiConnector||{}),mode:'external',provider:$('#aiProvider').value,customUrl:$('#aiCustomUrl').value.trim()};
      if(connector.provider==='custom'&&!validatedProviderUrl(connector))return toast('Informe um endereço HTTPS válido para sua IA.');
      state.aiConnector=connector;save();renderAIConnector();toast(`IA preferida salva: ${selectedProvider(connector).label}.`);
    }
    function testAIConnector(){
      const connector={...(state.aiConnector||{}),provider:$('#aiProvider').value,customUrl:$('#aiCustomUrl').value.trim()};
      const url=validatedProviderUrl(connector);if(!url)return toast('Informe um endereço HTTPS válido para sua IA.');
      window.open(url,'_blank','noopener,noreferrer');
    }
    function renderAIConnector(){
      const flashBadge=$('#flashModeBadge');if(flashBadge)flashBadge.textContent='Prompt inteligente';
      const flashButton=$('#generateFlashcards');if(flashButton&&!flashButton.disabled)flashButton.textContent='Preparar prompt de flashcards';
    }
    function openPromptModal(title,prompt){
      const modal=$('#promptModal');promptReturnFocus=document.activeElement;$('#promptModalTitle').textContent=title;$('#promptProviderLabel').textContent=`Destino: ${selectedProvider().label}`;$('#externalPromptText').value=prompt;modal.classList.add('open');modal.setAttribute('aria-hidden','false');$('#externalPromptText').focus();$('#externalPromptText').select();
    }
    function closePromptModal(){const modal=$('#promptModal');modal.classList.remove('open');modal.setAttribute('aria-hidden','true');promptReturnFocus?.focus();}
    async function copyText(text){
      if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(text);return;}
      const area=document.createElement('textarea');area.value=text;area.style.position='fixed';area.style.opacity='0';document.body.appendChild(area);area.select();const copied=document.execCommand('copy');area.remove();if(!copied)throw new Error('Falha ao copiar');
    }
    function copyExternalPrompt(){copyText($('#externalPromptText').value).then(()=>toast('Prompt copiado.')).catch(()=>toast('Não foi possível copiar automaticamente. Selecione o texto e copie.'));}
    function copyAndOpenExternalPrompt(){
      const url=validatedProviderUrl();if(!url)return toast('Configure primeiro um endereço válido para sua IA.');
      window.open(url,'_blank','noopener,noreferrer');copyText($('#externalPromptText').value).then(()=>toast('Prompt copiado. Cole-o na IA que foi aberta.')).catch(()=>toast('A IA foi aberta. Selecione e copie o prompt manualmente.'));
    }

    function hydrateLearningProfile(){
      const p=state.learningProfile||{}; $('#flowGoal').value=p.goal||''; $('#flowSubject').value=p.subject||''; $('#flowStyle').value=p.style||'Casos clínicos'; $('#flowMaterial').value=p.material||'';
      $$('#interestGrid input').forEach(input=>input.checked=(p.interests||[]).includes(input.value));
    }
    function readLearningProfileForm(){return {goal:$('#flowGoal').value.trim(),subject:$('#flowSubject').value.trim(),style:$('#flowStyle').value,material:$('#flowMaterial').value.trim(),interests:$$('#interestGrid input:checked').map(i=>i.value)};}
    function saveLearningProfile(){
      state.learningProfile=readLearningProfileForm();
      save(); renderLearningProfile(); award(10); toast('Jornada personalizada salva.');
    }
    function renderLearningProfile(){
      const p=state.learningProfile||{}; const has=Boolean(p.goal||p.subject||p.interests?.length);
      const preview=$('#flowPreviewText'); if(preview) preview.textContent=has?`Objetivo atual: ${p.goal||'aprofundar '+(p.subject||'os conteúdos do período')}. Aulas em formato de ${String(p.style||'casos clínicos').toLowerCase()}.`:'Configure seu objetivo para criar uma trilha integrada.';
      const status=$('#promptProfileStatus'); if(status) status.textContent=has?`${p.subject||'Todas as matérias'} · ${p.style||'Aprendizagem ativa'}${p.interests?.length?' · Analogias com '+p.interests.slice(0,2).join(' e '):''}`:'Configure o Flowing para adaptar automaticamente os modelos.';
      if($('#promptSubject')&&!$('#promptSubject').value)$('#promptSubject').value=p.subject||'';
      if($('#promptObjective')&&!$('#promptObjective').value)$('#promptObjective').value=p.goal||'';
      if($('#promptMaterial')&&!$('#promptMaterial').value)$('#promptMaterial').value=p.material||'';
    }
    function learningContext(extra=''){
      const p=state.learningProfile||{},ranked=rankedRecoverySubjects(),metrics=recoveryPlanMetrics(),errors=state.recovery.errors.filter(e=>e.status!=='Corrigido');return [`Objetivo: ${p.goal||'não informado'}`,`Matéria preferencial: ${p.subject||'não informada'}`,`Estilo: ${p.style||'não informado'}`,`Interesses: ${(p.interests||[]).join(', ')||'não informados'}`,p.material?`Anotações do estudante: ${p.material}`:'',`Projeto Angels — clareza do diagnóstico: ${diagnosisPercent()}%; prioridade atual: ${ranked[0]?.name||'não definida'}; execução do plano: ${metrics.execution}%; dificuldade principal: ${state.recovery.profile.reason}.`,errors.length?`Erros acadêmicos abertos: ${errors.slice(0,6).map(e=>`${e.subject}/${e.topic} (${e.type}): ${e.concept}`).join(' | ')}`:'Sem erros acadêmicos abertos registrados.',extra].filter(Boolean).join('\n');
    }
    function buildFlowingPrompt(){return `Você é um orientador de aprendizagem para um estudante de medicina. Use o perfil abaixo para montar uma jornada de estudo personalizada, prática e sustentável.\n\nPERFIL DO ESTUDANTE\n${learningContext()}\n\nTAREFA\n1. Resuma em uma frase o objetivo de aprendizagem.\n2. Crie um roteiro de 7 dias, respeitando prioridades e lacunas.\n3. Em cada dia, distribua quatro etapas: entender, praticar, memorizar e revisar.\n4. Inclua uma meta observável, tempo sugerido e um método de recordação ativa.\n5. Adapte exemplos ao estilo e aos interesses do estudante sem perder precisão científica.\n6. Finalize com três perguntas para ajustar o próximo ciclo.\n\nSe alguma informação estiver ausente, assuma uma carga moderada e declare a suposição. Não faça diagnóstico nem prescrição médica; o conteúdo é exclusivamente educacional.`;}
    function prepareFlowingPrompt(){state.learningProfile=readLearningProfileForm();save();renderLearningProfile();openPromptModal('Jornada personalizada',buildFlowingPrompt());}
    function promptContextValues(){
      const p=state.learningProfile||{};
      return {materia:$('#promptSubject')?.value.trim()||p.subject||'matéria não informada',assunto:$('#promptTopic')?.value.trim()||p.goal||'assunto não informado',objetivo:$('#promptObjective')?.value.trim()||p.goal||'compreender, aplicar e revisar o conteúdo',material:$('#promptMaterial')?.value.trim()||p.material||'nenhum material adicional',perfil:learningContext()};
    }
    function adaptPrompt(body){const values=promptContextValues();return String(body||'').replace(/\{\{(materia|assunto|objetivo|material|perfil)\}\}/g,(_,key)=>values[key]);}
    function usePromptTemplate(id,personal=false){const item=personal?state.customPrompts.find(prompt=>prompt.id===id):PROMPT_TEMPLATES.find(prompt=>prompt.id===id);if(!item)return;openPromptModal(item.name||item.title,adaptPrompt(item.body));}
    function renderPromptLibrary(){
      const grid=$('#promptTemplateGrid');if(!grid)return;
      grid.innerHTML=PROMPT_TEMPLATES.map(item=>`<article class="prompt-template-card"><div class="prompt-number">${escapeHtml(item.code)}</div><span class="badge purple">${escapeHtml(item.category)}</span><h3>${escapeHtml(item.title)}</h3><p>${escapeHtml(item.description)}</p><div class="prompt-preview">${escapeHtml(item.body.slice(0,180))}${item.body.length>180?'…':''}</div><button class="btn" onclick="usePromptTemplate('${item.id}')">Adaptar e usar</button></article>`).join('');
      const list=$('#savedPromptList'),items=state.customPrompts||[];
      list.innerHTML=items.length?`<div class="section-head"><div><h3>Meus prompts salvos</h3><p>${items.length} modelo${items.length===1?'':'s'} neste navegador</p></div></div>`+items.map(item=>`<article class="saved-prompt-row"><div><span class="badge gray">${escapeHtml(item.category||'Outro')}</span><h3>${escapeHtml(item.name)}</h3><p>${escapeHtml(item.body.slice(0,190))}${item.body.length>190?'…':''}</p></div><div class="actions"><button class="btn small" onclick="usePromptTemplate('${item.id}',true)">Usar</button><button class="btn small ghost" onclick="editCustomPrompt('${item.id}')">Editar</button><button class="btn small soft" onclick="deleteCustomPrompt('${item.id}')">Excluir</button></div></article>`).join(''):'<div class="empty">Nenhum prompt pessoal salvo. Crie o primeiro modelo acima.</div>';
    }
    function saveCustomPrompt(event){
      event.preventDefault();const name=$('#customPromptName').value.trim(),body=$('#customPromptBody').value.trim(),category=$('#customPromptCategory').value;if(!name||!body)return toast('Informe o nome e as instruções do prompt.');
      const wasEditing=Boolean(editingPromptId);if(editingPromptId){const item=state.customPrompts.find(prompt=>prompt.id===editingPromptId);if(item)Object.assign(item,{name:name.slice(0,80),category,body:body.slice(0,12000),updatedAt:new Date().toISOString()});}
      else state.customPrompts.unshift({id:uid(),name:name.slice(0,80),category,body:body.slice(0,12000),createdAt:new Date().toISOString()});
      save();resetCustomPromptEditor();renderPromptLibrary();toast(wasEditing?'Prompt atualizado.':'Prompt salvo na biblioteca.');
    }
    function editCustomPrompt(id){const item=state.customPrompts.find(prompt=>prompt.id===id);if(!item)return;editingPromptId=id;$('#customPromptName').value=item.name;$('#customPromptCategory').value=item.category||'Outro';$('#customPromptBody').value=item.body;$('#saveCustomPrompt').textContent='Atualizar prompt';$('#cancelCustomPrompt').style.display='inline-flex';$('#customPromptEditor').scrollIntoView({behavior:'smooth',block:'start'});}
    function resetCustomPromptEditor(){editingPromptId=null;$('#customPromptForm').reset();$('#saveCustomPrompt').textContent='Salvar na biblioteca';$('#cancelCustomPrompt').style.display='none';}
    function deleteCustomPrompt(id){const item=state.customPrompts.find(prompt=>prompt.id===id);if(!item||!confirm(`Excluir o prompt "${item.name}"?`))return;state.customPrompts=state.customPrompts.filter(prompt=>prompt.id!==id);if(editingPromptId===id)resetCustomPromptEditor();save();renderPromptLibrary();toast('Prompt excluído.');}

    function generateAIFlashcards(){
      const subject=$('#flashSubject').value.trim();const topic=$('#flashTopic').value.trim();if(!subject||!topic)return toast('Informe matéria e assunto.');
      const difficulty=$('#flashDifficulty').value,quantity=clamp(Number($('#flashQuantity').value)||5,1,20);
      state.aiConnector.pendingFlashcards={subject,topic,difficulty,quantity};save();openPromptModal('Flashcards inteligentes',buildFlashcardsPrompt(subject,topic,difficulty,quantity));$('#flashcardStage').innerHTML=`<div class="empty">Prompt preparado para ${escapeHtml(selectedProvider().label)}. Depois, cole a resposta JSON no campo de importação.</div>`;
    }
    function buildFlashcardsPrompt(subject,topic,difficulty,quantity){return `Você é um especialista em aprendizagem ativa para medicina. Crie ${quantity} flashcards sobre ${subject} — ${topic}, em dificuldade ${difficulty}.\n\nCONTEXTO DO ESTUDANTE\n${learningContext($('#flashContext').value.trim())}\n\nREGRAS\n- Cada pergunta deve testar apenas um conceito importante.\n- Respostas devem ser curtas, precisas e autocontidas.\n- A dica deve ajudar a recordar sem revelar diretamente a resposta.\n- Não invente dados e não inclua orientação clínica individual.\n- Responda SOMENTE com JSON válido, sem markdown, comentários ou texto antes/depois.\n\nFORMATO EXATO\n{"cards":[{"question":"Pergunta 1","answer":"Resposta 1","tip":"Dica 1"}]}`;}
    function parseExternalFlashcards(raw){
      let text=String(raw||'').trim();if(!text||text.length>200000)throw new Error('A resposta está vazia ou é grande demais.');text=text.replace(/^```(?:json)?\s*/i,'').replace(/\s*```$/,'').trim();
      try{return JSON.parse(text);}catch(firstError){const objectStart=text.indexOf('{'),arrayStart=text.indexOf('['),start=objectStart<0?arrayStart:arrayStart<0?objectStart:Math.min(objectStart,arrayStart),end=Math.max(text.lastIndexOf('}'),text.lastIndexOf(']'));if(start<0||end<=start)throw new Error('Não encontrei um JSON válido na resposta.');try{return JSON.parse(text.slice(start,end+1));}catch(e){throw new Error('O JSON retornado pela IA não está válido. Peça para ela corrigir o formato.');}}
    }
    function importExternalFlashcards(){
      const raw=$('#flashImportResponse').value;let parsed;try{parsed=parseExternalFlashcards(raw);}catch(err){return toast(err.message);}
      const cards=Array.isArray(parsed)?parsed:parsed?.cards;if(!Array.isArray(cards))return toast('O JSON precisa conter uma lista chamada "cards".');
      const meta=state.aiConnector?.pendingFlashcards||{subject:$('#flashSubject').value.trim(),topic:$('#flashTopic').value.trim(),difficulty:$('#flashDifficulty').value};
      const valid=cards.slice(0,50).filter(c=>c&&String(c.question||'').trim()&&String(c.answer||'').trim());if(!valid.length)return toast('Nenhum cartão válido foi encontrado.');
      const created=valid.map(c=>({id:uid(),subject:meta.subject||'Geral',topic:meta.topic||'Estudo',question:String(c.question).trim().slice(0,600),answer:String(c.answer).trim().slice(0,1200),tip:String(c.tip||'').trim().slice(0,500),difficulty:meta.difficulty||'Médio',createdAt:todayISO(),nextReview:todayISO(),stage:0,reviewCount:0,correctCount:0}));
      state.flashcards=[...created,...state.flashcards];state.aiConnector.pendingFlashcards=null;activeFlashcardIndex=0;state.xp=(state.xp||0)+10;$('#flashImportResponse').value='';save();renderAll();toast(`${created.length} flashcards importados e adicionados ao calendário.`);
    }
    function addManualFlashcard(e){
      e.preventDefault();const subject=$('#manualFlashSubject').value.trim(),topic=$('#manualFlashTopic').value.trim(),question=$('#manualFlashQuestion').value.trim(),answer=$('#manualFlashAnswer').value.trim();if(!subject||!topic||!question||!answer)return toast('Preencha matéria, assunto, pergunta e resposta.');state.flashcards.unshift({id:uid(),source:'manual',subject,topic,question:question.slice(0,600),answer:answer.slice(0,1200),tip:$('#manualFlashTip').value.trim().slice(0,500),difficulty:$('#manualFlashDifficulty').value,createdAt:todayISO(),nextReview:todayISO(),stage:0,reviewCount:0,correctCount:0});activeFlashcardIndex=0;$('#manualFlashQuestion').value='';$('#manualFlashAnswer').value='';$('#manualFlashTip').value='';save();renderAll();toast('Flashcard próprio adicionado à revisão de hoje.');
    }
    function reviewDeck(){const due=dueFlashcards();return due.length?due:state.flashcards;}
    function renderFlashcards(){
      const area=$('#flashcardStage');if(!area)return;const deck=reviewDeck(),editButton=$('#editActiveFlashcard'),deleteButton=$('#deleteActiveFlashcard'),nextButton=$('#nextFlashcard');if(!deck.length){area.innerHTML='<div class="empty">Prepare um prompt ou registre sua própria pergunta abaixo.</div>';$('#flashcardCounter').textContent='Nenhum cartão gerado ainda.';editButton.disabled=true;deleteButton.disabled=true;nextButton.disabled=true;return;}
      editButton.disabled=false;deleteButton.disabled=false;nextButton.disabled=deck.length<2;
      activeFlashcardIndex=((activeFlashcardIndex%deck.length)+deck.length)%deck.length;const card=deck[activeFlashcardIndex];$('#flashcardCounter').textContent=`Cartão ${activeFlashcardIndex+1} de ${deck.length} · ${state.flashcards.length} no total`;
      area.innerHTML=`<div><div class="flashcard" id="activeFlashcard" onclick="revealFlashcard()"><div class="flashcard-question"><span class="card-label">${escapeHtml(card.subject)} · ${escapeHtml(card.topic)}${card.source==='manual'?' · cartão próprio':''}</span><h3>${escapeHtml(card.question)}</h3><small class="muted">Clique para revelar a resposta</small></div><div class="flashcard-answer"><span class="card-label">Resposta</span><h3>${escapeHtml(card.answer)}</h3><p><strong>Dica:</strong> ${escapeHtml(card.tip||'Faça uma associação com o conceito central.')}</p></div></div><div class="rating-row" id="flashRatings" style="display:none"><button class="rate-again" onclick="rateFlashcard('${card.id}','again')">Errei</button><button class="rate-hard" onclick="rateFlashcard('${card.id}','hard')">Difícil</button><button class="rate-good" onclick="rateFlashcard('${card.id}','good')">Bom</button><button class="rate-easy" onclick="rateFlashcard('${card.id}','easy')">Fácil</button></div></div>`;
    }
    function activeFlashcard(){const deck=reviewDeck();return deck.length?deck[((activeFlashcardIndex%deck.length)+deck.length)%deck.length]:null;}
    function editActiveFlashcard(){const card=activeFlashcard();if(!card)return;const question=prompt('Pergunta do flashcard:',card.question);if(question===null)return;const answer=prompt('Resposta do flashcard:',card.answer);if(answer===null)return;const tip=prompt('Dica opcional:',card.tip||'');if(tip===null)return;if(!question.trim()||!answer.trim())return toast('Pergunta e resposta não podem ficar vazias.');card.question=question.trim().slice(0,600);card.answer=answer.trim().slice(0,1200);card.tip=tip.trim().slice(0,500);save();renderAll();toast('Flashcard atualizado.');}
    function deleteActiveFlashcard(){const card=activeFlashcard();if(!card||!confirm('Excluir este flashcard e seu histórico de revisão?'))return;state.flashcards=state.flashcards.filter(item=>item.id!==card.id);activeFlashcardIndex=0;save();renderAll();toast('Flashcard excluído.');}
    function revealFlashcard(){const card=$('#activeFlashcard');if(card){card.classList.add('revealed');$('#flashRatings').style.display='flex';}}
    function rateFlashcard(id,rating){
      const card=state.flashcards.find(c=>c.id===id);if(!card)return;card.reviewCount=(card.reviewCount||0)+1;card.lastReviewed=todayISO();if(rating==='again'){card.stage=0;}else if(rating==='hard'){card.stage=Math.max(0,card.stage||0);card.correctCount=(card.correctCount||0)+1;}else if(rating==='good'){card.stage=Math.min(FLASH_INTERVALS.length-1,(card.stage||0)+1);card.correctCount=(card.correctCount||0)+1;}else{card.stage=Math.min(FLASH_INTERVALS.length-1,(card.stage||0)+2);card.correctCount=(card.correctCount||0)+1;}const days=rating==='again'?1:FLASH_INTERVALS[card.stage]||56;card.nextReview=addDays(todayISO(),days);state.xp=(state.xp||0)+(rating==='again'?2:8);save();nextFlashcard();renderDashboard();renderReviewCalendar();
    }
    function nextFlashcard(){const deck=reviewDeck();if(deck.length)activeFlashcardIndex=(activeFlashcardIndex+1)%deck.length;renderFlashcards();}

    function renderHabits(){
      const area=$('#habitGrid');if(!area)return;const dates=weekDates();const labels=['SEG','TER','QUA','QUI','SEX','SÁB','DOM'];
      area.innerHTML=`<div></div>${labels.map((l,i)=>`<div class="habit-head">${l}<br>${dates[i].slice(-2)}</div>`).join('')}`+state.habits.map(h=>`<div class="habit-name">${escapeHtml(h.name)}</div>${dates.map(date=>`<button class="habit-check ${h.checks?.[date]?'done':''}" onclick="toggleHabit('${h.id}','${date}')" aria-label="${escapeHtml(h.name)} em ${fmtDate(date)}">${h.checks?.[date]?'✓':''}</button>`).join('')}`).join('');
      const possible=Math.max(1,state.habits.length*7);const done=state.habits.reduce((sum,h)=>sum+dates.filter(d=>h.checks?.[d]).length,0);$('#habitWeekRate').textContent=Math.round(done/possible*100)+'%';$('#habitDoneCount').textContent=done;$('#habitBestStreak').textContent=calcStudyStreak();$('#habitWeekLabel').textContent=`${fmtDate(dates[0])} — ${fmtDate(dates[6])}`;
    }
    function toggleHabit(id,date){const h=state.habits.find(x=>x.id===id);if(!h)return;h.checks=h.checks||{};h.checks[date]=!h.checks[date];if(h.checks[date])state.xp=(state.xp||0)+5;save();renderAll();}
    function addHabit(){const name=prompt('Nome do novo hábito de estudo:');if(!name?.trim())return;state.habits.push({id:uid(),name:name.trim().slice(0,60),checks:{}});save();renderAll();toast('Hábito adicionado.');}

    function addQuestionSession(e){ e.preventDefault();
      const subject=$('#qSubject').value.trim(); const topic=$('#qTopic').value.trim(); const total=Number($('#qTotal').value||0); const correct=Number($('#qCorrect').value||0); const date=$('#qDate').value||todayISO();
      if(!subject||!topic||!total) return toast('Informe disciplina, assunto e total.'); if(correct>total) return toast('Acertos não podem passar do total.');
      state.questions.push({id:uid(),subject,topic,total,correct,date}); award(XP.question); save(); renderAll(); toast('Sessão registrada.');
    }
    function renderQuestions(){
      const filter=normalize($('#questionFilter')?.value||''); let rows=[...state.questions];
      if(filter) rows=rows.filter(q=>normalize(`${q.subject} ${q.topic} ${q.date}`).includes(filter));
      const perf=aggregateQuestions(); let perfArr=Object.values(perf).sort((a,b)=>a.rate-b.rate);
      if(reviewOnlyWeakness) perfArr=perfArr.filter(x=>x.rate<70);
      $('#questionBars').innerHTML = perfArr.length ? perfArr.slice(0,12).map(x=>`<div class="bar-item"><div class="bar-head"><span>${escapeHtml(x.topic)} <span class="muted">· ${escapeHtml(x.subject)}</span></span><span>${x.rate}%</span></div><div class="progress"><span style="width:${x.rate}%"></span></div><small class="muted">${x.correct}/${x.total} acertos</small></div>`).join('') : '<div class="empty">Registre sessões de questões.</div>';
      $('#questionTable').innerHTML = `<thead><tr><th>Data</th><th>Disciplina</th><th>Assunto</th><th>Resultado</th><th>%</th><th>Ações</th></tr></thead><tbody>${rows.sort((a,b)=>b.date.localeCompare(a.date)).map(q=>{ const rate=Math.round(q.correct/q.total*100); return `<tr><td>${fmtDate(q.date)}</td><td>${escapeHtml(q.subject)}</td><td>${escapeHtml(q.topic)}</td><td>${q.correct}/${q.total}</td><td><span class="badge ${rate>=80?'green':rate>=60?'yellow':'red'}">${rate}%</span></td><td><button class="btn small soft" onclick="deleteQuestion('${q.id}')">Excluir</button></td></tr>`;}).join('') || `<tr><td colspan="6"><div class="empty">Nenhuma sessão registrada.</div></td></tr>`}</tbody>`;
    }
    function aggregateQuestions(){
      const map={}; state.questions.forEach(q=>{ const k=normalize(q.subject+'|'+q.topic); if(!map[k]) map[k]={subject:q.subject,topic:q.topic,total:0,correct:0,rate:0}; map[k].total+=q.total; map[k].correct+=q.correct; map[k].rate=Math.round(map[k].correct/map[k].total*100); }); return map;
    }
    function getWeakTopics(){ return Object.values(aggregateQuestions()).filter(x=>x.rate<70).sort((a,b)=>a.rate-b.rate); }
    function deleteQuestion(id){ state.questions=state.questions.filter(q=>q.id!==id); save(); renderAll(); }

    function renderCampaign(){
      $('#campaignArea').innerHTML = state.subjects.length ? state.subjects.map(s=>{
        const topics=s.topics||[]; const pct=topics.length?Math.round(topics.filter(t=>t.done).length/topics.length*100):0;
        return `<div class="world"><div class="world-head"><div><h3>${escapeHtml(s.name)}</h3><div class="progress" style="width:min(420px,100%)"><span style="width:${pct}%"></span></div></div><span class="badge purple">${pct}%</span></div><div class="nodes">${topics.map(t=>`<div class="node ${t.done?'done':''} ${t.heat==='Muito cobrado'?'hot':''}"><span class="icon">${t.done?'✓':t.heat==='Muito cobrado'?'!':'•'}</span><b>${escapeHtml(t.name)}</b><small>${escapeHtml(t.heat||'Ocasional')} · ${escapeHtml(t.difficulty||'Médio')}</small><br><button class="btn small soft" onclick="toggleTopic('${s.id}','${t.id}')">${t.done?'Reabrir':'Concluir'}</button></div>`).join('')}<div class="node boss"><span class="icon">◈</span><b>Marco final: Prova</b><small>Simulado + revisão de erros</small></div></div></div>`;
      }).join('') : '<div class="empty">Preencha disciplinas e assuntos para criar o mapa.</div>';
    }

    function activatePreExam(e){ e.preventDefault();
      const subject=$('#examSubject').value.trim()||'Prova'; const date=$('#examDate').value; const hours=Number($('#examHours').value||4); const strategy=$('#examStrategy').value;
      const linkedSubject=state.subjects.find(s=>normalize(s.name)===normalize(subject));
      if(date&&linkedSubject){state.recovery.assessments[String(linkedSubject.id)]={...subjectAssessment(linkedSubject),exam:date};syncExamReview(linkedSubject,date);calendarCursor=new Date(parseISO(date).getFullYear(),parseISO(date).getMonth(),1);save();}
      const daysLeft=date?Math.max(1,diffDays(date)):7;
      let split = strategy.includes('3 dias') ? [10,70,20] : strategy.includes('14') ? [25,55,20] : [10,70,20];
      const totalHours = daysLeft*hours; const theory=Math.round(totalHours*split[0]/100); const q=Math.round(totalHours*split[1]/100); const rev=Math.max(1,totalHours-theory-q);
      const weak = getWeakTopics().filter(w=>!subject||normalize(w.subject).includes(normalize(subject))).slice(0,4);
      const hot = state.subjects.find(s=>normalize(s.name).includes(normalize(subject)))?.topics?.filter(t=>t.heat==='Muito cobrado'&&!t.done).slice(0,5)||[];
      $('#preExamPlan').innerHTML = `
        <div class="rec"><strong>${subject}: ${daysLeft} dia(s) até a prova</strong><small>Total estimado: ${totalHours}h · Teoria ${theory}h · Questões ${q}h · Revisão ${rev}h</small></div>
        <div class="grid three">
          <div class="card compact no-shadow"><h3>1) Questões</h3><p>Faça blocos cronometrados. Corrija erros imediatamente. Meta: ${Math.max(20,Math.round(q*10))} questões.</p></div>
          <div class="card compact no-shadow"><h3>2) Revisão</h3><p>Priorize revisões atrasadas e mapas-resumo. Nada de teoria longa sem questão.</p></div>
          <div class="card compact no-shadow"><h3>3) Teoria cirúrgica</h3><p>Use teoria só para lacunas dos erros e assuntos muito cobrados ainda não concluídos.</p></div>
        </div>
        <div class="rec"><strong>Pontos fracos detectados</strong><small>${weak.length?weak.map(w=>`${w.topic} (${w.rate}%)`).join(' · '):'Nenhum ponto fraco registrado no banco de questões.'}</small></div>
        <div class="rec"><strong>Assuntos quentes ainda abertos</strong><small>${hot.length?hot.map(t=>t.name).join(' · '):'Nenhum assunto quente aberto encontrado.'}</small></div>`;
      toast(linkedSubject&&date?'Modo pré-prova gerado e prova adicionada ao calendário.':'Modo pré-prova gerado.');
    }

    function addTask(e){ e.preventDefault();
      const title=$('#taskTitle').value.trim(); if(!title) return toast('Informe a tarefa.');
      state.tasks.push({id:uid(),title,subject:$('#taskSubject').value.trim(),date:$('#taskDate').value||todayISO(),kind:$('#taskKind').value,xp:Number($('#taskXP').value||20),done:false});
      $('#taskTitle').value=''; save(); renderAll(); toast('Tarefa adicionada.');
    }
    function renderTasks(){
      const f=$('#taskFilter')?.value||'all'; const t=todayISO(); let rows=[...state.tasks];
      rows=rows.filter(x=>f==='all'||(f==='today'&&x.date===t)||(f==='pending'&&!x.done)||(f==='done'&&x.done));
      $('#taskList').innerHTML = rows.sort((a,b)=>a.date.localeCompare(b.date)).map(task=>`<div class="task ${task.done?'done':''}"><input type="checkbox" ${task.done?'checked':''} onchange="toggleTask('${task.id}')"><div><div class="task-title">${escapeHtml(task.title)}</div><span class="muted">${fmtDate(task.date)} · ${escapeHtml(task.subject||'Geral')} · ${escapeHtml(task.kind)} · ${task.xp} XP · ${task.pomodoros||0} ciclos</span></div><div class="actions"><button class="btn small ghost" onclick="editTask('${task.id}')">Editar</button><button class="btn small soft" onclick="deleteTask('${task.id}')">Excluir</button></div></div>`).join('') || '<div class="empty">Nenhuma tarefa.</div>';
    }
    function toggleTask(id){ const t=state.tasks.find(x=>x.id===id); if(t){t.done=!t.done; if(t.done) state.xp=(state.xp||0)+(t.xp||20); save(); renderAll();} }
    function editTask(id){const task=state.tasks.find(t=>t.id===id);if(!task)return;const title=prompt('Título da tarefa:',task.title);if(title===null)return;const subject=prompt('Disciplina:',task.subject||'');if(subject===null)return;const date=prompt('Data no formato AAAA-MM-DD:',task.date||todayISO());if(date===null)return;if(!title.trim()||!/^\d{4}-\d{2}-\d{2}$/.test(date))return toast('Informe um título e uma data válida.');task.title=title.trim();task.subject=subject.trim();task.date=date;save();renderAll();toast('Tarefa atualizada.');}
    function deleteTask(id){ state.tasks=state.tasks.filter(t=>t.id!==id); save(); renderAll(); }

    function normalizePomodoroDay(){const p=state.pomodoro;if(p.sessionsDate!==todayISO()){p.sessionsDate=todayISO();p.completedToday=0;return true;}return false;}
    function pomodoroDurationSeconds(mode=state.pomodoro.mode){const p=state.pomodoro;return Math.max(1,Number(mode==='focus'?p.focusMinutes:mode==='short'?p.shortMinutes:p.longMinutes)||1)*60;}
    function pomodoroRemaining(){const p=state.pomodoro;if(!p.running)return Math.max(0,Number(p.remaining||0));return Math.max(0,Math.ceil((Number(p.endAt||Date.now())-Date.now())/1000));}
    function startPomodoroClock(){if(pomodoroTimerId)clearInterval(pomodoroTimerId);tickPomodoro();pomodoroTimerId=setInterval(tickPomodoro,1000);}
    function tickPomodoro(){const p=state.pomodoro;if(p.running&&pomodoroRemaining()<=0){finishPomodoro();return;}updatePomodoroDisplay();}
    function renderPomodoro(){
      const card=$('#pomodoroCard');if(!card)return;normalizePomodoroDay();const p=state.pomodoro;const pending=state.tasks.filter(t=>!t.done);if(p.selectedTaskId&&!pending.some(t=>t.id===p.selectedTaskId))p.selectedTaskId='';
      $('#pomodoroTask').innerHTML='<option value="">Foco livre</option>'+pending.map(t=>`<option value="${escapeHtml(t.id)}">${escapeHtml(t.title)}${t.subject?' · '+escapeHtml(t.subject):''}</option>`).join('');$('#pomodoroTask').value=p.selectedTaskId||'';
      [['pomodoroFocusMinutes','focusMinutes'],['pomodoroShortMinutes','shortMinutes'],['pomodoroLongMinutes','longMinutes']].forEach(([id,key])=>{if(document.activeElement!==$('#'+id))$('#'+id).value=p[key];});
      const permission=typeof Notification==='undefined'?'unsupported':Notification.permission;$('#pomodoroNotify').textContent=permission==='granted'?'✓ Avisos ativados':permission==='denied'?'Avisos bloqueados':'Ativar aviso ao terminar';
      updatePomodoroDisplay();
    }
    function updatePomodoroDisplay(){
      const card=$('#pomodoroCard');if(!card)return;const p=state.pomodoro;const remaining=pomodoroRemaining(),total=pomodoroDurationSeconds(),minutes=Math.floor(remaining/60),seconds=remaining%60,progress=clamp((total-remaining)/total,0,1)*360;
      $('#pomodoroTime').textContent=`${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}`;$('#pomodoroRing').style.setProperty('--timer-progress',progress+'deg');$('#pomodoroModeLabel').textContent=p.mode==='focus'?'Sessão de foco':p.mode==='short'?'Pausa curta':'Pausa longa';$('#togglePomodoro').textContent=p.running?'Pausar':p.mode==='focus'?'Iniciar foco':'Iniciar pausa';card.classList.toggle('break-mode',p.mode!=='focus');
      $$('[data-pomodoro-mode]').forEach(btn=>btn.classList.toggle('active',btn.dataset.pomodoroMode===p.mode));
      const selected=state.tasks.find(t=>t.id===p.selectedTaskId);$('#pomodoroTaskCaption').textContent=selected?`${selected.subject||'Geral'} · ${selected.pomodoros||0} sessão(ões) concluída(s)`:'Escolha uma tarefa ou comece livremente.';
      $('#pomodoroSessionDots').innerHTML=Array.from({length:4},(_,i)=>`<i class="${i<(p.completedToday%4||Math.min(p.completedToday,4))?'done':''}"></i>`).join('')+`<span style="font-size:.7rem;font-weight:900;margin-left:3px">${p.completedToday} hoje</span>`;
      const now=new Date(),hour=now.getHours(),greeting=hour<12?'Bom dia':hour<18?'Boa tarde':'Boa noite';$('#pomodoroGreeting').innerHTML=`${greeting}. ${selected?`Agora, <strong>${escapeHtml(selected.title)}.</strong>`:'Reserve este momento para o que <strong>realmente importa.</strong>'}`;$('#pomodoroLiveClock').innerHTML=`${now.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}<small>${now.toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long'})}</small>`;
      document.title=p.running?`${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')} · MEDCID`:'MEDCID — Sua plataforma inteligente de estudos';
    }
    function setPomodoroMode(mode){if(!['focus','short','long'].includes(mode))return;const p=state.pomodoro;p.mode=mode;p.running=false;p.endAt=null;p.remaining=pomodoroDurationSeconds(mode);save();renderPomodoro();}
    function togglePomodoro(){const p=state.pomodoro;if(p.running){p.remaining=pomodoroRemaining();p.running=false;p.endAt=null;}else{if(p.remaining<=0)p.remaining=pomodoroDurationSeconds();p.running=true;p.endAt=Date.now()+p.remaining*1000;}save();renderPomodoro();}
    function resetPomodoro(){const p=state.pomodoro;p.running=false;p.endAt=null;p.remaining=pomodoroDurationSeconds();save();renderPomodoro();toast('Cronômetro reiniciado.');}
    function skipPomodoro(){advancePomodoro(false);}
    function finishPomodoro(){advancePomodoro(true);}
    function advancePomodoro(completed){const p=state.pomodoro,finishedMode=p.mode;if(completed&&finishedMode==='focus'){normalizePomodoroDay();p.completedToday+=1;state.xp=(state.xp||0)+10;const task=state.tasks.find(t=>t.id===p.selectedTaskId);if(task)task.pomodoros=(task.pomodoros||0)+1;pomodoroSignal('Foco concluído','Hora de respirar e consolidar o que você estudou.');}else if(completed)pomodoroSignal('Pausa concluída','Seu próximo bloco de foco está pronto.');p.mode=finishedMode==='focus'?(p.completedToday>0&&p.completedToday%4===0?'long':'short'):'focus';p.running=false;p.endAt=null;p.remaining=pomodoroDurationSeconds(p.mode);save();renderTasks();renderSidebar();renderPomodoro();toast(completed?(finishedMode==='focus'?'Sessão concluída: +10 XP.':'Pausa concluída.'):'Etapa avançada.');}
    function updatePomodoroSetting(key,value){const limits=key==='focusMinutes'?[5,90]:key==='shortMinutes'?[1,30]:[5,60],next=clamp(Number(value||limits[0]),limits[0],limits[1]),p=state.pomodoro;p[key]=next;const activeKey=p.mode==='focus'?'focusMinutes':p.mode==='short'?'shortMinutes':'longMinutes';if(!p.running&&key===activeKey)p.remaining=next*60;save();renderPomodoro();}
    async function requestPomodoroNotifications(){if(typeof Notification==='undefined')return toast('Este navegador não oferece notificações.');try{const permission=await Notification.requestPermission();renderPomodoro();toast(permission==='granted'?'Avisos do Pomodoro ativados.':'Permissão de avisos não concedida.');}catch(e){toast('Não foi possível ativar os avisos.');}}
    function pomodoroSignal(title,body){try{const AudioContext=window.AudioContext||window.webkitAudioContext;if(AudioContext){const context=new AudioContext(),osc=context.createOscillator(),gain=context.createGain();osc.connect(gain);gain.connect(context.destination);osc.frequency.value=660;gain.gain.setValueAtTime(.001,context.currentTime);gain.gain.exponentialRampToValueAtTime(.14,context.currentTime+.02);gain.gain.exponentialRampToValueAtTime(.001,context.currentTime+.5);osc.start();osc.stop(context.currentTime+.52);}}catch(e){}if(typeof Notification!=='undefined'&&Notification.permission==='granted')try{new Notification(title,{body,icon:'./icons/icon-192.png'});}catch(e){}}

    function saveConfig(e){ e.preventDefault(); state.config={startDate:$('#startDate').value||todayISO(), weeklyGoal:Number($('#weeklyGoal').value||16), dailyQuestionsGoal:Number($('#dailyQuestionsGoal').value||30), cycleName:$('#cycleName').value.trim()||'6º período'}; save(); renderAll(); toast('Configurações salvas e nome do dashboard atualizado.'); }
    function exportData(){
      const blob=new Blob([JSON.stringify({...state,exportedAt:new Date().toISOString(),formatVersion:1},null,2)],{type:'application/json'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`medcid-planner-backup-${todayISO()}.json`; a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),0);
      localStorage.setItem(BACKUP_KEY,new Date().toISOString()); updateBackupNotice(); toast('Backup exportado com sucesso.');
    }
    function isValidBackup(data){ return data&&typeof data==='object'&&['subjects','schedule','reviews','tasks','questions'].every(key=>Array.isArray(data[key]))&&data.config&&typeof data.config==='object'; }
    function importData(e){ const file=e.target.files[0]; if(!file) return; if(file.size>5*1024*1024){toast('O backup excede o limite de 5 MB.');e.target.value='';return;} const reader=new FileReader(); reader.onload=()=>{ try{ const data=JSON.parse(reader.result); if(!isValidBackup(data)) throw new Error('estrutura inválida'); const defaults=loadState(),resetProgress=Number(data.dataVersion||0)<3; state={...defaults,...data,dataVersion:CURRENT_DATA_VERSION,xp:resetProgress?0:Number(data.xp||0),customPrompts:Array.isArray(data.customPrompts)?data.customPrompts:[],config:{...defaults.config,...data.config},aiConnector:{...defaults.aiConnector,...(data.aiConnector||{}),mode:'external'}}; delete state.teacherChat; save(); document.body.classList.toggle('dark',!!state.dark); hydrateAIConnector();renderAll(); updateBackupNotice(); toast(resetProgress?'Backup importado; XP reiniciado para a versão atual.':'Backup importado e validado.'); }catch(err){toast('Backup inválido ou incompatível.');} finally{e.target.value='';} }; reader.onerror=()=>toast('Não foi possível ler o arquivo.'); reader.readAsText(file); }
    function updateBackupNotice(){
      const raw=localStorage.getItem(BACKUP_KEY); const last=raw?new Date(raw):null; const age=last?Math.floor((Date.now()-last.getTime())/86400000):Infinity; const hasData=state.subjects.length||state.schedule.length||state.reviews.length||state.tasks.length||state.questions.length;
      const notice=$('#backupNotice'); notice.classList.toggle('show',Boolean((hasData||state.recovery.plan.length||state.recovery.errors.length||state.recovery.checkins.length)&&age>=7));
      $('#backupNoticeText').textContent=last?`O último backup foi há ${age} dia(s).`:'Você ainda não exportou um backup neste dispositivo.';
      $('#backupStatus').textContent=last?`Último backup: ${last.toLocaleString('pt-BR')}.`:'Nenhum backup registrado neste dispositivo.';
    }

    function escapeHtml(str){ return String(str??'').replace(/[&<>"]/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m])); }

    window.completeReview=completeReview; window.editReviewGroup=editReviewGroup; window.deleteReviewGroup=deleteReviewGroup; window.deleteSchedule=deleteSchedule; window.editSubject=editSubject; window.deleteSubject=deleteSubject; window.toggleTopic=toggleTopic; window.editTopic=editTopic; window.deleteTopic=deleteTopic; window.deleteQuestion=deleteQuestion; window.toggleTask=toggleTask; window.editTask=editTask; window.deleteTask=deleteTask; window.revealFlashcard=revealFlashcard; window.rateFlashcard=rateFlashcard; window.toggleHabit=toggleHabit; window.showTab=showTab; window.updateSubjectAssessment=updateSubjectAssessment; window.updatePriorityWeight=updatePriorityWeight; window.advancePlanTask=advancePlanTask; window.errorToReview=errorToReview; window.askProfessorAboutError=askProfessorAboutError; window.markErrorCorrected=markErrorCorrected; window.deleteRecoveryError=deleteRecoveryError; window.usePromptTemplate=usePromptTemplate; window.editCustomPrompt=editCustomPrompt; window.deleteCustomPrompt=deleteCustomPrompt;
    init();
  </script>
</body>
</html>
