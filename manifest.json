      hydrateRecoveryForms();
      bindEvents(); showTab(getRouteTab(), false); startPomodoroClock(); startScheduleClock(); updateBackupNotice();
    }

    function setupAccessibility(){
      $$('.field').forEach(field=>{ const label=field.querySelector('label'); const control=field.querySelector('input,select,textarea'); if(label&&control?.id) label.htmlFor=control.id; });
      $$('.panel').forEach(panel=>{ panel.setAttribute('role','tabpanel'); panel.setAttribute('aria-labelledby',`tab-${panel.id}`); });
      $$('.tab').forEach(tab=>tab.id=`tab-${tab.dataset.tab}`);
    }

