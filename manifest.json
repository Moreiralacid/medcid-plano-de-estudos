<script>
(function(){
'use strict';
var STORAGE='medcid_planner_corrigido_v3';
var DAYS=['DOM','SEG','TER','QUA','QUI','SEX','SAB'];
var HOURS=['04:00','05:00','06:00','07:00','08:00','09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00','17:00','18:00','19:00','20:00','21:00','22:00','23:00','00:00','01:00'];
var REVIEW=[['R1',1,20],['R2',3,20],['R3',7,25],['R4',14,30],['R5',30,35]];
var HEAT={'Muito cobrado':'red','Cobrado':'orange','Ocasional':'yellow','Raro':'green'};
var XP={topic:25,review:20,question:25,task:15};
function $(s){return document.querySelector(s)}
function $$(s){return Array.prototype.slice.call(document.querySelectorAll(s))}
function uid(){return Math.random().toString(36).slice(2,9)+Date.now().toString(36).slice(-4)}
function today(){var d=new Date();d.setMinutes(d.getMinutes()-d.getTimezoneOffset());return d.toISOString().slice(0,10)}
function parseISO(x){var p=String(x||today()).split('-');return new Date(Number(p[0]),Number(p[1])-1,Number(p[2]))}
function addDays(iso,n){var d=parseISO(iso);d.setDate(d.getDate()+n);d.setMinutes(d.getMinutes()-d.getTimezoneOffset());return d.toISOString().slice(0,10)}
function fmt(iso){if(!iso)return'';var p=String(iso).split('-');return p[2]+'/'+p[1]+'/'+p[0]}
function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[m]})}
function norm(s){return String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'')}
function diff(a,b){return Math.round((parseISO(a)-parseISO(b||today()))/86400000)}
function toast(msg){var t=$('#toast');t.textContent=msg;t.classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(function(){t.classList.remove('show')},2200)}
function save(){try{localStorage.setItem(STORAGE,JSON.stringify(state))}catch(e){}}
function load(){try{var raw=localStorage.getItem(STORAGE);if(raw)return JSON.parse(raw)}catch(e){}return baseState()}
function baseState(){return {theme:'light',xp:0,config:{cycleName:'5º Período',startDate:'2026-02-23',weeklyGoal:34,dailyQGoal:30},subjects:[],schedule:[],reviews:[],questions:[]}}
var state=load();

var defaultSubjects=[
 {name:'Clínica Médica',weight:8,goal:10,color:'Roxo',topics:[['Asma brônquica','Muito cobrado','Médio','Alta'],['DPOC','Muito cobrado','Médio','Alta'],['Tuberculose','Muito cobrado','Médio','Alta'],['Pneumonia adquirida na comunidade','Muito cobrado','Médio','Alta'],['Derrame pleural','Cobrado','Médio','Média'],['Bronquiectasias','Cobrado','Médio','Média'],['Insuficiência cardíaca','Muito cobrado','Médio','Alta'],['ECG','Muito cobrado','Difícil','Alta'],['HAS','Muito cobrado','Médio','Alta'],['Valvopatias','Cobrado','Difícil','Média']]},
 {name:'Clínica Cirúrgica',weight:8,goal:8,color:'Azul',topics:[['Pré e pós-operatório','Muito cobrado','Médio','Alta'],['Choque','Muito cobrado','Médio','Alta'],['Abdome agudo','Muito cobrado','Médio','Alta'],['Apendicite','Muito cobrado','Fácil','Alta'],['Hemorragia digestiva','Cobrado','Médio','Média'],['Vias biliares','Muito cobrado','Médio','Alta'],['Pancreatite','Cobrado','Médio','Média'],['Politrauma','Muito cobrado','Difícil','Alta'],['Hérnias','Cobrado','Fácil','Média']]},
 {name:'Anestesiologia',weight:8,goal:3,color:'Verde',topics:[['Avaliação pré-anestésica','Muito cobrado','Médio','Alta'],['Monitorização perioperatória','Cobrado','Médio','Média'],['Vias aéreas','Muito cobrado','Difícil','Alta'],['RCP/PCR','Muito cobrado','Médio','Alta'],['Choque e reposição volêmica','Muito cobrado','Médio','Alta'],['Anestésicos locais','Muito cobrado','Médio','Alta'],['Bloqueios periféricos','Cobrado','Médio','Média'],['Bloqueios do neuroeixo','Muito cobrado','Difícil','Alta'],['Anestesia venosa e sedação','Cobrado','Médio','Média'],['Bloqueadores neuromusculares','Cobrado','Médio','Média'],['Ventilação mecânica','Muito cobrado','Difícil','Alta'],['Dor aguda e crônica','Cobrado','Médio','Média']]},
 {name:'Patologia Especial II',weight:8,goal:4,color:'Vermelho',topics:[['Patologia do SNC','Cobrado','Difícil','Média'],['Hipertensão intracraniana','Cobrado','Médio','Média'],['AVC isquêmico e hemorrágico','Muito cobrado','Médio','Alta'],['Tumores do SNC','Cobrado','Difícil','Média'],['Patologia de tireoide','Muito cobrado','Médio','Alta'],['Patologia linfoide','Muito cobrado','Médio','Alta'],['Linfomas','Muito cobrado','Difícil','Alta'],['Patologia renal','Cobrado','Médio','Média'],['Mama e próstata','Cobrado','Médio','Média']]},
 {name:'Psiquiatria',weight:8,goal:4,color:'Laranja',topics:[['Exame psíquico','Muito cobrado','Médio','Alta'],['Emergências psiquiátricas','Muito cobrado','Médio','Alta'],['Delirium','Cobrado','Médio','Média'],['Transtornos por substâncias','Muito cobrado','Médio','Alta'],['Transtornos do humor','Muito cobrado','Médio','Alta'],['Psicofármacos','Muito cobrado','Difícil','Alta'],['Esquizofrenia','Cobrado','Médio','Média']]},
 {name:'Epidemiologia Clínica',weight:8,goal:3,color:'Azul',topics:[['Medicina baseada em evidências','Muito cobrado','Médio','Alta'],['Causalidade','Cobrado','Médio','Média'],['Frequência','Cobrado','Fácil','Média'],['Caso-controle','Muito cobrado','Médio','Alta'],['Coorte','Muito cobrado','Médio','Alta'],['Diagnóstico','Muito cobrado','Médio','Alta'],['Revisão sistemática e metanálise','Cobrado','Difícil','Média']]},
 {name:'Bioquímica Clínica',weight:8,goal:5,color:'Roxo',topics:[['Interpretação laboratorial','Muito cobrado','Médio','Alta'],['Função renal','Cobrado','Médio','Média'],['Função hepática','Cobrado','Médio','Média'],['Distúrbios metabólicos','Cobrado','Médio','Média']]}
];
var pdfSchedule=[
 ['DOM','06:00','Academia','Treino',''],['DOM','08:00','Clínica Médica','Teoria',''],['DOM','10:00','Patologia Especial II','Teoria',''],['DOM','13:00','Clínica Cirúrgica','Teoria',''],['DOM','18:00','Culto','Igreja',''],['DOM','22:00','Psiquiatria','Revisão',''],
 ['SEG','04:00','Dormir','Rotina',''],['SEG','05:00','Café + MDO','Rotina',''],['SEG','08:00','Clínica Médica - prática','Prática',''],['SEG','13:00','Patologia Especial II','Teoria',''],['SEG','14:00','Clínica Cirúrgica','Teoria',''],['SEG','16:00','Anestesiologia','Teoria',''],['SEG','21:00','Clínica Médica','Revisão',''],
 ['TER','06:00','Academia','Treino',''],['TER','08:00','Clínica Cirúrgica - prática','Prática',''],['TER','13:00','Epidemiologia Clínica','Teoria',''],['TER','16:00','Psiquiatria','Teoria',''],['TER','18:00','Jiu-jitsu','Treino',''],['TER','20:00','Clínica Médica','Questões',''],
 ['QUA','07:00','Clínica Médica','Teoria',''],['QUA','13:00','Psiquiatria','Teoria',''],['QUA','14:00','Clínica Cirúrgica','Teoria',''],['QUA','19:00','Jiu-jitsu','Treino',''],['QUA','21:00','Anestesiologia','Revisão',''],
 ['QUI','05:00','Academia','Treino',''],['QUI','07:00','Clínica Médica','Teoria',''],['QUI','10:00','Monitoria','Prática',''],['QUI','13:00','Clínica Cirúrgica','Teoria',''],['QUI','14:00','Anestesiologia','Teoria',''],['QUI','20:00','Bioquímica Clínica','Teoria',''],
 ['SEX','06:00','Academia','Treino',''],['SEX','08:00','Clínica Médica - prática','Prática',''],['SEX','13:00','Psiquiatria','Teoria',''],['SEX','15:00','Clínica Médica','Questões',''],['SEX','17:00','Clínica Cirúrgica','Questões',''],['SEX','21:00','Patologia Especial II','Revisão',''],
 ['SAB','07:00','Clínica Cirúrgica','Teoria',''],['SAB','10:00','Bioquímica Clínica','Teoria',''],['SAB','15:00','Acro','Treino',''],['SAB','17:00','G.A','Igreja',''],['SAB','19:00','Culto','Igreja',''],['SAB','23:00','Epidemiologia Clínica','Revisão','']
];

function seedSubjects(){
 var existing={};state.subjects.forEach(function(s){existing[norm(s.name)]=true});
 defaultSubjects.forEach(function(s){if(!existing[norm(s.name)]){var ns={id:uid(),name:s.name,weight:s.weight,goal:s.goal,color:s.color,topics:[]};s.topics.forEach(function(t){ns.topics.push({id:uid(),name:t[0],heat:t[1],difficulty:t[2],priority:t[3],done:false,studiedDate:''})});state.subjects.push(ns)}});
 save();renderAll();toast('Disciplinas do PDF adicionadas.');
}
function seedSchedule(){
 var existing={};state.schedule.forEach(function(b){existing[b.day+'|'+b.hour+'|'+norm(b.activity)]=true});
 pdfSchedule.forEach(function(x){var key=x[0]+'|'+x[1]+'|'+norm(x[2]);if(!existing[key])state.schedule.push({id:uid(),day:x[0],hour:x[1],activity:x[2],type:x[3],place:x[4]||''})});
 save();renderAll();toast('Grade-base adicionada.');
}
function seedAll(){seedSubjects();seedSchedule();}

function showTab(id){$$('.tab').forEach(function(b){b.classList.toggle('active',b.dataset.tab===id)});$$('.view').forEach(function(v){v.classList.toggle('active',v.id===id)});renderAll()}
function bind(){
 $('#tabs').addEventListener('click',function(e){var b=e.target.closest('.tab');if(b)showTab(b.dataset.tab)});
 $('#themeBtn').addEventListener('click',toggleTheme);$('#exportBtn').addEventListener('click',exportData);$('#exportBtn2').addEventListener('click',exportData);$('#importFile').addEventListener('change',importData);
 $('#seedAllBtn').addEventListener('click',seedAll);$('#seedScheduleBtn').addEventListener('click',seedSchedule);$('#seedSubjectsBtn').addEventListener('click',seedSubjects);$('#clearScheduleBtn').addEventListener('click',function(){if(confirm('Limpar todos os blocos de horário?')){state.schedule=[];save();renderAll()}});
 $('#scheduleForm').addEventListener('submit',addSchedule);$('#subjectForm').addEventListener('submit',addSubject);$('#topicForm').addEventListener('submit',addTopic);$('#reviewForm').addEventListener('submit',addReviewManual);$('#questionForm').addEventListener('submit',addQuestions);$('#configForm').addEventListener('submit',saveConfig);$('#revFilter').addEventListener('change',renderReviews);
 $('#resetBtn').addEventListener('click',function(){if(confirm('Apagar todos os dados deste navegador?')){state=baseState();save();renderAll();toast('Dados resetados.')}});
 window.addEventListener('resize',deviceInfo);window.addEventListener('orientationchange',function(){setTimeout(deviceInfo,250)});
 var installBtn=$('#installBtn');var deferred=null;window.addEventListener('beforeinstallprompt',function(e){e.preventDefault();deferred=e;installBtn.style.display='inline-flex'});installBtn.addEventListener('click',function(){if(deferred){deferred.prompt();deferred=null;installBtn.style.display='none'}else toast('Hospede o site e abra no Chrome/Safari para instalar.')});
 if('serviceWorker' in navigator && location.protocol.indexOf('http')===0){navigator.serviceWorker.register('./service-worker.js').catch(function(){})}
}
function init(){
 HOURS.forEach(function(h){var o=document.createElement('option');o.textContent=h;$('#schHour').appendChild(o)});
 ['revDate','qDate','startDate'].forEach(function(id){var el=$('#'+id);if(el)el.value=today()});
 applyTheme();bind();renderAll();deviceInfo();openMode();
 if(state.subjects.length===0 && state.schedule.length===0){seedSubjects();seedSchedule()}
}
function openMode(){var p=location.protocol;var text=p==='file:'?'Modo local: funcionando como arquivo. Para instalar como app, hospede a pasta.':'Modo hospedado: pode instalar como app e usar cache offline.';$('#openMode').textContent=text}
function toggleTheme(){state.theme=state.theme==='dark'?'light':'dark';save();applyTheme()}
function applyTheme(){document.documentElement.setAttribute('data-theme',state.theme==='dark'?'dark':'light');$('#themeBtn').textContent=state.theme==='dark'?'☀️ Modo claro':'🌙 Modo escuro'}
function deviceInfo(){var w=innerWidth,h=innerHeight;var device=w>=1180?'computador':w>=721?'tablet':'celular';var ori=w>h?'paisagem':'retrato';$('#deviceInfo').textContent='Você está usando '+device+' em '+ori+'. Largura: '+w+'px. A interface foi ajustada para rotação livre.'}

function progress(){var topics=0,td=0,revs=0,rd=0;state.subjects.forEach(function(s){(s.topics||[]).forEach(function(t){topics++;if(t.done)td++})});state.reviews.forEach(function(g){(g.items||[]).forEach(function(i){revs++;if(i.done)rd++})});var den=topics+revs;if(!den)return 0;return Math.round((td+rd)/den*100)}
function allReviewItems(){var arr=[];state.reviews.forEach(function(g){(g.items||[]).forEach(function(i){arr.push({group:g,item:i})})});return arr}
function dueToday(){var t=today();return allReviewItems().filter(function(x){return x.item.date===t&&!x.item.done})}
function late(){var t=today();return allReviewItems().filter(function(x){return x.item.date<t&&!x.item.done})}
function weeklyHours(){var count=state.schedule.filter(function(b){return ['Teoria','Questões','Revisão','Prática'].indexOf(b.type)>=0}).length;return count}
function award(n){state.xp=(state.xp||0)+Number(n||0);save()}
function renderAll(){renderSidebar();renderDash();renderSchedule();renderSubjects();renderTopicSelect();renderReviews();renderQuestions();renderCampaign();renderConfig();}
function renderSidebar(){var p=progress();var xp=state.xp||0;$('#sideProgress').textContent=p+'%';$('#sideDue').textContent=dueToday().length+late().length;$('#sideXP').textContent=xp;$('#sideLevel').textContent=Math.floor(xp/100)+1}
function renderDash(){
 var p=progress(),xp=state.xp||0,lvl=Math.floor(xp/100)+1,rem=xp%100;$('#stProgress').textContent=p+'%';$('#stToday').textContent=dueToday().length;$('#stLate').textContent=late().length;$('#stHours').textContent=weeklyHours()+'h';$('#xpLabel').textContent='Nível '+lvl;$('#xpText').textContent=rem+'/100 XP';$('#xpBar').style.width=rem+'%';
 var list=late().concat(dueToday()).slice(0,8);$('#todayList').innerHTML=list.length?list.map(function(x){var status=x.item.date<today()?'Atrasada':'Hoje';return '<div class="item"><div><b>'+esc(x.group.topic)+' · '+esc(x.item.label)+'</b><br><span class="muted">'+esc(x.group.subject)+' · '+fmt(x.item.date)+' · '+status+'</span></div><button class="btn small" onclick="MED.completeReview(\''+x.group.id+'\',\''+x.item.id+'\')">Check</button></div>'}).join(''):'<div class="empty">Nenhuma revisão para hoje. Estude um assunto e gere revisões.</div>';
 renderRecommendations();renderPareto();
}
function renderRecommendations(){var rec=[];if(late().length)rec.push('Prioridade 1: resolver '+late().length+' revisões atrasadas antes de teoria nova.');if(dueToday().length)rec.push('Prioridade 2: concluir '+dueToday().length+' revisões de hoje.');var hot=[];state.subjects.forEach(function(s){(s.topics||[]).forEach(function(t){if(t.heat==='Muito cobrado'&&!t.done)hot.push(s.name+' — '+t.name)})});if(hot.length)rec.push('Pareto: ataque assunto quente aberto: '+hot[0]+'.');var weak=weakTopics();if(weak.length)rec.push('Questões: revise seu pior ponto: '+weak[0].topic+' ('+weak[0].rate+'%).');if(!rec.length)rec.push('Dia limpo. Faça questões de provas antigas ou avance um tópico quente.');$('#recommendations').innerHTML=rec.map(function(r){return '<div class="item"><div><b>'+esc(r)+'</b></div></div>'}).join('')}
function renderPareto(){var count={'Muito cobrado':0,'Cobrado':0,'Ocasional':0,'Raro':0};state.subjects.forEach(function(s){(s.topics||[]).forEach(function(t){count[t.heat]=(count[t.heat]||0)+1})});var max=Math.max(1,count['Muito cobrado'],count['Cobrado'],count['Ocasional'],count['Raro']);$('#paretoBars').innerHTML=Object.keys(count).map(function(k){var w=Math.round(count[k]/max*100);return '<div class="bar"><div class="bar-head"><span><span class="badge '+(HEAT[k]||'blue')+'">'+k+'</span></span><span>'+count[k]+'</span></div><div class="progress"><span style="width:'+w+'%"></span></div></div>'}).join('')}
function renderSchedule(){
 var html='<div class="whead">Hora</div>'+DAYS.map(function(d){return '<div class="whead">'+d+'</div>'}).join('');HOURS.forEach(function(h){html+='<div class="hour">'+h+'</div>';DAYS.forEach(function(d){var blocks=state.schedule.filter(function(b){return b.day===d&&b.hour===h});html+='<div class="cell">'+blocks.map(function(b){return '<div class="pill"><b>'+esc(b.activity)+'</b><span>'+esc(b.type)+(b.place?' · '+esc(b.place):'')+'</span></div>'}).join('')+'</div>'})});$('#weekGrid').innerHTML=html;
 $('#scheduleTable').innerHTML='<thead><tr><th>Dia</th><th>Hora</th><th>Atividade</th><th>Tipo</th><th>Local</th><th>Ação</th></tr></thead><tbody>'+state.schedule.slice().sort(function(a,b){return DAYS.indexOf(a.day)-DAYS.indexOf(b.day)||HOURS.indexOf(a.hour)-HOURS.indexOf(b.hour)}).map(function(b){return '<tr><td>'+b.day+'</td><td>'+b.hour+'</td><td><b>'+esc(b.activity)+'</b></td><td>'+esc(b.type)+'</td><td>'+esc(b.place)+'</td><td><button class="btn small badbtn" onclick="MED.delSchedule(\''+b.id+'\')">Excluir</button></td></tr>'}).join('')+'</tbody>';
}
function addSchedule(e){e.preventDefault();var a=$('#schActivity').value.trim();if(!a)return toast('Informe a atividade.');state.schedule.push({id:uid(),day:$('#schDay').value,hour:$('#schHour').value,activity:a,type:$('#schType').value,place:$('#schPlace').value.trim()});$('#schActivity').value='';$('#schPlace').value='';save();renderAll();toast('Bloco adicionado.')}
function delSchedule(id){state.schedule=state.schedule.filter(function(b){return b.id!==id});save();renderAll()}
function addSubject(e){e.preventDefault();var n=$('#subName').value.trim();if(!n)return toast('Informe a disciplina.');state.subjects.push({id:uid(),name:n,weight:Number($('#subWeight').value||1),goal:Number($('#subGoal').value||0),color:$('#subColor').value,topics:[]});$('#subName').value='';save();renderAll();toast('Disciplina criada.')}
function renderTopicSelect(){var sel=$('#topicSubject');sel.innerHTML=state.subjects.map(function(s){return '<option value="'+s.id+'">'+esc(s.name)+'</option>'}).join('')}
function addTopic(e){e.preventDefault();var sid=$('#topicSubject').value,s=state.subjects.find(function(x){return x.id===sid});var n=$('#topicName').value.trim();if(!s||!n)return toast('Informe disciplina e assunto.');s.topics.push({id:uid(),name:n,heat:$('#topicHeat').value,difficulty:$('#topicDiff').value,priority:$('#topicPrio').value,done:false,studiedDate:''});$('#topicName').value='';save();renderAll();toast('Assunto adicionado.')}
function renderSubjects(){
 $('#subjectsArea').innerHTML=state.subjects.length?state.subjects.map(function(s){var topics=s.topics||[];var pct=topics.length?Math.round(topics.filter(function(t){return t.done}).length/topics.length*100):0;return '<div class="card"><div class="section-head"><div><h2>'+esc(s.name)+'</h2><p>Peso '+s.weight+' · Meta '+s.goal+'h/semana · '+pct+'% concluído</p></div><div class="row"><button class="btn small soft" onclick="MED.genAllReviews(\''+s.id+'\')">Gerar revisões abertas</button><button class="btn small badbtn" onclick="MED.delSubject(\''+s.id+'\')">Excluir</button></div></div><div class="progress"><span style="width:'+pct+'%"></span></div><div class="topiccards" style="margin-top:12px">'+topics.map(function(t){return '<div class="topic '+(t.done?'done':'')+'"><div class="row" style="justify-content:space-between"><span class="badge '+(HEAT[t.heat]||'blue')+'">'+esc(t.heat)+'</span><input class="check" type="checkbox" '+(t.done?'checked':'')+' onchange="MED.toggleTopic(\''+s.id+'\',\''+t.id+'\')"></div><h3>'+esc(t.name)+'</h3><p>'+esc(t.difficulty)+' · prioridade '+esc(t.priority)+'</p><div class="row"><button class="btn small soft" onclick="MED.genReviewFromTopic(\''+s.id+'\',\''+t.id+'\')">Revisões</button><button class="btn small badbtn" onclick="MED.delTopic(\''+s.id+'\',\''+t.id+'\')">Excluir</button></div></div>'}).join('')+'</div></div>'}).join(''):'<div class="card"><div class="empty">Nenhuma disciplina. Clique em “Adicionar disciplinas do PDF”.</div></div>';
}
function delSubject(id){if(confirm('Excluir disciplina e assuntos?')){state.subjects=state.subjects.filter(function(s){return s.id!==id});save();renderAll()}}
function delTopic(sid,tid){var s=state.subjects.find(function(x){return x.id===sid});if(s){s.topics=s.topics.filter(function(t){return t.id!==tid});save();renderAll()}}
function toggleTopic(sid,tid){var s=state.subjects.find(function(x){return x.id===sid});if(!s)return;var t=s.topics.find(function(x){return x.id===tid});if(!t)return;t.done=!t.done;if(t.done){t.studiedDate=today();award(XP.topic)}save();renderAll()}
function genReview(subject,topic,base,prio){var g={id:uid(),subject:subject,topic:topic,priority:prio||'Média',created:today(),items:REVIEW.map(function(r){return {id:uid(),label:r[0],date:addDays(base||today(),r[1]),xp:r[2],done:false}})};state.reviews.push(g);save();renderAll();toast('Revisões geradas.')}
function genReviewFromTopic(sid,tid){var s=state.subjects.find(function(x){return x.id===sid});if(!s)return;var t=s.topics.find(function(x){return x.id===tid});if(!t)return;genReview(s.name,t.name,today(),t.priority)}
function genAllReviews(sid){var s=state.subjects.find(function(x){return x.id===sid});if(!s)return;var count=0;(s.topics||[]).forEach(function(t){if(!t.done){var exists=state.reviews.some(function(g){return norm(g.subject)===norm(s.name)&&norm(g.topic)===norm(t.name)});if(!exists){state.reviews.push({id:uid(),subject:s.name,topic:t.name,priority:t.priority,created:today(),items:REVIEW.map(function(r){return {id:uid(),label:r[0],date:addDays(today(),r[1]),xp:r[2],done:false}})});count++}}});save();renderAll();toast(count+' grupos de revisão gerados.')}
function addReviewManual(e){e.preventDefault();var s=$('#revSubject').value.trim(),t=$('#revTopic').value.trim();if(!s||!t)return toast('Informe disciplina e assunto.');genReview(s,t,$('#revDate').value||today(),$('#revPrio').value);$('#revTopic').value=''}
function renderReviews(){var f=$('#revFilter').value;var arr=allReviewItems();var now=today();if(f==='pending')arr=arr.filter(function(x){return !x.item.done});if(f==='today')arr=arr.filter(function(x){return x.item.date===now&&!x.item.done});if(f==='late')arr=arr.filter(function(x){return x.item.date<now&&!x.item.done});arr.sort(function(a,b){return a.item.date.localeCompare(b.item.date)});$('#reviewTable').innerHTML='<thead><tr><th>Status</th><th>Data</th><th>Revisão</th><th>Disciplina</th><th>Assunto</th><th>Ação</th></tr></thead><tbody>'+(arr.length?arr.map(function(x){var status=x.item.done?'Concluída':x.item.date<now?'Atrasada':x.item.date===now?'Hoje':'Programada';var cls=x.item.done?'green':x.item.date<now?'red':x.item.date===now?'yellow':'blue';return '<tr><td><span class="badge '+cls+'">'+status+'</span></td><td>'+fmt(x.item.date)+'</td><td><b>'+x.item.label+'</b></td><td>'+esc(x.group.subject)+'</td><td>'+esc(x.group.topic)+'</td><td><button class="btn small" onclick="MED.completeReview(\''+x.group.id+'\',\''+x.item.id+'\')">'+(x.item.done?'Desmarcar':'Check')+'</button> <button class="btn small badbtn" onclick="MED.delReview(\''+x.group.id+'\')">Grupo</button></td></tr>'}).join(''):'<tr><td colspan="6"><div class="empty">Nenhuma revisão encontrada.</div></td></tr>')+'</tbody>'}
function completeReview(gid,iid){var g=state.reviews.find(function(x){return x.id===gid});if(!g)return;var it=g.items.find(function(x){return x.id===iid});if(!it)return;it.done=!it.done;if(it.done)award(it.xp||XP.review);save();renderAll()}
function delReview(gid){if(confirm('Excluir grupo de revisões?')){state.reviews=state.reviews.filter(function(g){return g.id!==gid});save();renderAll()}}
function addQuestions(e){e.preventDefault();var total=Number($('#qTotal').value||0),correct=Number($('#qCorrect').value||0);if(!$('#qSubject').value.trim()||!$('#qTopic').value.trim()||!total)return toast('Preencha disciplina, assunto e total.');if(correct>total)return toast('Acertos não podem passar do total.');state.questions.push({id:uid(),subject:$('#qSubject').value.trim(),topic:$('#qTopic').value.trim(),total:total,correct:correct,date:$('#qDate').value||today(),kind:$('#qKind').value});award(XP.question);save();renderAll();toast('Questões registradas.')}
function aggregate(){var map={};state.questions.forEach(function(q){var k=norm(q.subject+'|'+q.topic);if(!map[k])map[k]={subject:q.subject,topic:q.topic,total:0,correct:0,rate:0};map[k].total+=q.total;map[k].correct+=q.correct;map[k].rate=Math.round(map[k].correct/map[k].total*100)});return map}
function weakTopics(){return Object.values(aggregate()).filter(function(x){return x.rate<70}).sort(function(a,b){return a.rate-b.rate})}
function renderQuestions(){var weak=weakTopics();$('#weakArea').innerHTML=weak.length?weak.slice(0,8).map(function(w){return '<div class="bar"><div class="bar-head"><span>'+esc(w.topic)+' <span class="muted">· '+esc(w.subject)+'</span></span><span>'+w.rate+'%</span></div><div class="progress"><span style="width:'+w.rate+'%"></span></div><small class="muted">'+w.correct+'/'+w.total+' acertos</small></div>'}).join(''):'<div class="empty">Sem pontos fracos registrados. Faça questões para o painel calcular.</div>';$('#questionTable').innerHTML='<thead><tr><th>Data</th><th>Disciplina</th><th>Assunto</th><th>Resultado</th><th>%</th><th>Ação</th></tr></thead><tbody>'+(state.questions.length?state.questions.slice().sort(function(a,b){return b.date.localeCompare(a.date)}).map(function(q){var rate=Math.round(q.correct/q.total*100);return '<tr><td>'+fmt(q.date)+'</td><td>'+esc(q.subject)+'</td><td>'+esc(q.topic)+'</td><td>'+q.correct+'/'+q.total+'</td><td><span class="badge '+(rate>=80?'green':rate>=60?'yellow':'red')+'">'+rate+'%</span></td><td><button class="btn small badbtn" onclick="MED.delQuestion(\''+q.id+'\')">Excluir</button></td></tr>'}).join(''):'<tr><td colspan="6"><div class="empty">Nenhuma sessão registrada.</div></td></tr>')+'</tbody>'}
function delQuestion(id){state.questions=state.questions.filter(function(q){return q.id!==id});save();renderAll()}
function renderCampaign(){
 $('#campaignArea').innerHTML=state.subjects.length?state.subjects.map(function(s){var topics=s.topics||[],pct=topics.length?Math.round(topics.filter(function(t){return t.done}).length/topics.length*100):0;return '<div class="world"><div class="section-head"><div><h2>'+esc(s.name)+'</h2><p>'+pct+'% do mundo concluído</p></div><span class="badge purple">Chefe: prova</span></div><div class="progress"><span style="width:'+pct+'%"></span></div><div class="nodes">'+topics.map(function(t){return '<div class="node '+(t.done?'done ':'')+(t.heat==='Muito cobrado'?'hot':'')+'"><h3>'+(t.done?'✅ ':t.heat==='Muito cobrado'?'🔥 ':'📍 ')+esc(t.name)+'</h3><p>'+esc(t.heat)+' · '+esc(t.difficulty)+'</p><button class="btn small soft" onclick="MED.toggleTopic(\''+s.id+'\',\''+t.id+'\')">'+(t.done?'Reabrir':'Concluir')+'</button></div>'}).join('')+'<div class="node hot"><h3>👹 Chefe</h3><p>Simulado + revisão de erros</p></div></div></div>'}).join(''):'<div class="card"><div class="empty">Adicione disciplinas para criar o mapa.</div></div>'
}
function renderConfig(){var c=state.config||{};$('#cycleName').value=c.cycleName||'5º Período';$('#startDate').value=c.startDate||today();$('#weeklyGoal').value=c.weeklyGoal||34;$('#dailyQGoal').value=c.dailyQGoal||30}
function saveConfig(e){e.preventDefault();state.config={cycleName:$('#cycleName').value.trim()||'5º Período',startDate:$('#startDate').value||today(),weeklyGoal:Number($('#weeklyGoal').value||0),dailyQGoal:Number($('#dailyQGoal').value||0)};save();renderAll();toast('Configurações salvas.')}
function exportData(){var blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'});var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='medcid-planner-backup.json';document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(a.href)}
function importData(e){var file=e.target.files[0];if(!file)return;var r=new FileReader();r.onload=function(){try{state=JSON.parse(r.result);save();renderAll();toast('Backup importado.')}catch(err){toast('Arquivo inválido.')}};r.readAsText(file)}
window.MED={completeReview:completeReview,delSchedule:delSchedule,delSubject:delSubject,delTopic:delTopic,toggleTopic:toggleTopic,genReviewFromTopic:genReviewFromTopic,genAllReviews:genAllReviews,delReview:delReview,delQuestion:delQuestion};
document.addEventListener('DOMContentLoaded',init);
})();
</script>
</body>
</html>
