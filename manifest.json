    function createSixthPeriodExamples(start){
      const subjects=defaultSubjects.map((subject,index)=>({id:`example-subject-${index+1}`,...subject,topics:(defaultTopics[subject.name]||[]).map(([name,heat,difficulty,roi],topicIndex)=>({id:`example-topic-${index+1}-${topicIndex+1}`,name,heat,difficulty,roi,done:false,created:start}))}));
      const makeReview=(subject,topic,offset=0)=>({id:uid(),subject,topic,baseDate:addDays(start,offset),priority:'Alta',kind:'Teoria',items:REVIEW_STEPS.map(step=>({id:uid(),label:step.label,date:addDays(start,offset+step.days),done:false,xp:step.xp}))});
      const reviews=[makeReview('Clínica Médica II','Introdução às anemias'),makeReview('Ortopedia','Anatomia do tecido ósseo e da medula óssea',1)];
      const tasks=[
        {id:uid(),title:'Revisar classificação das anemias',subject:'Clínica Médica II',date:start,kind:'Revisão',xp:20,done:false},
        {id:uid(),title:'Resolver 20 questões de trauma torácico',subject:'Clínica Cirúrgica II',date:addDays(start,1),kind:'Questões',xp:20,done:false},
        {id:uid(),title:'Criar resumo de fraturas e consolidação',subject:'Ortopedia',date:addDays(start,2),kind:'Resumo',xp:20,done:false}
      ];
      return {subjects,reviews,tasks};
    }

