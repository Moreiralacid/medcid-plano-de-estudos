    function updateScheduleNow(){
      const grid=$('#weekGrid'),title=$('#scheduleNowTitle'),caption=$('#scheduleNowCaption'),jump=$('#jumpScheduleNow');if(!grid||!title||!caption||!jump)return;
      grid.querySelectorAll('.today-column,.now-cell').forEach(el=>el.classList.remove('today-column','now-cell'));grid.querySelectorAll('.current-time-line').forEach(el=>el.remove());
      const now=new Date(),day=DAYS[now.getDay()],time=now.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}),hour=`${String(now.getHours()).padStart(2,'0')}:00`,inGrid=HOURS.includes(hour);
      title.textContent=`Agora: ${time} · ${day}`;caption.textContent=inGrid?'A linha vermelha mostra sua posição no planejamento de hoje.':'O horário atual está fora da grade, que vai de 04:00 até 01:59.';jump.disabled=!inGrid;
