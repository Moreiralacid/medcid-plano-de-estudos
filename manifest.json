      const select=$('#topicSubject'); if(select) select.innerHTML = state.subjects.map(s=>`<option value="${escapeHtml(s.id)}">${escapeHtml(s.name)}</option>`).join('');
    }

    function calcOverallProgress(){
      const topics = state.subjects.flatMap(s=>s.topics||[]);
      const topicDone = topics.filter(t=>t.done).length;
      const reviews = state.reviews.flatMap(r=>r.items||[]);
      const reviewDone = reviews.filter(r=>r.done).length;
      const tasksDone = state.tasks.filter(t=>t.done).length;
      const cardsDone = state.flashcards.filter(c=>(c.reviewCount||0)>0).length;
      const recoveryDone=state.recovery.plan.filter(t=>t.status==='Concluída').length+state.recovery.plan.filter(t=>t.status==='Parcial').length*.5;
      const denom = topics.length + reviews.length + state.tasks.length + state.flashcards.length + state.recovery.plan.length;
      const num = topicDone + reviewDone + tasksDone + cardsDone + recoveryDone;
      return denom ? Math.round(num/denom*100) : 0;
    }
    function todaysReviews(){ const t=todayISO(); return state.reviews.flatMap(r=>(r.items||[]).map(it=>({...it,parent:r}))).filter(it=>it.date===t && !it.done); }
    function overdueReviews(){ const t=todayISO(); return state.reviews.flatMap(r=>(r.items||[]).map(it=>({...it,parent:r}))).filter(it=>it.date<t && !it.done); }
    function pendingReviews(){ return state.reviews.flatMap(r=>(r.items||[]).map(it=>({...it,parent:r}))).filter(it=>!it.done); }
    function dueFlashcards(){ const t=todayISO(); return state.flashcards.filter(c=>(c.nextReview||t)<=t); }

