<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>MedCid Planner — Plano de Estudos Inteligente</title>

  <meta name="theme-color" content="#6d28d9" />
  <meta name="application-name" content="MEDCID Planner" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="MEDCID" />
  <link rel="manifest" href="./manifest.json" />
  <link rel="icon" href="./icons/icon-192.png" />
  <link rel="apple-touch-icon" href="./icons/icon-180.png" />
  <style>
    :root{
      --bg:#f6f7fb; --surface:#ffffff; --surface-2:#eef2ff; --text:#141827; --muted:#667085; --line:#d9ddeb;
      --primary:#6d28d9; --primary-2:#8b5cf6; --accent:#06b6d4; --good:#16a34a; --warn:#f59e0b; --bad:#dc2626; --info:#2563eb;
      --shadow:0 18px 50px rgba(20,24,39,.10); --radius:22px; --radius-sm:14px;
      --red:#ef4444; --orange:#f97316; --yellow:#eab308; --green:#22c55e;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:radial-gradient(circle at top left,rgba(139,92,246,.16),transparent 34%),radial-gradient(circle at 80% 0,rgba(6,182,212,.12),transparent 30%),var(--bg);color:var(--text);min-height:100vh}
    body.dark{--bg:#070a13;--surface:#101626;--surface-2:#151e33;--text:#f8fafc;--muted:#aab5c8;--line:#27324a;--shadow:0 24px 70px rgba(0,0,0,.44);background:radial-gradient(circle at top left,rgba(109,40,217,.35),transparent 34%),radial-gradient(circle at 80% 0,rgba(6,182,212,.20),transparent 30%),var(--bg)}
    button,input,select,textarea{font:inherit;color:inherit}
    button{cursor:pointer;min-height:44px}
    :focus-visible{outline:3px solid var(--accent);outline-offset:3px}
    .app{max-width:1440px;margin:0 auto;padding:22px}
    .hero{position:relative;overflow:hidden;display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center;background:linear-gradient(135deg,rgba(109,40,217,.96),rgba(6,182,212,.88));color:#fff;border-radius:30px;padding:26px;box-shadow:var(--shadow)}
    .hero:before{content:"";position:absolute;inset:-80px -80px auto auto;width:260px;height:260px;border-radius:999px;background:rgba(255,255,255,.14);filter:blur(2px)}
    .hero h1{margin:4px 0 8px;font-size:clamp(2rem,5vw,4.4rem);line-height:.95;letter-spacing:-.05em}
    .hero p{max-width:860px;margin:0;color:rgba(255,255,255,.88)}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;margin:0!important;text-transform:uppercase;font-size:.78rem;font-weight:900;letter-spacing:.16em;color:#dbeafe!important}
    .hero-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;z-index:1}
    .btn{border:0;border-radius:999px;padding:11px 15px;background:linear-gradient(135deg,var(--primary),var(--primary-2));color:#fff;font-weight:800;box-shadow:0 10px 25px rgba(109,40,217,.22);display:inline-flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap;transition:.18s ease}
    .btn:hover{transform:translateY(-1px);filter:brightness(1.03)}
    .btn.secondary{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.25);box-shadow:none;color:#fff;backdrop-filter:blur(8px)}
    .btn.ghost{background:transparent;color:var(--text);border:1px solid var(--line);box-shadow:none}
    .btn.soft{background:var(--surface-2);color:var(--text);border:1px solid var(--line);box-shadow:none}
    .btn.danger{background:linear-gradient(135deg,#dc2626,#f97316)}
    .btn.small{padding:9px 11px;font-size:.85rem;min-height:44px}
    .btn.full{width:100%}
    .shell{display:grid;grid-template-columns:260px 1fr;gap:18px;margin-top:18px;align-items:start}
    .sidebar{position:sticky;top:14px;max-height:calc(100vh - 28px);overflow:auto;background:rgba(255,255,255,.72);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.55);border-radius:26px;padding:14px;box-shadow:var(--shadow)}
    body.dark .sidebar{background:rgba(16,22,38,.76);border-color:rgba(255,255,255,.07)}
    .tab{width:100%;border:0;background:transparent;color:var(--muted);display:flex;gap:10px;align-items:center;text-align:left;border-radius:16px;padding:13px 12px;font-weight:800;margin-bottom:4px}
    .tab.active{background:linear-gradient(135deg,rgba(109,40,217,.16),rgba(6,182,212,.12));color:var(--text)}
    .tab .ico{width:26px;height:26px;display:grid;place-items:center;border-radius:9px;background:var(--surface-2);border:1px solid var(--line);color:var(--primary);font-size:.84rem;font-weight:1000;line-height:1;font-family:Inter,system-ui,sans-serif}
    .quick-stats{display:grid;gap:8px;margin-top:14px}
    .pill-stat{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:12px}.pill-stat strong{display:block;font-size:1.4rem}.pill-stat span{font-size:.8rem;color:var(--muted);font-weight:700}
    main{min-width:0}.panel{display:none}.panel.active{display:block;animation:fade .2s ease}@keyframes fade{from{opacity:.2;transform:translateY(4px)}to{opacity:1;transform:none}}
    .grid{display:grid;gap:16px}.two{grid-template-columns:repeat(2,minmax(0,1fr))}.three{grid-template-columns:repeat(3,minmax(0,1fr))}.four{grid-template-columns:repeat(4,minmax(0,1fr))}.five{grid-template-columns:repeat(5,minmax(0,1fr))}
    .card{background:rgba(255,255,255,.86);border:1px solid rgba(255,255,255,.7);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);min-width:0}.card.compact{padding:14px}.card.no-shadow{box-shadow:none}.card.glow{background:linear-gradient(135deg,rgba(109,40,217,.12),rgba(6,182,212,.10)),var(--surface)}
    body.dark .card{background:rgba(16,22,38,.88);border-color:rgba(255,255,255,.08)}
    h2{margin:0 0 8px;font-size:1.35rem;letter-spacing:-.03em}h3{margin:0 0 8px;font-size:1.03rem}p{color:var(--muted);line-height:1.55}.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:14px}.section-head p{margin:0}.section-head h2{margin-bottom:3px}
    .dashboard{display:grid;grid-template-columns:1.25fr .75fr;gap:16px}.stat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:14px}.stat{border:1px solid var(--line);background:var(--surface);border-radius:18px;padding:14px}.stat strong{display:block;font-size:clamp(1.5rem,3vw,2.6rem);letter-spacing:-.05em}.stat span{font-size:.82rem;color:var(--muted);font-weight:800}.stat.good strong{color:var(--good)}.stat.warn strong{color:var(--warn)}.stat.bad strong{color:var(--bad)}.stat.info strong{color:var(--info)}
    .today-list{display:grid;gap:10px;margin-top:10px}.today-item{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;border:1px solid var(--line);border-radius:16px;background:var(--surface);padding:10px}.today-item .dot{width:11px;height:11px;border-radius:999px;background:var(--primary)}.today-item small{color:var(--muted);font-weight:700}.today-item.overdue .dot{background:var(--bad)}.today-item.done{opacity:.65;text-decoration:line-through}
    .form{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:12px;margin-bottom:14px}input,select,textarea{width:100%;border:1px solid var(--line);background:var(--bg);border-radius:14px;padding:12px;outline:none}textarea{min-height:88px;resize:vertical}input:focus,select:focus,textarea:focus{border-color:var(--primary);box-shadow:0 0 0 4px rgba(109,40,217,.12)}label{font-size:.82rem;color:var(--muted);font-weight:900;display:block;margin-bottom:6px}.field{display:grid;gap:4px}.filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px}.filters input,.filters select{max-width:280px}
    .table-wrap{overflow:auto;border-radius:18px;border:1px solid var(--line);background:var(--surface)}table{width:100%;border-collapse:collapse;min-width:760px}th,td{border-bottom:1px solid var(--line);padding:10px;text-align:left;vertical-align:middle;font-size:.92rem}th{background:var(--surface-2);font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);position:sticky;top:0;z-index:1}tr:hover td{background:rgba(109,40,217,.05)}.actions{display:flex;gap:6px;flex-wrap:wrap}.badge{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:5px 9px;font-size:.76rem;font-weight:900;border:1px solid var(--line);background:var(--surface-2)}.badge.red{background:rgba(239,68,68,.12);color:#ef4444}.badge.orange{background:rgba(249,115,22,.12);color:#f97316}.badge.yellow{background:rgba(234,179,8,.16);color:#ca8a04}.badge.green{background:rgba(34,197,94,.13);color:#16a34a}.badge.blue{background:rgba(37,99,235,.13);color:#2563eb}.badge.purple{background:rgba(109,40,217,.13);color:#7c3aed}.badge.gray{color:var(--muted)}
    .subject-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.subject-card{position:relative;overflow:hidden}.subject-card:before{content:"";position:absolute;left:0;top:0;bottom:0;width:7px;background:var(--subject-color,var(--primary))}.subject-title{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.topic-list{display:grid;gap:8px;margin-top:12px}.topic-row{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;background:var(--surface-2);border:1px solid var(--line);border-radius:14px;padding:8px}.topic-row input[type="checkbox"]{width:auto}.topic-row b{font-size:.9rem}.progress{height:10px;background:var(--surface-2);border-radius:999px;overflow:hidden;border:1px solid var(--line)}.progress>span{display:block;height:100%;background:linear-gradient(90deg,var(--primary),var(--accent));width:0%;transition:.25s}.meter-line{display:flex;justify-content:space-between;color:var(--muted);font-weight:800;font-size:.82rem;margin:10px 0 6px}.bar-list{display:grid;gap:12px}.bar-item{display:grid;gap:6px}.bar-head{display:flex;justify-content:space-between;gap:10px;font-weight:900;font-size:.9rem}.bar-head span:last-child{color:var(--muted)}
    .schedule-now{display:flex;align-items:center;gap:11px;margin:0 0 12px;padding:11px 13px;border:1px solid rgba(109,40,217,.22);border-radius:16px;background:linear-gradient(135deg,rgba(109,40,217,.09),rgba(6,182,212,.08)),var(--surface)}.schedule-now-dot{width:10px;height:10px;flex:0 0 10px;border-radius:50%;background:#ef4444;box-shadow:0 0 0 5px rgba(239,68,68,.12)}.schedule-now strong{display:block;font-size:.9rem}.schedule-now small{display:block;margin-top:2px;color:var(--muted);font-weight:700}.schedule-now .btn{margin-left:auto}.week-grid{display:grid;grid-template-columns:80px repeat(7,minmax(120px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:20px;overflow:auto}.week-cell{background:var(--surface);min-height:58px;padding:7px}.week-cell.header{background:var(--surface-2);font-weight:900;text-align:center;min-height:auto;position:sticky;top:0;z-index:2}.week-cell.header.today-column{color:var(--primary);box-shadow:inset 0 -3px 0 var(--primary)}.week-cell.today-column:not(.header){background:linear-gradient(rgba(109,40,217,.035),rgba(109,40,217,.035)),var(--surface)}.week-cell.hour{background:var(--surface-2);font-weight:900;color:var(--muted);position:sticky;left:0;z-index:1}.week-cell.now-cell{position:relative;isolation:isolate}.current-time-line{position:absolute;left:-1px;right:-1px;top:var(--now-progress);height:2px;background:#ef4444;z-index:8;pointer-events:none;box-shadow:0 0 8px rgba(239,68,68,.35)}.current-time-line::before{content:"";position:absolute;left:-4px;top:50%;width:9px;height:9px;border-radius:50%;background:#ef4444;transform:translateY(-50%)}.current-time-line span{position:absolute;right:4px;top:50%;transform:translateY(-50%);border-radius:999px;padding:2px 6px;background:#ef4444;color:#fff;font-size:.62rem;font-weight:1000;line-height:1.2;box-shadow:0 3px 9px rgba(239,68,68,.25)}.block{position:relative;z-index:1;font-size:.78rem;padding:6px;border-radius:11px;background:linear-gradient(135deg,rgba(109,40,217,.16),rgba(6,182,212,.12));border:1px solid rgba(109,40,217,.2);margin-bottom:5px;word-break:break-word}.block b{display:block}.block small{color:var(--muted);font-weight:800}.dragging{opacity:.5}.drop-target{outline:3px solid rgba(109,40,217,.28);outline-offset:-4px}
    .timeline{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-top:12px}.timeline span{padding:12px;border-radius:16px;background:var(--surface-2);border:1px solid var(--line);font-weight:900;text-align:center;font-size:.84rem}.timeline span:not(:last-child){position:relative}.timeline span:not(:last-child)::after{content:"→";position:absolute;right:-11px;top:50%;transform:translateY(-50%);color:var(--primary);font-weight:900;z-index:1}
    .mode-card{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center}.recommendations{display:grid;gap:10px;margin-top:12px}.rec{border-left:5px solid var(--primary);background:var(--surface);border:1px solid var(--line);border-left-color:var(--primary);border-radius:14px;padding:10px}.rec strong{display:block}.rec small{color:var(--muted);font-weight:800}.campaign{display:grid;gap:14px}.world{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:16px}.world-head{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:10px}.nodes{display:flex;gap:10px;flex-wrap:wrap}.node{min-width:130px;flex:1;border-radius:18px;border:1px solid var(--line);background:var(--surface-2);padding:12px;position:relative}.node.done{background:rgba(22,163,74,.13);border-color:rgba(22,163,74,.3)}.node.hot{box-shadow:inset 0 0 0 2px rgba(239,68,68,.15)}.node .icon{font-size:1.4rem}.node b{display:block;margin:4px 0}.node small{color:var(--muted);font-weight:800}.node.boss{background:linear-gradient(135deg,rgba(239,68,68,.15),rgba(249,115,22,.12));border-color:rgba(249,115,22,.3)}
    .task-list{display:grid;gap:10px}.task{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:12px}.task input{width:auto}.task.done{opacity:.65}.task.done .task-title{text-decoration:line-through}.task-title{font-weight:900}.muted{color:var(--muted)}.empty{text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:18px;padding:28px;background:var(--surface)}
    .pomodoro-card{--pomodoro-accent:#f97316;position:relative;isolation:isolate;overflow:hidden;min-height:620px;margin-bottom:18px;border-radius:30px;padding:clamp(20px,4vw,42px);color:white;background:radial-gradient(circle at 16% 18%,rgba(250,204,21,.42),transparent 26%),radial-gradient(circle at 82% 22%,rgba(192,132,252,.34),transparent 30%),linear-gradient(145deg,#182848 0%,#355c7d 42%,#6c5b7b 72%,#c06c84 100%);box-shadow:0 28px 80px rgba(15,23,42,.25)}.pomodoro-card:before,.pomodoro-card:after{content:"";position:absolute;z-index:-1;border-radius:999px;filter:blur(5px);opacity:.5}.pomodoro-card:before{width:420px;height:420px;right:-160px;bottom:-220px;background:rgba(255,255,255,.16)}.pomodoro-card:after{width:300px;height:300px;left:-150px;top:180px;background:rgba(56,189,248,.18)}.pomodoro-card.break-mode{--pomodoro-accent:#22c55e;background:radial-gradient(circle at 20% 20%,rgba(45,212,191,.38),transparent 28%),radial-gradient(circle at 82% 18%,rgba(125,211,252,.3),transparent 32%),linear-gradient(145deg,#0f3d3e,#146c6f 52%,#2c8c7d)}.pomodoro-top{display:flex;align-items:flex-start;justify-content:space-between;gap:20px}.pomodoro-brand{font-weight:1000;letter-spacing:.08em;text-transform:uppercase;font-size:.76rem}.pomodoro-live-clock{text-align:right;font-size:1.65rem;font-weight:300;letter-spacing:-.05em}.pomodoro-live-clock small{display:block;margin-top:2px;font-size:.7rem;font-weight:800;letter-spacing:.04em;opacity:.76}.pomodoro-layout{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.6fr);gap:30px;align-items:center;max-width:1050px;margin:36px auto 0}.pomodoro-main{text-align:center}.pomodoro-greeting{font-size:clamp(1.3rem,3vw,2.1rem);font-weight:500;letter-spacing:-.04em}.pomodoro-greeting strong{font-weight:900}.pomodoro-modes{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin:20px 0}.pomodoro-mode{border:1px solid rgba(255,255,255,.24);border-radius:999px;padding:8px 13px;background:rgba(255,255,255,.09);color:white;font-size:.76rem;font-weight:900;backdrop-filter:blur(12px)}.pomodoro-mode.active{background:white;color:#172033;border-color:white}.pomodoro-ring{--timer-progress:0deg;width:min(310px,72vw);aspect-ratio:1;margin:0 auto;border-radius:50%;padding:10px;background:conic-gradient(var(--pomodoro-accent) var(--timer-progress),rgba(255,255,255,.16) 0);box-shadow:0 20px 60px rgba(0,0,0,.22)}.pomodoro-ring-inner{height:100%;border-radius:50%;display:grid;place-items:center;background:rgba(8,15,35,.5);border:1px solid rgba(255,255,255,.13);backdrop-filter:blur(16px)}.pomodoro-ring strong{display:block;font-size:clamp(3.6rem,9vw,5.8rem);font-weight:300;letter-spacing:-.09em;font-variant-numeric:tabular-nums}.pomodoro-ring span{display:block;margin-top:-12px;font-size:.7rem;font-weight:1000;letter-spacing:.16em;text-transform:uppercase;opacity:.7}.pomodoro-actions{display:flex;justify-content:center;align-items:center;gap:10px;margin-top:22px}.pomodoro-actions button{min-width:48px;height:48px;border:1px solid rgba(255,255,255,.24);border-radius:16px;background:rgba(255,255,255,.1);color:white;font-weight:1000;backdrop-filter:blur(12px)}.pomodoro-actions .primary-control{min-width:132px;background:white;color:#172033;border-color:white}.pomodoro-side{display:grid;gap:12px}.pomodoro-glass{border:1px solid rgba(255,255,255,.2);border-radius:22px;padding:16px;background:rgba(8,15,35,.24);backdrop-filter:blur(16px)}.pomodoro-glass h3{margin-bottom:5px}.pomodoro-glass p{font-size:.78rem;opacity:.75}.pomodoro-glass label{display:block;margin:13px 0 5px;font-size:.68rem;font-weight:1000;text-transform:uppercase;letter-spacing:.07em}.pomodoro-glass select,.pomodoro-glass input{border-color:rgba(255,255,255,.2);background:rgba(255,255,255,.1);color:white;box-shadow:none}.pomodoro-glass select option{color:#111827}.pomodoro-settings{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.pomodoro-settings label{margin:0}.pomodoro-session-dots{display:flex;gap:7px;margin-top:13px}.pomodoro-session-dots i{width:10px;height:10px;border:1px solid rgba(255,255,255,.5);border-radius:50%}.pomodoro-session-dots i.done{background:var(--pomodoro-accent);border-color:var(--pomodoro-accent)}.pomodoro-notify{width:100%;margin-top:13px;border:1px solid rgba(255,255,255,.2);border-radius:13px;padding:9px;background:rgba(255,255,255,.09);color:white;font-weight:900}.pomodoro-quote{text-align:center;margin-top:28px;font-size:.78rem;font-weight:700;opacity:.72}
    .xp-ring{width:150px;height:150px;border-radius:999px;background:conic-gradient(var(--primary) 0deg,var(--primary) var(--deg),var(--surface-2) var(--deg),var(--surface-2) 360deg);display:grid;place-items:center;margin:auto;border:1px solid var(--line)}.xp-ring>div{width:112px;height:112px;border-radius:999px;background:var(--surface);display:grid;place-items:center;text-align:center}.xp-ring strong{display:block;font-size:2rem}.xp-ring span{font-size:.75rem;color:var(--muted);font-weight:900}
    .modal{position:fixed;inset:0;background:rgba(0,0,0,.50);display:none;place-items:center;padding:16px;z-index:99}.modal.open{display:grid}.modal-card{width:min(720px,100%);background:var(--surface);border:1px solid var(--line);border-radius:24px;padding:18px;box-shadow:var(--shadow)}.modal-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px}.modal-head button{border:0;background:var(--surface-2);border-radius:12px;padding:9px 12px}
    .toast{position:fixed;right:18px;bottom:18px;background:var(--text);color:var(--surface);padding:12px 15px;border-radius:16px;box-shadow:var(--shadow);display:none;z-index:120;font-weight:800}.toast.show{display:block;animation:fade .2s ease}.kbd{font-family:ui-monospace,monospace;background:var(--surface-2);border:1px solid var(--line);border-radius:8px;padding:1px 6px;color:var(--muted)}
    .backup-notice{display:none;align-items:center;justify-content:space-between;gap:12px;margin-top:16px;border:1px solid rgba(245,158,11,.35);background:rgba(245,158,11,.10);border-radius:18px;padding:13px 15px}.backup-notice.show{display:flex}.backup-notice p{margin:0}.backup-status{display:block;margin-top:10px;color:var(--muted);font-weight:800;font-size:.88rem}
    @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}

    .install-hint{margin-top:10px;padding:10px 12px;border-radius:16px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.22);color:#fff;font-weight:700;font-size:.88rem}
    @media (display-mode: standalone){.hero{border-top-left-radius:0;border-top-right-radius:0}.app{padding-top:env(safe-area-inset-top)}}
    @supports (padding:max(0px)){body{padding-left:min(0px,env(safe-area-inset-left));padding-right:min(0px,env(safe-area-inset-right));}}
