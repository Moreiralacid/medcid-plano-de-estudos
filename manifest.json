<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#5b21b6">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="MEDCID">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="manifest" href="manifest.json">
  <link rel="icon" href="icons/icon-192.png">
  <link rel="apple-touch-icon" href="icons/icon-192.png">
  <title>MEDCID Planner — Estudos e Revisões</title>
  <style>
    :root{--bg:#f6f7fb;--card:#fff;--card2:#eef2ff;--text:#101828;--muted:#667085;--line:#d7ddea;--pri:#5b21b6;--pri2:#7c3aed;--accent:#06b6d4;--good:#16a34a;--warn:#f59e0b;--bad:#dc2626;--shadow:0 18px 50px rgba(16,24,40,.12);--r:22px}
    [data-theme="dark"]{--bg:#070a14;--card:#111827;--card2:#182235;--text:#f8fafc;--muted:#cbd5e1;--line:#344054;--pri:#a78bfa;--pri2:#8b5cf6;--accent:#22d3ee;--shadow:0 20px 60px rgba(0,0,0,.36)}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:radial-gradient(circle at top left,rgba(124,58,237,.25),transparent 34%),var(--bg);color:var(--text)}
    body{padding:18px}.app{max-width:1440px;margin:auto}.hero{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center;background:linear-gradient(135deg,#221152,#5b21b6 52%,#0891b2);color:#fff;border-radius:30px;padding:22px;box-shadow:var(--shadow);overflow:hidden;position:relative}.hero:after{content:"";position:absolute;inset:auto -80px -120px auto;width:300px;height:300px;background:rgba(255,255,255,.12);border-radius:999px}.hero h1{font-size:clamp(2rem,5vw,4.6rem);line-height:.95;margin:0;letter-spacing:-.06em}.hero p{margin:.55rem 0 0;color:#e0e7ff;max-width:820px}.eyebrow{display:inline-flex;gap:8px;font-weight:900;text-transform:uppercase;letter-spacing:.14em;font-size:.78rem;color:#dbeafe}.hero-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px;z-index:1}
    .layout{display:grid;grid-template-columns:260px 1fr;gap:16px;margin-top:16px}.side{position:sticky;top:18px;align-self:start;background:rgba(255,255,255,.72);backdrop-filter:blur(14px);border:1px solid var(--line);border-radius:26px;padding:12px;box-shadow:var(--shadow)}[data-theme="dark"] .side{background:rgba(17,24,39,.75)}.tabs{display:grid;gap:7px}.tab{border:0;background:transparent;color:var(--text);display:flex;gap:10px;align-items:center;padding:12px;border-radius:16px;font-weight:850;cursor:pointer;text-align:left}.tab:hover,.tab.active{background:linear-gradient(135deg,rgba(124,58,237,.16),rgba(6,182,212,.12));color:var(--pri)}.tab span:first-child{width:28px;height:28px;border-radius:10px;display:grid;place-items:center;background:var(--card2)}
    .quick{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.mini{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:10px}.mini b{font-size:1.35rem;display:block}.mini small{color:var(--muted);font-weight:700}.content{min-width:0}.view{display:none}.view.active{display:block}.grid{display:grid;gap:14px}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:18px;box-shadow:0 10px 30px rgba(16,24,40,.06)}.card h2,.card h3{margin:0 0 7px;letter-spacing:-.03em}.card p{margin:.35rem 0;color:var(--muted);line-height:1.55}.section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:12px}.stat{padding:16px;border:1px solid var(--line);border-radius:18px;background:var(--card2)}.stat b{display:block;font-size:clamp(1.7rem,4vw,3rem);letter-spacing:-.05em}.stat small{font-weight:800;color:var(--muted)}.good{color:var(--good)}.warn{color:var(--warn)}.bad{color:var(--bad)}.pri{color:var(--pri)}
    .btn{border:0;border-radius:999px;background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff;font-weight:900;padding:10px 14px;cursor:pointer;box-shadow:0 10px 22px rgba(91,33,182,.22);display:inline-flex;align-items:center;justify-content:center;gap:7px;text-decoration:none}.btn:hover{filter:brightness(1.08)}.btn.soft{background:var(--card2);color:var(--text);box-shadow:none;border:1px solid var(--line)}.btn.ghost{background:transparent;color:var(--text);box-shadow:none;border:1px solid var(--line)}.btn.badbtn{background:rgba(220,38,38,.13);color:var(--bad);box-shadow:none;border:1px solid rgba(220,38,38,.25)}.btn.small{padding:7px 10px;font-size:.82rem}.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
    label{display:block;font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;font-weight:900;color:var(--muted);margin:0 0 5px}input,select,textarea{width:100%;border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:14px;padding:11px 12px;outline:0}input:focus,select:focus,textarea:focus{border-color:var(--pri);box-shadow:0 0 0 4px rgba(124,58,237,.13)}.form{display:grid;gap:10px}.form.two{grid-template-columns:repeat(2,minmax(0,1fr))}.form.three{grid-template-columns:repeat(3,minmax(0,1fr))}.form.four{grid-template-columns:repeat(4,minmax(0,1fr))}.form.five{grid-template-columns:repeat(5,minmax(0,1fr))}.form .full{grid-column:1/-1}
    .table-wrap{overflow:auto;border:1px solid var(--line);border-radius:18px;background:var(--card)}table{border-collapse:collapse;width:100%;min-width:760px}th,td{padding:10px;border-bottom:1px solid var(--line);font-size:.92rem;text-align:left;vertical-align:top}th{background:var(--card2);color:var(--muted);font-size:.76rem;text-transform:uppercase;letter-spacing:.06em;position:sticky;top:0}tr:hover td{background:rgba(124,58,237,.05)}.badge{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:5px 9px;font-size:.75rem;font-weight:900;border:1px solid var(--line);background:var(--card2);white-space:nowrap}.red{background:rgba(239,68,68,.13);color:#ef4444}.orange{background:rgba(249,115,22,.15);color:#f97316}.yellow{background:rgba(234,179,8,.18);color:#ca8a04}.green{background:rgba(34,197,94,.13);color:#16a34a}.blue{background:rgba(37,99,235,.13);color:#2563eb}.purple{background:rgba(124,58,237,.15);color:#8b5cf6}.muted{color:var(--muted)}.empty{padding:18px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:16px;background:var(--card2)}
    .progress{height:10px;background:var(--card2);border-radius:999px;overflow:hidden;border:1px solid var(--line)}.progress span{display:block;height:100%;background:linear-gradient(90deg,var(--pri),var(--accent));border-radius:999px}.bar{display:grid;gap:6px}.bar-head{display:flex;justify-content:space-between;gap:8px;font-weight:850}.list{display:grid;gap:9px}.item{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:11px;border:1px solid var(--line);background:var(--card);border-radius:16px}.item.done{opacity:.66}.item.done b{text-decoration:line-through}.check{width:22px;height:22px;accent-color:var(--pri)}.toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%) translateY(80px);background:#101828;color:#fff;padding:12px 16px;border-radius:999px;font-weight:900;box-shadow:var(--shadow);opacity:0;transition:.25s;z-index:99}.toast.show{transform:translateX(-50%) translateY(0);opacity:1}
    .week{overflow:auto;border:1px solid var(--line);border-radius:20px;background:var(--card)}.weekgrid{display:grid;grid-template-columns:72px repeat(7,minmax(150px,1fr));min-width:1060px}.whead,.hour,.cell{border-bottom:1px solid var(--line);border-right:1px solid var(--line);padding:8px}.whead{background:var(--card2);font-size:.78rem;font-weight:900;color:var(--muted);text-align:center}.hour{background:var(--card2);font-weight:900;color:var(--muted);font-size:.8rem}.cell{min-height:64px}.pill{font-size:.76rem;line-height:1.25;background:linear-gradient(135deg,rgba(124,58,237,.16),rgba(6,182,212,.12));border:1px solid rgba(124,58,237,.22);border-radius:12px;padding:7px;margin:2px 0}.pill b{display:block}.topiccards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.topic{border:1px solid var(--line);border-radius:18px;padding:14px;background:var(--card)}.topic.done{opacity:.65}.topic.done h3{text-decoration:line-through}.campaign{display:grid;gap:14px}.world{border:1px solid var(--line);border-radius:22px;padding:15px;background:linear-gradient(135deg,rgba(124,58,237,.10),rgba(6,182,212,.06))}.nodes{display:flex;gap:10px;overflow:auto;padding:6px 0}.node{min-width:180px;border:1px solid var(--line);border-radius:18px;padding:12px;background:var(--card)}.node.done{border-color:rgba(22,163,74,.55)}.node.hot{box-shadow:0 0 0 3px rgba(239,68,68,.10)}
    .help{border-left:4px solid var(--pri);padding:10px 12px;background:var(--card2);border-radius:14px;color:var(--muted)}.install-note{font-size:.85rem;color:#e0e7ff}
    @media(max-width:1050px){body{padding:12px}.layout{grid-template-columns:1fr}.side{position:relative;top:auto}.tabs{display:flex;overflow:auto;gap:8px}.tab{min-width:max-content}.quick{grid-template-columns:repeat(4,1fr)}.topiccards{grid-template-columns:repeat(2,minmax(0,1fr))}.grid.four{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:720px){body{padding:8px}.hero{grid-template-columns:1fr;border-radius:22px;padding:16px}.hero-actions{justify-content:flex-start}.quick{grid-template-columns:repeat(2,1fr)}.grid.two,.grid.three,.grid.four,.form.two,.form.three,.form.four,.form.five,.topiccards{grid-template-columns:1fr}.card{padding:14px;border-radius:18px}.section-head{display:block}.btn{width:100%}.row .btn{width:auto}.item{align-items:flex-start}.weekgrid{grid-template-columns:58px repeat(7,minmax(116px,1fr));min-width:870px}.cell{min-height:54px;padding:5px}.pill{font-size:.7rem}.hero h1{font-size:2.25rem}}
    @media(orientation:landscape) and (max-height:560px){body{padding:8px}.hero{grid-template-columns:1fr auto;padding:12px;border-radius:18px}.hero h1{font-size:1.7rem}.hero p:not(.install-note){display:none}.layout{grid-template-columns:210px 1fr;gap:10px}.side{position:sticky;top:8px;max-height:calc(100vh - 16px);overflow:auto}.tabs{display:grid}.tab{padding:8px;font-size:.82rem}.quick{display:none}.card{padding:12px}.topiccards{grid-template-columns:repeat(2,minmax(0,1fr))}.grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}}
    @media(min-width:1180px) and (orientation:landscape){.dashboard{grid-template-columns:1.25fr .75fr}.layout{grid-template-columns:270px 1fr}}
  </style>
</head>
<body>
<div class="app">
  <header class="hero">
    <div>
      <div class="eyebrow">⚕️ MEDCID Planner corrigido</div>
      <h1>Plano de Estudos</h1>
      <p>Horários, revisões D+1/D+3/D+7/D+14/D+30, checklist de avanço, progresso, XP e backup. Funciona abrindo o arquivo no computador ou celular. Para instalar como app, hospede no GitHub Pages/Netlify.</p>
      <p class="install-note" id="openMode">Carregando modo de abertura...</p>
    </div>
    <div class="hero-actions">
      <button class="btn" id="installBtn" style="display:none">📲 Instalar app</button>
      <button class="btn soft" id="themeBtn">🌙 Modo escuro</button>
      <button class="btn soft" id="exportBtn">⬇️ Backup</button>
    </div>
  </header>

  <div class="layout">
    <aside class="side">
      <nav class="tabs" id="tabs">
        <button class="tab active" data-tab="dash"><span>📊</span>Dashboard</button>
        <button class="tab" data-tab="schedule"><span>🗓️</span>Horário</button>
        <button class="tab" data-tab="subjects"><span>📚</span>Disciplinas</button>
        <button class="tab" data-tab="reviews"><span>🔁</span>Revisões</button>
        <button class="tab" data-tab="questions"><span>🧠</span>Questões</button>
        <button class="tab" data-tab="campaign"><span>🗺️</span>Campanha</button>
        <button class="tab" data-tab="config"><span>⚙️</span>Config</button>
      </nav>
      <div class="quick">
        <div class="mini"><b id="sideProgress">0%</b><small>progresso</small></div>
        <div class="mini"><b id="sideDue">0</b><small>revisões</small></div>
        <div class="mini"><b id="sideXP">0</b><small>XP</small></div>
        <div class="mini"><b id="sideLevel">1</b><small>nível</small></div>
      </div>
    </aside>

    <main class="content">
      <section class="view active" id="dash">
        <div class="grid dashboard">
          <div class="grid">
            <div class="grid four">
              <div class="stat"><b id="stProgress" class="pri">0%</b><small>progresso geral</small></div>
              <div class="stat"><b id="stToday" class="warn">0</b><small>revisões hoje</small></div>
              <div class="stat"><b id="stLate" class="bad">0</b><small>atrasadas</small></div>
              <div class="stat"><b id="stHours" class="good">0h</b><small>horas semanais</small></div>
            </div>
            <div class="card">
              <div class="section-head"><div><h2>Missões de hoje</h2><p>O site separa revisões atrasadas e do dia.</p></div><button class="btn small soft" id="seedAllBtn">Preencher modelo do 5º período</button></div>
              <div class="list" id="todayList"></div>
            </div>
            <div class="card">
              <div class="section-head"><div><h2>Recomendações automáticas</h2><p>Baseado em revisões pendentes, assuntos quentes e desempenho.</p></div></div>
              <div class="list" id="recommendations"></div>
            </div>
          </div>
          <div class="grid">
            <div class="card"><h2>Nível de campanha</h2><div class="bar"><div class="bar-head"><span id="xpLabel">Nível 1</span><span id="xpText">0/100 XP</span></div><div class="progress"><span id="xpBar" style="width:0%"></span></div></div><p>Ganhe XP concluindo tópicos, revisões e questões.</p></div>
            <div class="card"><h2>Pareto</h2><div id="paretoBars" class="list"></div></div>
            <div class="card"><h2>Rotação da tela</h2><p id="deviceInfo">Detectando tela...</p><div class="help">No celular, ative a rotação automática. Esta versão não trava a orientação.</div></div>
          </div>
        </div>
      </section>

      <section class="view" id="schedule">
        <div class="grid">
          <div class="card">
            <div class="section-head"><div><h2>Criar horário de estudo</h2><p>Adicione blocos semanais. A grade se adapta a computador, tablet e celular girado.</p></div><button class="btn small soft" id="seedScheduleBtn">Usar grade-base do PDF</button></div>
            <form id="scheduleForm" class="form five">
              <div><label>Dia</label><select id="schDay"><option>DOM</option><option>SEG</option><option>TER</option><option>QUA</option><option>QUI</option><option>SEX</option><option>SAB</option></select></div>
              <div><label>Horário</label><select id="schHour"></select></div>
              <div><label>Atividade</label><input id="schActivity" placeholder="Ex: Clínica Médica"></div>
              <div><label>Tipo</label><select id="schType"><option>Teoria</option><option>Questões</option><option>Revisão</option><option>Prática</option><option>Rotina</option><option>Igreja</option><option>Treino</option></select></div>
              <div><label>Local</label><input id="schPlace" placeholder="Ex: Anexo/HUGV/Casa"></div>
              <div class="full row"><button class="btn" type="submit">Adicionar bloco</button><button class="btn soft" type="button" id="clearScheduleBtn">Limpar grade</button></div>
            </form>
          </div>
          <div class="week"><div class="weekgrid" id="weekGrid"></div></div>
          <div class="card"><h2>Lista de blocos</h2><div class="table-wrap"><table id="scheduleTable"></table></div></div>
        </div>
      </section>

      <section class="view" id="subjects">
        <div class="grid">
          <div class="card">
            <div class="section-head"><div><h2>Disciplinas e assuntos</h2><p>Dê check quando avançar. Você pode gerar revisões automáticas para qualquer assunto.</p></div><button class="btn small soft" id="seedSubjectsBtn">Adicionar disciplinas do PDF</button></div>
            <form id="subjectForm" class="form four">
              <div><label>Disciplina</label><input id="subName" placeholder="Ex: Anestesiologia"></div>
              <div><label>Peso</label><input id="subWeight" type="number" min="1" value="8"></div>
              <div><label>Meta semanal</label><input id="subGoal" type="number" min="0" step="0.5" value="3"></div>
              <div><label>Cor</label><select id="subColor"><option>Roxo</option><option>Azul</option><option>Verde</option><option>Laranja</option><option>Vermelho</option></select></div>
              <div class="full"><button class="btn" type="submit">Criar disciplina</button></div>
            </form>
          </div>
          <div class="card">
            <h2>Novo assunto</h2>
            <form id="topicForm" class="form five">
              <div><label>Disciplina</label><select id="topicSubject"></select></div>
              <div><label>Assunto</label><input id="topicName" placeholder="Ex: Via aérea difícil"></div>
              <div><label>Pareto</label><select id="topicHeat"><option>Muito cobrado</option><option>Cobrado</option><option>Ocasional</option><option>Raro</option></select></div>
              <div><label>Dificuldade</label><select id="topicDiff"><option>Fácil</option><option>Médio</option><option>Difícil</option></select></div>
              <div><label>Prioridade</label><select id="topicPrio"><option>Alta</option><option>Média</option><option>Baixa</option></select></div>
              <div class="full"><button class="btn" type="submit">Adicionar assunto</button></div>
            </form>
          </div>
          <div id="subjectsArea" class="grid"></div>
        </div>
      </section>

      <section class="view" id="reviews">
        <div class="grid">
          <div class="card">
            <div class="section-head"><div><h2>Programar revisão</h2><p>Escolha disciplina/assunto e o site cria D+1, D+3, D+7, D+14 e D+30.</p></div></div>
            <form id="reviewForm" class="form four">
              <div><label>Disciplina</label><input id="revSubject" placeholder="Ex: Anestesiologia"></div>
              <div><label>Assunto</label><input id="revTopic" placeholder="Ex: Bloqueios periféricos"></div>
              <div><label>Data-base</label><input id="revDate" type="date"></div>
              <div><label>Prioridade</label><select id="revPrio"><option>Alta</option><option>Média</option><option>Baixa</option></select></div>
              <div class="full"><button class="btn" type="submit">Gerar revisões automáticas</button></div>
            </form>
          </div>
          <div class="card"><div class="section-head"><div><h2>Revisões</h2><p>Marque check quando concluir.</p></div><select id="revFilter"><option value="pending">Pendentes</option><option value="today">Hoje</option><option value="late">Atrasadas</option><option value="all">Todas</option></select></div><div class="table-wrap"><table id="reviewTable"></table></div></div>
        </div>
      </section>

      <section class="view" id="questions">
        <div class="grid two">
          <div class="card">
            <h2>Registrar questões</h2>
            <form id="questionForm" class="form two">
              <div><label>Disciplina</label><input id="qSubject" placeholder="Ex: Pneumologia"></div>
              <div><label>Assunto</label><input id="qTopic" placeholder="Ex: DPOC"></div>
              <div><label>Total</label><input id="qTotal" type="number" min="1" value="10"></div>
              <div><label>Acertos</label><input id="qCorrect" type="number" min="0" value="0"></div>
              <div><label>Data</label><input id="qDate" type="date"></div>
              <div><label>Tipo</label><select id="qKind"><option>Provas antigas</option><option>Simulado</option><option>Livro</option><option>App</option></select></div>
              <div class="full"><button class="btn" type="submit">Salvar sessão</button></div>
            </form>
          </div>
          <div class="card"><h2>Pontos fracos</h2><div id="weakArea" class="list"></div></div>
          <div class="card" style="grid-column:1/-1"><h2>Histórico de questões</h2><div class="table-wrap"><table id="questionTable"></table></div></div>
        </div>
      </section>

      <section class="view" id="campaign">
        <div class="card"><h2>Mapa de campanha</h2><p>As disciplinas viram mundos, os assuntos viram fases e a prova vira chefe.</p></div>
        <div class="campaign" id="campaignArea"></div>
      </section>

      <section class="view" id="config">
        <div class="grid two">
          <div class="card">
            <h2>Configurações</h2>
            <form id="configForm" class="form two">
              <div><label>Nome do ciclo</label><input id="cycleName" value="5º Período"></div>
              <div><label>Início dos estudos</label><input id="startDate" type="date"></div>
              <div><label>Meta semanal de horas</label><input id="weeklyGoal" type="number" min="0" value="34"></div>
              <div><label>Meta diária de questões</label><input id="dailyQGoal" type="number" min="0" value="30"></div>
              <div class="full"><button class="btn" type="submit">Salvar configurações</button></div>
            </form>
          </div>
          <div class="card">
            <h2>Backup e restauração</h2>
            <p>Os dados ficam salvos no navegador deste aparelho. Para mudar de computador/celular, exporte e importe o backup.</p>
            <div class="row"><button class="btn" id="exportBtn2">Exportar JSON</button><label class="btn soft" for="importFile" style="margin:0;cursor:pointer">Importar JSON</label><input id="importFile" type="file" accept="application/json" style="display:none"></div>
            <hr style="border:0;border-top:1px solid var(--line);margin:14px 0">
            <button class="btn badbtn" id="resetBtn">Resetar tudo</button>
          </div>
          <div class="card" style="grid-column:1/-1"><h2>Como abrir corretamente</h2><div class="help"><b>No computador:</b> extraia o ZIP e dê duplo clique em <b>index.html</b>. Não abra o arquivo ainda dentro do ZIP.<br><b>No Android:</b> extraia o ZIP, abra o <b>index.html</b> no Chrome. Para instalar como app de verdade, hospede a pasta em GitHub Pages/Netlify.<br><b>No iPhone/iPad:</b> o ideal é hospedar e abrir pelo Safari. Arquivo local no iOS costuma ser mais limitado.</div></div>
        </div>
      </section>
    </main>
  </div>
</div>
