      $('#reviewDate').value = todayISO(); $('#qDate').value = todayISO(); $('#taskDate').value = todayISO(); $('#startDate').value = state.config.startDate || todayISO();
      $('#weeklyGoal').value = state.config.weeklyGoal || 16; $('#dailyQuestionsGoal').value = state.config.dailyQuestionsGoal || 30; $('#cycleName').value = state.config.cycleName || '6º período';
      hydrateLearningProfile();
