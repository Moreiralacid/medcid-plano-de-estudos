      renderDatalist(); renderDashboard(); renderSchedule(); renderSubjects(); renderReviews(); renderReviewCalendar(); renderQuestions(); renderCampaign(); renderTasks(); renderPomodoro(); renderLearningProfile(); renderAIConnector(); renderPromptLibrary(); renderFlashcards(); renderHabits(); renderDiagnosis(); renderPriorities(); renderRecoveryPlan(); renderRecoveryErrors(); renderRecoveryProgress(); renderRecoveryReport(); renderSidebar();
    }

    function renderSidebar(){
