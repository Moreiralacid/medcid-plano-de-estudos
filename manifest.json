      $('#overdueReviewsCount').textContent = overdueReviews().length;
      $('#overallProgress').textContent = calcOverallProgress()+'%';
      const cardsStudied=state.flashcards.reduce((sum,c)=>sum+(c.reviewCount||0),0);
      const qTotal=state.questions.reduce((sum,q)=>sum+Number(q.total||0),0); const qCorrect=state.questions.reduce((sum,q)=>sum+Number(q.correct||0),0);
      const cTotal=state.flashcards.reduce((sum,c)=>sum+(c.reviewCount||0),0); const cCorrect=state.flashcards.reduce((sum,c)=>sum+(c.correctCount||0),0);
      const accuracy=(qTotal+cTotal)?Math.round((qCorrect+cCorrect)/(qTotal+cTotal)*100):0;
