    @media print{.sidebar,.hero,.hero-actions,.filters,.btn,.modal,.toast{display:none!important}.shell{display:block;margin:0}.panel{display:none!important}.panel.active{display:block!important;margin-bottom:20px}.card{box-shadow:none}.app{max-width:none;padding:0}.report-cover{break-inside:avoid}}

    /* ===== MEDCID Learning OS ===== */
    .hero{padding:22px 26px}.hero h1{font-size:clamp(1.9rem,4vw,3.35rem)}
    .sidebar-brand{display:flex;align-items:center;gap:11px;padding:4px 6px 14px;border-bottom:1px solid var(--line);margin-bottom:10px}
    .brand-mark{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,var(--primary),var(--accent));color:white;font-weight:1000;box-shadow:0 10px 24px rgba(109,40,217,.24)}
    .sidebar-brand strong{display:block}.sidebar-brand small{color:var(--muted);font-weight:800}
    .nav-label{padding:10px 10px 5px;color:var(--muted);font-size:.67rem;letter-spacing:.11em;text-transform:uppercase;font-weight:1000}
    .tab.beta:after{content:"IA";margin-left:auto;padding:3px 6px;border-radius:999px;background:linear-gradient(135deg,#d946ef,#8b5cf6);color:white;font-size:.62rem}
    .action-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:16px}
    .action-card{position:relative;overflow:hidden;min-height:148px;border:0;border-radius:24px;padding:20px;color:#fff;text-align:left;box-shadow:var(--shadow);transition:transform .18s ease,filter .18s ease}
    .action-card:hover{transform:translateY(-3px);filter:saturate(1.08)}.action-card:after{content:"";position:absolute;width:150px;height:150px;border-radius:999px;right:-50px;bottom:-65px;background:rgba(255,255,255,.15)}
    .action-card.study{background:linear-gradient(135deg,#2563eb,#06b6d4)}.action-card.review{background:linear-gradient(135deg,#16a34a,#34d399)}.action-card.teacher{background:linear-gradient(135deg,#4c1d95,#7c3aed 62%,#d97706)}
    .action-icon{display:flex;align-items:center;justify-content:center;width:42px;height:42px;flex:0 0 42px;border-radius:14px;background:rgba(255,255,255,.18);font-family:"Segoe UI Symbol",Arial,sans-serif;font-size:1.3rem;font-weight:900;line-height:1;text-align:center;margin:0 0 18px;padding:0}.action-card>strong{display:block;font-size:1.15rem}.action-card>span:not(.action-icon){display:block;color:rgba(255,255,255,.84);margin-top:4px;font-size:.87rem;font-weight:700}
    .metric-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-bottom:16px}.metric-card{display:flex;flex-direction:column;align-items:flex-start;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:13px;box-shadow:0 9px 30px rgba(20,24,39,.06)}.metric-icon{width:30px;height:30px;flex:0 0 30px;border-radius:10px;display:flex;align-items:center;justify-content:center;margin:0 0 8px;padding:0;font-family:"Segoe UI Symbol",Arial,sans-serif;font-size:1rem;font-weight:1000;line-height:1;text-align:center;color:var(--primary);background:rgba(109,40,217,.1)}.metric-card:nth-child(2) .metric-icon{color:#db2777;background:rgba(219,39,119,.1)}.metric-card:nth-child(3) .metric-icon{color:#0891b2;background:rgba(8,145,178,.1)}.metric-card:nth-child(4) .metric-icon{color:#d97706;background:rgba(217,119,6,.12)}.metric-card:nth-child(5) .metric-icon{color:#2563eb;background:rgba(37,99,235,.1)}.metric-card:nth-child(6) .metric-icon{color:#16a34a;background:rgba(22,163,74,.1)}.metric-card strong{display:block;font-size:1.38rem;letter-spacing:-.04em;line-height:1.15}.metric-card span{display:block;color:var(--muted);font-size:.72rem;font-weight:900;text-transform:uppercase;letter-spacing:.04em}.heading-icon{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;margin-right:5px;border-radius:9px;color:#ea580c;background:rgba(249,115,22,.12);font-family:"Segoe UI Symbol",Arial,sans-serif;font-size:.8rem;line-height:1;text-align:center;vertical-align:middle}
    .dashboard-main{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,.75fr);gap:16px}.stack{display:grid;gap:16px}.streak-card{background:linear-gradient(145deg,rgba(249,115,22,.14),rgba(251,191,36,.08)),var(--surface)}.streak-number{font-size:3.4rem;font-weight:1000;letter-spacing:-.08em;color:#ea580c}.mini-week{display:grid;grid-template-columns:repeat(7,1fr);gap:7px;margin-top:13px}.mini-day{text-align:center}.mini-day span{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;margin:6px auto 0;background:var(--surface-2);font-size:.78rem;font-weight:1000}.mini-day.done span{background:linear-gradient(135deg,#f97316,#facc15);color:white}.mini-day small{font-size:.63rem;color:var(--muted);font-weight:900}
    .subject-progress-row{display:grid;grid-template-columns:12px minmax(120px,1fr) minmax(140px,2fr) auto;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}.subject-progress-row:last-child{border-bottom:0}.subject-dot{width:10px;height:10px;border-radius:999px}.subject-progress-row b{font-size:.88rem}.subject-progress-row small{color:var(--muted);font-weight:900}
    .flow-layout,.ai-layout{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr);gap:16px}.feature-hero{background:linear-gradient(135deg,rgba(217,70,239,.14),rgba(6,182,212,.12)),var(--surface)}.interest-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.interest-chip{display:flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:10px;font-weight:800}.interest-chip input{width:auto}.upload-zone{border:2px dashed var(--line);border-radius:16px;padding:18px;text-align:center;color:var(--muted);background:var(--bg)}
    .journey-preview{display:grid;gap:11px;margin-top:15px}.journey-step{display:grid;grid-template-columns:36px 1fr;gap:10px;align-items:center;border:1px solid var(--line);background:var(--surface);border-radius:16px;padding:11px}.journey-step span{width:36px;height:36px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(135deg,rgba(109,40,217,.16),rgba(6,182,212,.14))}
    .chat-shell{display:grid;grid-template-rows:auto minmax(330px,1fr) auto;min-height:570px}.chat-header{display:flex;align-items:center;gap:12px;padding-bottom:14px;border-bottom:1px solid var(--line)}.ai-avatar{width:50px;height:50px;border-radius:16px;display:block;overflow:hidden;background:#4c1d95;box-shadow:0 10px 26px rgba(76,29,149,.28)}.online-dot{display:inline-block;width:8px;height:8px;border-radius:99px;background:#22c55e;margin-right:5px}.chat-messages{display:flex;flex-direction:column;gap:12px;padding:16px 2px;overflow:auto;max-height:500px}.chat-message{max-width:86%;padding:12px 14px;border-radius:18px;white-space:pre-wrap;line-height:1.55}.chat-message.ai{align-self:flex-start;background:linear-gradient(135deg,rgba(124,58,237,.09),rgba(245,158,11,.08)),var(--surface-2);border-bottom-left-radius:5px}.chat-message.user{align-self:flex-end;background:linear-gradient(135deg,var(--primary),var(--primary-2));color:white;border-bottom-right-radius:5px}.chat-message.user small{color:rgba(255,255,255,.7)}.chat-compose{display:grid;grid-template-columns:1fr auto;gap:9px;border-top:1px solid var(--line);padding-top:14px}.chat-compose textarea{min-height:48px;max-height:140px}.prompt-chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.prompt-chip{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:8px 11px;font-size:.78rem;font-weight:800;color:var(--muted);min-height:38px}
    .ai-connector-card{background:linear-gradient(135deg,rgba(109,40,217,.1),rgba(6,182,212,.08)),var(--surface)}.provider-summary{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:12px}.provider-summary strong{color:var(--primary)}.external-import{margin-top:14px;border:1px solid var(--line);border-radius:18px;padding:14px;background:var(--surface-2)}.external-import textarea{min-height:150px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.8rem}.prompt-modal-card{width:min(820px,100%)}.prompt-modal-card textarea{min-height:min(46vh,420px);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.82rem;line-height:1.5;white-space:pre-wrap}.prompt-modal-actions{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;margin-top:12px}.provider-note{margin:0 0 12px;padding:10px 12px;border-radius:14px;background:var(--surface-2);border:1px solid var(--line);color:var(--muted);font-size:.82rem;font-weight:700}.mini-day.today{box-shadow:inset 0 0 0 2px var(--primary)}.week-caption{display:block;margin-top:9px;color:var(--muted);font-size:.75rem;font-weight:800}.manual-flashcard-card{margin-top:16px;background:linear-gradient(135deg,rgba(236,72,153,.08),rgba(109,40,217,.07)),var(--surface)}
    .prompt-library-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:16px 0}.prompt-template-card{display:flex;flex-direction:column;min-height:220px}.prompt-template-card .prompt-number{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(135deg,var(--primary),var(--primary-2));color:#fff;font-size:.75rem;font-weight:1000}.prompt-template-card h3{margin:14px 0 7px}.prompt-template-card p{flex:1}.prompt-preview{font-size:.72rem;color:var(--muted);padding:9px 10px;border-radius:12px;background:var(--surface-2);border:1px solid var(--line);margin:9px 0;line-height:1.45}.saved-prompt-list{display:grid;gap:10px;margin-top:14px}.saved-prompt-row{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:12px;border:1px solid var(--line);border-radius:15px;background:var(--surface-2)}.saved-prompt-row .actions{justify-content:flex-end}.prompt-variable-guide{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0 13px}.prompt-variable-guide code{padding:5px 8px;border-radius:8px;background:var(--surface-2);border:1px solid var(--line);font-size:.72rem}@media(max-width:1100px){.prompt-library-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:720px){.prompt-library-grid{grid-template-columns:1fr}.saved-prompt-row{grid-template-columns:1fr}}
    .flashcard-stage{min-height:430px;display:grid;place-items:center}.flashcard{width:min(620px,100%);min-height:310px;border:1px solid var(--line);border-radius:28px;padding:26px;background:linear-gradient(145deg,rgba(109,40,217,.09),rgba(6,182,212,.08)),var(--surface);display:flex;flex-direction:column;justify-content:center;text-align:center;cursor:pointer;box-shadow:var(--shadow)}.flashcard .card-label{font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;color:var(--primary);font-weight:1000}.flashcard h3{font-size:clamp(1.25rem,3vw,2rem);margin:16px 0}.flashcard-answer{display:none;border-top:1px solid var(--line);padding-top:18px}.flashcard.revealed .flashcard-question{display:none}.flashcard.revealed .flashcard-answer{display:block}.rating-row{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:14px}.rating-row button{border:0;border-radius:13px;padding:9px 13px;font-weight:900}.rate-again{background:rgba(220,38,38,.12);color:#dc2626}.rate-hard{background:rgba(249,115,22,.14);color:#ea580c}.rate-good{background:rgba(22,163,74,.13);color:#16a34a}.rate-easy{background:rgba(37,99,235,.13);color:#2563eb}
    .calendar-shell{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(280px,.6fr);gap:16px;margin-bottom:16px}.month-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:7px}.month-head{text-align:center;font-size:.68rem;color:var(--muted);font-weight:1000;padding:5px}.month-day{min-height:78px;border:1px solid var(--line);background:var(--surface);border-radius:13px;padding:8px;font-weight:900}.month-day.muted{opacity:.35}.month-day.today{box-shadow:inset 0 0 0 2px var(--primary)}.day-dots{display:flex;gap:4px;flex-wrap:wrap;margin-top:8px}.day-dots i{width:7px;height:7px;border-radius:99px;background:var(--primary)}.day-dots i.flash{background:#ec4899}.review-cycle{display:grid;gap:8px}.cycle-step{display:flex;align-items:center;justify-content:space-between;border:1px solid var(--line);border-radius:14px;padding:10px;background:var(--surface)}
    .day-dots i.exam-review{background:#f59e0b}.day-dots i.exam{background:#dc2626;width:10px;height:10px}.exam-chip{display:block;width:max-content;max-width:100%;margin-top:7px;padding:3px 6px;border-radius:7px;background:rgba(220,38,38,.12);color:#dc2626;font-size:.57rem;font-weight:1000;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.calendar-nav{display:flex;align-items:center;gap:6px}.calendar-nav .btn{min-width:38px;padding:8px 10px}.calendar-nav .today-btn{min-width:auto}
    .habit-grid{display:grid;grid-template-columns:minmax(150px,1.4fr) repeat(7,minmax(42px,.5fr));gap:7px;align-items:center}.habit-head{text-align:center;font-size:.7rem;font-weight:1000;color:var(--muted)}.habit-name{font-weight:900}.habit-check{width:100%;aspect-ratio:1;border:1px solid var(--line);border-radius:12px;background:var(--surface);min-height:42px}.habit-check.done{background:linear-gradient(135deg,#22c55e,#06b6d4);color:white;border-color:transparent}.habit-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}.habit-summary .stat{text-align:center}
    .loading-dots:after{content:"";animation:loadingText 1.2s steps(4,end) infinite}@keyframes loadingText{0%{content:""}25%{content:"."}50%{content:".."}75%,100%{content:"..."}}

    /* ===== Projeto Angels integrado ===== */
    .angels-banner{position:relative;overflow:hidden;background:linear-gradient(135deg,rgba(37,99,235,.14),rgba(22,163,74,.10)),var(--surface);border-color:rgba(37,99,235,.2)}
    .angels-banner:after{content:"A";position:absolute;right:18px;bottom:-38px;font-size:10rem;font-weight:1000;color:rgba(37,99,235,.055);line-height:1}.angels-banner>*{position:relative;z-index:1}
    .angels-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-top:14px}.angels-kpi{border:1px solid var(--line);background:var(--surface);border-radius:15px;padding:11px}.angels-kpi strong{display:block;font-size:1.35rem}.angels-kpi span{color:var(--muted);font-size:.68rem;font-weight:900;text-transform:uppercase}
    .diagnosis-layout{display:grid;grid-template-columns:minmax(280px,.72fr) minmax(0,1.28fr);gap:16px}.diagnosis-questions{display:grid;gap:10px}.score-question{border:1px solid var(--line);background:var(--surface);border-radius:16px;padding:12px}.score-question header{display:flex;justify-content:space-between;gap:12px;margin-bottom:9px}.score-question header b{font-size:.88rem}.score-question output{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;background:var(--surface-2);font-weight:1000;color:var(--primary)}.score-question input[type="range"]{padding:0;border:0;background:transparent;box-shadow:none}.scale-labels{display:flex;justify-content:space-between;color:var(--muted);font-size:.67rem;font-weight:800}
    .diagnosis-score{display:grid;place-items:center;width:150px;height:150px;margin:14px auto;border-radius:999px;background:conic-gradient(var(--primary) var(--score-deg,0deg),var(--surface-2) 0);border:1px solid var(--line)}.diagnosis-score>div{width:112px;height:112px;border-radius:999px;background:var(--surface);display:grid;place-items:center;text-align:center}.diagnosis-score strong{display:block;font-size:2rem}.diagnosis-score small{color:var(--muted);font-weight:900}
    .priority-summary{display:grid;grid-template-columns:1.25fr repeat(3,.55fr);gap:10px;margin-bottom:16px}.priority-summary>div{border:1px solid var(--line);background:var(--surface);border-radius:18px;padding:14px}.priority-summary .top-priority{background:linear-gradient(135deg,rgba(220,38,38,.10),rgba(249,115,22,.08)),var(--surface)}.priority-summary strong{display:block;font-size:1.35rem}.priority-summary span{color:var(--muted);font-size:.75rem;font-weight:900}
    .priority-board{display:grid;gap:12px}.priority-card{display:grid;grid-template-columns:86px minmax(150px,.8fr) minmax(0,2fr);gap:15px;align-items:start;border:1px solid var(--line);background:var(--surface);border-radius:20px;padding:15px}.priority-score{width:76px;height:76px;border-radius:20px;display:grid;place-items:center;background:linear-gradient(135deg,rgba(109,40,217,.16),rgba(6,182,212,.12));text-align:center}.priority-score strong{font-size:1.55rem}.priority-score small{display:block;font-size:.6rem;color:var(--muted);font-weight:900}.priority-fields{display:grid;grid-template-columns:repeat(5,minmax(80px,1fr));gap:8px}.priority-fields .field input{padding:8px;border-radius:10px}.priority-factors{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
    .plan-toolbar{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:16px}.plan-toolbar .stat{text-align:center}.plan-week{display:grid;grid-template-columns:repeat(7,minmax(190px,1fr));gap:10px;overflow:auto;padding-bottom:8px}.plan-day{border:1px solid var(--line);background:var(--surface);border-radius:20px;padding:12px;min-height:360px}.plan-day.today{box-shadow:inset 0 0 0 2px var(--primary)}.plan-day>header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:10px;margin-bottom:10px}.plan-day>header span{color:var(--muted);font-size:.72rem;font-weight:900}.plan-task{border:1px solid var(--line);background:var(--surface-2);border-radius:14px;padding:10px;margin-bottom:8px;cursor:pointer}.plan-task.completed{background:rgba(22,163,74,.12);border-color:rgba(22,163,74,.25)}.plan-task.partial{background:rgba(245,158,11,.12);border-color:rgba(245,158,11,.25)}.plan-task small{display:block;color:var(--muted);margin-top:5px;font-weight:800}.task-type{font-size:.63rem;text-transform:uppercase;letter-spacing:.06em;color:var(--primary);font-weight:1000}
    .error-layout{display:grid;grid-template-columns:minmax(290px,.7fr) minmax(0,1.3fr);gap:16px}.error-list{display:grid;gap:10px}.error-card{border:1px solid var(--line);background:var(--surface);border-radius:18px;padding:14px}.error-card.recurring{border-left:5px solid var(--bad)}.error-card header{display:flex;justify-content:space-between;gap:10px}.error-card h3{margin:6px 0}.error-meta{display:flex;gap:6px;flex-wrap:wrap}.error-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:11px}.error-concept{border-left:3px solid var(--primary);padding-left:10px;margin:10px 0;color:var(--muted)}
    .checkin-layout{display:grid;grid-template-columns:minmax(280px,.75fr) minmax(0,1.25fr);gap:16px}.checkin-score{display:flex;align-items:end;gap:7px;height:180px;padding-top:15px}.checkin-score>div{flex:1;text-align:center}.checkin-score i{display:block;min-height:4px;border-radius:9px 9px 3px 3px;background:linear-gradient(180deg,var(--accent),var(--primary));margin-bottom:7px}.checkin-score small{color:var(--muted);font-size:.66rem;font-weight:900}.checkin-history{display:grid;gap:9px}.checkin-row{display:grid;grid-template-columns:90px 1fr auto;gap:12px;align-items:center;border:1px solid var(--line);border-radius:14px;padding:10px;background:var(--surface)}
    .report-cover{display:grid;grid-template-columns:1fr auto;gap:20px;align-items:center;background:linear-gradient(135deg,#111a34,#4c1d95);color:white;border-radius:26px;padding:26px;margin-bottom:16px;box-shadow:var(--shadow)}.report-cover p{color:rgba(255,255,255,.75)}.report-cover>strong{font-size:4rem;letter-spacing:-.08em;text-align:center}.report-cover>strong small{font-size:1.6rem}.report-cover>strong span{display:block;font-size:.7rem;letter-spacing:.08em;text-transform:uppercase}.report-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.report-stat{border:1px solid var(--line);background:var(--surface);border-radius:16px;padding:14px}.report-stat strong{display:block;font-size:1.7rem}.report-stat span{color:var(--muted);font-size:.72rem;font-weight:900}.report-section{margin-top:16px}.report-label{font-size:.69rem;letter-spacing:.12em;color:var(--primary);font-weight:1000;text-transform:uppercase;margin-bottom:8px}.report-recommendations{padding-left:20px;color:var(--muted);line-height:1.7}
    .weight-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.weight-row{border:1px solid var(--line);border-radius:14px;padding:10px;background:var(--surface)}.weight-row span{display:flex;justify-content:space-between;font-size:.76rem;font-weight:900}.weight-row input{padding:0;border:0;background:transparent;box-shadow:none}

    @media (max-width:1100px){.diagnosis-layout,.error-layout,.checkin-layout{grid-template-columns:1fr}.priority-card{grid-template-columns:75px 1fr}.priority-fields{grid-column:1/-1}.priority-summary{grid-template-columns:repeat(2,1fr)}.report-grid{grid-template-columns:repeat(2,1fr)}}
    @media (max-width:720px){.angels-kpis,.plan-toolbar,.priority-summary,.report-grid{grid-template-columns:repeat(2,1fr)}.priority-card{grid-template-columns:1fr}.priority-score{width:100%;height:64px}.priority-fields{grid-template-columns:repeat(2,1fr)}.report-cover{grid-template-columns:1fr}.report-cover>strong{text-align:left}.weight-grid{grid-template-columns:1fr}.checkin-row{grid-template-columns:1fr}.plan-week{grid-template-columns:repeat(7,176px)}}

    @media (max-width:1100px){.metric-grid{grid-template-columns:repeat(3,1fr)}.flow-layout,.ai-layout,.calendar-shell{grid-template-columns:1fr}.action-grid{grid-template-columns:repeat(3,1fr)}}
    @media (max-width:720px){.action-grid{grid-template-columns:1fr}.action-card{min-height:120px}.metric-grid{grid-template-columns:repeat(2,1fr)}.dashboard-main{grid-template-columns:1fr}.interest-grid{grid-template-columns:1fr}.habit-grid{grid-template-columns:120px repeat(7,42px);min-width:470px}.habit-table-wrap{overflow:auto}.chat-shell{min-height:520px}.subject-progress-row{grid-template-columns:10px 1fr auto}.subject-progress-row .progress{grid-column:2/4;width:100%}}
    @media (max-width:1100px){.pomodoro-layout{grid-template-columns:1fr}.pomodoro-side{grid-template-columns:repeat(2,1fr)}}
    @media (max-width:720px){.pomodoro-card{min-height:0;border-radius:22px;padding:18px}.pomodoro-layout{margin-top:25px}.pomodoro-side{grid-template-columns:1fr}.pomodoro-live-clock{font-size:1.25rem}.pomodoro-greeting{font-size:1.35rem}}
  </style>
</head>
<body>
  <div class="app">
    <header class="hero">
      <div>
        <p class="eyebrow">MEDCID Learning OS</p>
        <h1>Seu estudo, do seu jeito.</h1>
        <p>Planejamento, biblioteca de prompts, flashcards e revisões espaçadas conectados em uma única jornada de aprendizagem.</p>
      </div>
      <div class="hero-actions">
        <button id="installApp" class="btn secondary" style="display:none"><span aria-hidden="true">＋</span> Instalar app</button>
        <button id="darkToggle" class="btn secondary"><span aria-hidden="true">◐</span> Modo escuro</button>
        <button id="exportData" class="btn secondary"><span aria-hidden="true">↓</span> Exportar</button>
        <button id="importBtn" class="btn secondary"><span aria-hidden="true">↑</span> Importar</button>
        <button id="resetData" class="btn danger">Resetar</button>
        <input id="importFile" type="file" accept="application/json" hidden />
      </div>
    </header>

    <div class="shell">
      <aside class="sidebar">
        <div class="sidebar-brand"><div class="brand-mark">M</div><div><strong>MEDCID</strong><small>Study intelligence</small></div></div>
        <nav class="tabs" aria-label="Abas do sistema" role="tablist">
          <div class="nav-label">Aprender</div>
          <button class="tab active" data-tab="inicio" role="tab" aria-controls="inicio" aria-selected="true"><span class="ico" aria-hidden="true">▦</span>Dashboard</button>
          <button class="tab beta" data-tab="flowing" role="tab" aria-controls="flowing" aria-selected="false"><span class="ico" aria-hidden="true">◇</span>Flowing</button>
          <button class="tab beta" data-tab="professor" role="tab" aria-controls="professor" aria-selected="false"><span class="ico" aria-hidden="true">≡</span>Biblioteca de prompts</button>
          <button class="tab beta" data-tab="flashcards" role="tab" aria-controls="flashcards" aria-selected="false"><span class="ico" aria-hidden="true">▤</span>IA Flashcards</button>
          <div class="nav-label">Projeto Angels</div>
          <button class="tab" data-tab="diagnostico" role="tab" aria-controls="diagnostico" aria-selected="false"><span class="ico" aria-hidden="true">◉</span>Diagnóstico</button>
          <button class="tab" data-tab="prioridades" role="tab" aria-controls="prioridades" aria-selected="false"><span class="ico" aria-hidden="true">◎</span>Prioridades</button>
          <button class="tab" data-tab="plano7" role="tab" aria-controls="plano7" aria-selected="false"><span class="ico" aria-hidden="true">◫</span>Plano de 7 dias</button>
          <button class="tab" data-tab="erros" role="tab" aria-controls="erros" aria-selected="false"><span class="ico" aria-hidden="true">⊘</span>Banco de erros</button>
          <button class="tab" data-tab="progresso" role="tab" aria-controls="progresso" aria-selected="false"><span class="ico" aria-hidden="true">↗</span>Progresso</button>
          <button class="tab" data-tab="relatorio" role="tab" aria-controls="relatorio" aria-selected="false"><span class="ico" aria-hidden="true">≡</span>Relatório</button>
          <div class="nav-label">Organizar</div>
          <button class="tab" data-tab="horario" role="tab" aria-controls="horario" aria-selected="false"><span class="ico" aria-hidden="true">◫</span>Horário</button>
          <button class="tab" data-tab="disciplinas" role="tab" aria-controls="disciplinas" aria-selected="false"><span class="ico" aria-hidden="true">▥</span>Disciplinas</button>
          <button class="tab" data-tab="revisoes" role="tab" aria-controls="revisoes" aria-selected="false"><span class="ico" aria-hidden="true">↻</span>Calendário</button>
          <button class="tab" data-tab="habitos" role="tab" aria-controls="habitos" aria-selected="false"><span class="ico" aria-hidden="true">○</span>Hábitos</button>
          <div class="nav-label">Desempenho</div>
          <button class="tab" data-tab="questoes" role="tab" aria-controls="questoes" aria-selected="false"><span class="ico" aria-hidden="true">?</span>Questões</button>
          <button class="tab" data-tab="campanha" role="tab" aria-controls="campanha" aria-selected="false"><span class="ico" aria-hidden="true">◈</span>Campanha</button>
          <button class="tab" data-tab="preprova" role="tab" aria-controls="preprova" aria-selected="false"><span class="ico" aria-hidden="true">△</span>Pré-prova</button>
          <button class="tab" data-tab="tarefas" role="tab" aria-controls="tarefas" aria-selected="false"><span class="ico" aria-hidden="true">✓</span>Tarefas</button>
          <button class="tab" data-tab="config" role="tab" aria-controls="config" aria-selected="false"><span class="ico" aria-hidden="true">⚙</span>Config</button>
        </nav>
        <div class="quick-stats">
          <div class="pill-stat"><strong id="sideXP">0</strong><span>XP total</span></div>
          <div class="pill-stat"><strong id="sideDue">0</strong><span>revisões hoje</span></div>
          <div class="pill-stat"><strong id="sideProgress">0%</strong><span>progresso</span></div>
        </div>
      </aside>

      <main>
        <section id="inicio" class="panel active">
          <div class="section-head"><div><p class="eyebrow" style="color:var(--primary)!important">Visão de hoje</p><h2 id="dashboardGreeting">Olá! Vamos avançar um pouco hoje?</h2><p id="todayLabel">Carregando...</p></div><span id="dashboardCycleBadge" class="badge purple">6º período</span></div>
          <div class="action-grid">
            <button class="action-card study" data-jump="horario"><span class="action-icon" aria-hidden="true">▶</span><strong>Estudar agora</strong><span>Continue sua próxima sessão planejada</span></button>
            <button class="action-card review" data-jump="revisoes"><span class="action-icon" aria-hidden="true">↻</span><strong>Revisar</strong><span><b id="actionDueCount">0</b> cartões e revisões pendentes</span></button>
            <button class="action-card teacher" data-jump="professor"><span class="action-icon" aria-hidden="true">≡</span><strong>Usar prompts</strong><span>Modelos pessoais adaptados pelo Flowing</span></button>
          </div>
          <div class="metric-grid">
            <div class="metric-card"><div class="metric-icon" aria-hidden="true">▦</div><strong id="totalBlocks">0</strong><span>Blocos semanais</span></div>
            <div class="metric-card"><div class="metric-icon" aria-hidden="true">▤</div><strong id="studiedCardsCount">0</strong><span>Cards estudados</span></div>
            <div class="metric-card"><div class="metric-icon" aria-hidden="true">◎</div><strong id="accuracyMetric">0%</strong><span>Precisão</span></div>
            <div class="metric-card"><div class="metric-icon" aria-hidden="true">★</div><strong id="xpMetric">0</strong><span>Pontos XP</span></div>
            <div class="metric-card"><div class="metric-icon" aria-hidden="true">▥</div><strong id="totalSubjectsMetric">0</strong><span>Matérias</span></div>
            <div class="metric-card"><div class="metric-icon" aria-hidden="true">↗</div><strong id="overallProgress">0%</strong><span>Progresso</span></div>
          </div>
          <div class="dashboard-main">
            <div class="stack">
              <article class="card"><div class="section-head"><div><h2>Progresso por matéria</h2><p>Domínio dos assuntos e revisões concluídas.</p></div><button class="btn small soft" data-jump="disciplinas">Ver matérias</button></div><div id="subjectProgressDashboard"></div></article>
              <article class="card angels-banner"><div class="section-head"><div><p class="eyebrow" style="color:#2563eb!important">Projeto Angels</p><h2>Seu ciclo de recuperação</h2><p>Do diagnóstico ao próximo passo executável.</p></div><button class="btn small soft" data-jump="diagnostico">Abrir Angels</button></div><div class="angels-kpis"><div class="angels-kpi"><strong id="angelsDiagnosisMetric">0%</strong><span>clareza atual</span></div><div class="angels-kpi"><strong id="angelsPriorityMetric">—</strong><span>prioridade</span></div><div class="angels-kpi"><strong id="angelsExecutionMetric">0%</strong><span>execução 7 dias</span></div><div class="angels-kpi"><strong id="angelsErrorsMetric">0</strong><span>erros abertos</span></div></div></article>
              <article class="card"><div class="section-head"><div><h2>Fila de revisão</h2><p>Comece pelas atividades vencidas.</p></div><div><span class="badge orange"><b id="todayReviewsCount">0</b> hoje</span> <span class="badge red"><b id="overdueReviewsCount">0</b> atrasadas</span></div></div><div id="todayList" class="today-list"></div></article>
            </div>
            <div class="stack">
              <article class="card streak-card"><h2><span class="heading-icon" aria-hidden="true">◆</span>Sequência desta semana</h2><div><span id="activeStreak" class="streak-number">0</span> <b>dias ativos na semana</b></div><div id="dashboardMiniWeek" class="mini-week"></div><small id="dashboardWeekCaption" class="week-caption"></small><button class="btn small soft full" data-jump="habitos" style="margin-top:14px">Registrar hábitos de hoje</button></article>
              <article class="card"><h2>Seu nível</h2><div id="xpRing" class="xp-ring" style="--deg:0deg"><div><div><strong id="xpText">0</strong><span>XP</span></div></div></div><p style="text-align:center"><b id="levelText">Nível 0</b><br><span class="muted" id="nextLevelText">Faltam 100 XP para o nível 1</span></p><div class="progress"><span id="levelBar"></span></div></article>
              <article class="card"><h2>Foco recomendado</h2><div id="dailyRecommendations" class="recommendations"></div><div id="priorityBars" class="bar-list" style="margin-top:12px"></div></article>
            </div>
          </div>
          <aside id="backupNotice" class="backup-notice" aria-label="Lembrete de backup">
            <p><strong>Proteja seu plano de estudos.</strong><br><span id="backupNoticeText">Faça uma cópia dos seus dados.</span></p>
            <button class="btn small soft" data-export-backup>Exportar agora</button>
          </aside>

        </section>

        <section id="flowing" class="panel">
          <div class="section-head"><div><p class="eyebrow" style="color:#d946ef!important">Personalização</p><h2>Flowing</h2><p>Conte à plataforma como você aprende melhor e receba uma jornada feita para você.</p></div><span class="badge purple">Beta</span></div>
          <div class="flow-layout">
            <article class="card feature-hero">
              <h2>Configure seu aprendizado</h2>
              <div class="form grid two">
                <div class="field" style="grid-column:1/-1"><label>O que você quer aprender?</label><input id="flowGoal" placeholder="Ex.: dominar insuficiência cardíaca para a prova" /></div>
                <div class="field"><label>Matéria</label><input id="flowSubject" list="subjectOptions" placeholder="Selecione ou digite" /></div>
                <div class="field"><label>Como prefere aprender?</label><select id="flowStyle"><option>Explicações visuais</option><option>Casos clínicos</option><option>Perguntas e respostas</option><option>Analogias do cotidiano</option><option>Passo a passo</option></select></div>
                <div class="field" style="grid-column:1/-1"><label>Material de estudo ou anotações</label><textarea id="flowMaterial" placeholder="Cole aqui um resumo, objetivos da aula ou pontos que considera difíceis..."></textarea></div>
                <div class="upload-zone" style="grid-column:1/-1"><strong>Anexo</strong> · Materiais extensos podem ser resumidos e colados no campo acima.</div>
              </div>
              <h3>Do que você gosta?</h3><p>A biblioteca usará esses temas para adaptar analogias e estratégias de memorização.</p>
              <div class="interest-grid" id="interestGrid">
                <label class="interest-chip"><input type="checkbox" value="Jogos e gamificação">Jogos e gamificação</label><label class="interest-chip"><input type="checkbox" value="Filmes e séries">Filmes e séries</label><label class="interest-chip"><input type="checkbox" value="Música">Música</label><label class="interest-chip"><input type="checkbox" value="Esportes">Esportes</label><label class="interest-chip"><input type="checkbox" value="Tecnologia">Tecnologia</label><label class="interest-chip"><input type="checkbox" value="Casos clínicos">Casos clínicos</label>
              </div>
              <button id="saveLearningProfile" class="btn full" style="margin-top:16px">Começar jornada personalizada</button>
            </article>
            <article class="card"><h2>Sua jornada de aprendizagem</h2><p id="flowPreviewText">Configure seu objetivo para criar uma trilha integrada.</p><div class="journey-preview"><div class="journey-step"><span>1</span><div><b>Entender</b><small class="muted">Prompts adaptam a explicação</small></div></div><div class="journey-step"><span>2</span><div><b>Praticar</b><small class="muted">Questões focadas nos pontos fracos</small></div></div><div class="journey-step"><span>3</span><div><b>Memorizar</b><small class="muted">Flashcards e palácio da memória</small></div></div><div class="journey-step"><span>4</span><div><b>Revisar</b><small class="muted">Calendário espaçado automático</small></div></div></div><div class="rec" style="margin-top:18px"><strong>Como funciona</strong><small>O MEDCID combina seu perfil com instruções de estudo e prepara um prompt para a IA que você já usa.</small></div><button id="openFlowingProvider" class="btn full" style="margin-top:12px">Criar prompt da jornada</button></article>
          </div>
        </section>

        <section id="professor" class="panel">
          <div class="section-head"><div><p class="eyebrow" style="color:#7c3aed!important">Sem créditos e sem assinatura adicional</p><h2>Biblioteca de prompts MEDCID</h2><p>Escolha um método, adapte-o automaticamente com o Flowing e envie para a IA que você já usa.</p></div><span class="badge green">100% externa</span></div>
          <article class="card feature-hero"><div class="section-head"><div><h2>Contexto para este prompt</h2><p id="promptProfileStatus">O perfil Flowing será anexado automaticamente.</p></div><div class="actions"><button class="btn small soft" data-jump="flowing">Editar Flowing</button><button class="btn small ghost" data-jump="config">Escolher IA</button></div></div><div class="form grid two"><div class="field"><label>Matéria</label><input id="promptSubject" list="subjectOptions" placeholder="Ex.: Clínica Médica II" /></div><div class="field"><label>Assunto</label><input id="promptTopic" placeholder="Ex.: Anemias microcíticas" /></div><div class="field" style="grid-column:1/-1"><label>Objetivo específico</label><input id="promptObjective" placeholder="Ex.: revisar para a prova e corrigir minhas lacunas" /></div><div class="field" style="grid-column:1/-1"><label>Material ou contexto adicional</label><textarea id="promptMaterial" placeholder="Cole anotações, ementa, erros, questões ou instruções adicionais..."></textarea></div></div></article>
          <div id="promptTemplateGrid" class="prompt-library-grid"></div>
          <article id="customPromptEditor" class="card"><div class="section-head"><div><h2>Construir novo prompt de estudo</h2><p>Crie modelos reutilizáveis. Eles ficam salvos neste navegador e entram no backup.</p></div><span class="badge purple">Biblioteca pessoal</span></div><form id="customPromptForm" class="form grid two"><div class="field"><label>Nome do prompt</label><input id="customPromptName" maxlength="80" placeholder="Ex.: Tutor de eletrocardiograma" required /></div><div class="field"><label>Categoria</label><select id="customPromptCategory"><option>Compreensão</option><option>Compilado</option><option>Memorização</option><option>Questões</option><option>Revisão</option><option>Planejamento</option><option>Outro</option></select></div><div class="field" style="grid-column:1/-1"><label>Instruções do prompt</label><textarea id="customPromptBody" style="min-height:220px" placeholder="Você é um tutor... Use {{materia}}, {{assunto}}, {{objetivo}}, {{material}} e {{perfil}} para personalizar." required></textarea></div><div style="grid-column:1/-1"><small class="muted">Variáveis disponíveis</small><div class="prompt-variable-guide"><code>{{materia}}</code><code>{{assunto}}</code><code>{{objetivo}}</code><code>{{material}}</code><code>{{perfil}}</code></div><div class="actions"><button id="cancelCustomPrompt" class="btn ghost" type="button" style="display:none">Cancelar edição</button><button id="saveCustomPrompt" class="btn" type="submit">Salvar na biblioteca</button></div></div></form><div id="savedPromptList" class="saved-prompt-list"></div></article>
        </section>

        <section id="flashcards" class="panel">
          <div class="section-head"><div><p class="eyebrow" style="color:#ec4899!important">Memorização ativa</p><h2>IA Flashcards</h2><p>Transforme qualquer assunto em cartões prontos para a revisão espaçada.</p></div><span id="flashModeBadge" class="badge purple">Prompt inteligente</span></div>
          <div class="ai-layout">
            <article class="card"><h2>Configurar geração</h2><div class="form grid two"><div class="field"><label>Matéria</label><input id="flashSubject" list="subjectOptions" placeholder="Ex.: Cardiologia" /></div><div class="field"><label>Dificuldade</label><select id="flashDifficulty"><option>Fácil</option><option selected>Médio</option><option>Difícil</option></select></div><div class="field" style="grid-column:1/-1"><label>Tópico ou assunto</label><input id="flashTopic" placeholder="Ex.: Insuficiência cardíaca" /></div><div class="field" style="grid-column:1/-1"><label>Contexto adicional</label><textarea id="flashContext" placeholder="Cole anotações, objetivos da aula ou pontos específicos..."></textarea></div><div class="field"><label>Quantidade</label><select id="flashQuantity"><option>5</option><option>8</option><option>10</option><option>15</option></select></div></div><button id="generateFlashcards" class="btn full">Preparar prompt de flashcards</button><p class="muted" style="font-size:.8rem">Use sua IA preferida e depois importe a resposta para criar o calendário de revisões.</p><div class="external-import"><h3>Importar resposta da IA</h3><p class="muted">Cole aqui o JSON devolvido pelo ChatGPT, Gemini, Claude ou outra IA.</p><textarea id="flashImportResponse" placeholder='{"cards":[{"question":"...","answer":"...","tip":"..."}]}'></textarea><button id="importExternalFlashcards" class="btn soft full" style="margin-top:9px">Importar cartões e agendar revisões</button></div></article>
            <article class="card"><div class="section-head"><div><h2>Revisão de cartões</h2><p id="flashcardCounter">Nenhum cartão gerado ainda.</p></div><div class="actions"><button id="editActiveFlashcard" class="btn small ghost" type="button">Editar</button><button id="deleteActiveFlashcard" class="btn small ghost" type="button">Excluir</button><button id="nextFlashcard" class="btn small soft" type="button">Próximo</button></div></div><div id="flashcardStage" class="flashcard-stage"><div class="empty">Preencha o formulário e clique em “Gerar flashcards”.</div></div></article>
          </div>
          <article class="card manual-flashcard-card"><div class="section-head"><div><p class="eyebrow" style="color:#ec4899!important">Criação manual</p><h2>Registrar meu próprio flashcard</h2><p>Cadastre sua pergunta e treine imediatamente com a mesma revisão espaçada.</p></div><span class="badge purple">Revisões: 1, 4, 7, 11, 26 e 56 dias</span></div><form id="manualFlashcardForm" class="form grid two"><div class="field"><label>Matéria</label><input id="manualFlashSubject" list="subjectOptions" placeholder="Ex.: Clínica Médica II" required /></div><div class="field"><label>Assunto</label><input id="manualFlashTopic" placeholder="Ex.: Anemias" required /></div><div class="field"><label>Dificuldade</label><select id="manualFlashDifficulty"><option>Fácil</option><option selected>Médio</option><option>Difícil</option></select></div><div class="field"><label>Dica opcional</label><input id="manualFlashTip" placeholder="Uma pista sem entregar a resposta" /></div><div class="field" style="grid-column:1/-1"><label>Pergunta</label><textarea id="manualFlashQuestion" placeholder="Escreva uma pergunta objetiva..." required></textarea></div><div class="field" style="grid-column:1/-1"><label>Resposta</label><textarea id="manualFlashAnswer" placeholder="Escreva a resposta correta..." required></textarea></div><button class="btn" type="submit" style="grid-column:1/-1">Adicionar e iniciar revisão</button></form></article>
        </section>

        <section id="diagnostico" class="panel">
          <div class="section-head"><div><p class="eyebrow" style="color:#2563eb!important">Projeto Angels · etapa 1</p><h2>Diagnóstico acadêmico</h2><p>Mapeie sua situação atual com honestidade. O resultado alimenta prioridades, plano e biblioteca de prompts.</p></div><span class="badge blue">10 perguntas</span></div>
          <div class="diagnosis-layout">
            <article class="card angels-banner"><h2>Contexto do ciclo</h2><div class="form grid two"><div class="field"><label>Horas disponíveis por dia</label><input id="angelsHours" type="number" min="0.5" max="12" step="0.5" value="3" /></div><div class="field"><label>Conteúdos atrasados</label><input id="angelsBacklog" type="number" min="0" value="0" /></div><div class="field"><label>Provas próximas</label><input id="angelsExams" type="number" min="0" value="0" /></div><div class="field"><label>Trabalhos/projetos</label><input id="angelsProjects" type="number" min="0" value="0" /></div><div class="field" style="grid-column:1/-1"><label>Principal dificuldade</label><select id="angelsReason"><option>Falta de planejamento</option><option>Muitas disciplinas simultâneas</option><option>Conteúdo acumulado</option><option>Baixa constância</option><option>Dificuldade de concentração</option><option>Ansiedade com avaliações</option><option>Não sei por onde começar</option></select></div></div><div id="diagnosisScoreRing" class="diagnosis-score" style="--score-deg:0deg"><div><div><strong id="diagnosisScoreValue">0%</strong><small>clareza e controle</small></div></div></div><p id="diagnosisReading" style="text-align:center">Responda às perguntas para receber uma leitura inicial.</p><button id="saveDiagnosis" class="btn full">Salvar diagnóstico e calcular prioridades</button><div class="rec" style="margin-top:12px"><strong>Nota de cuidado</strong><small>Esta é uma ferramenta de organização acadêmica. Não substitui acompanhamento pedagógico, psicológico ou médico.</small></div></article>
            <article class="card"><div class="section-head"><div><h2>Como está sua rotina hoje?</h2><p>1 = discordo totalmente · 5 = concordo totalmente.</p></div></div><div id="diagnosisQuestionList" class="diagnosis-questions"></div></article>
          </div>
        </section>

        <section id="prioridades" class="panel">
          <div class="section-head"><div><p class="eyebrow" style="color:#dc2626!important">Projeto Angels · etapa 2</p><h2>Matriz de prioridades</h2><p>Compare urgência, importância, dificuldade, atraso, peso da prova e possibilidade de recuperação.</p></div><button id="generatePlanFromPriorities" class="btn">Gerar plano de 7 dias</button></div>
          <div class="priority-summary"><div class="top-priority"><span>Prioridade principal</span><strong id="topPriorityName">Nenhuma matéria</strong></div><div><span>Críticas/altas</span><strong id="highPriorityCount">0</strong></div><div><span>Disciplinas avaliadas</span><strong id="assessedSubjectCount">0</strong></div><div><span>Pesos do algoritmo</span><strong id="priorityWeightTotal">100%</strong></div></div>
          <article class="card" style="margin-bottom:16px"><div class="section-head"><div><h2>Pesos de decisão</h2><p>Ajuste apenas se algum critério for especialmente importante neste ciclo.</p></div></div><div id="priorityWeightGrid" class="weight-grid"></div></article>
          <div id="priorityCards" class="priority-board"></div>
        </section>

        <section id="plano7" class="panel">
          <div class="section-head"><div><p class="eyebrow" style="color:#16a34a!important">Projeto Angels · etapa 3</p><h2>Plano executável de 7 dias</h2><p>Um bloco principal, uma revisão e uma aplicação em questões por dia.</p></div><button id="regeneratePlan7" class="btn">Gerar novo plano</button></div>
          <div class="plan-toolbar"><div class="stat info"><strong id="planTaskCount">0</strong><span>tarefas planejadas</span></div><div class="stat good"><strong id="planExecutionRate">0%</strong><span>execução</span></div><div class="stat warn"><strong id="planMinutesDone">0h</strong><span>horas realizadas</span></div><div class="stat"><strong id="planQuestionsDone">0</strong><span>questões feitas</span></div></div>
          <div id="planEmpty" class="empty">Conclua o diagnóstico, avalie as matérias e gere seu plano.</div><div id="planWeek" class="plan-week"></div>
          <article class="card glow" style="margin-top:16px"><h2>Regra de sustentabilidade</h2><p>Se a execução cair, reduza o volume antes de aumentar a pressão. Clique em cada tarefa para alternar entre pendente, parcial e concluída.</p></article>
        </section>

        <section id="erros" class="panel">
          <div class="section-head"><div><p class="eyebrow" style="color:#f97316!important">Projeto Angels · etapa 4</p><h2>Banco de erros</h2><p>Transforme cada falha em revisão, flashcard ou prompt de correção personalizado.</p></div><span id="openErrorsBadge" class="badge orange">0 abertos</span></div>
          <div class="error-layout">
            <article class="card"><h2>Registrar novo erro</h2><div class="form grid two"><div class="field"><label>Disciplina</label><input id="errorSubject" list="subjectOptions" placeholder="Ex.: Cardiologia" /></div><div class="field"><label>Assunto</label><input id="errorTopic" placeholder="Ex.: ECG" /></div><div class="field"><label>Origem</label><select id="errorOrigin"><option>Banco de questões</option><option>Simulado</option><option>Aula</option><option>Prova</option><option>Flashcard</option><option>Discussão clínica</option></select></div><div class="field"><label>Tipo do erro</label><select id="errorType"><option>Confundi conceitos</option><option>Erro de interpretação</option><option>Esquecimento</option><option>Leitura rápida</option><option>Falta de conhecimento</option><option>Erro de cálculo</option></select></div><div class="field"><label>Importância</label><select id="errorImportance"><option value="5">5 · Muito alta</option><option value="4">4 · Alta</option><option value="3">3 · Média</option><option value="2">2 · Baixa</option><option value="1">1 · Mínima</option></select></div><div class="field"><label>Status</label><select id="errorStatus"><option>Não corrigido</option><option>Em revisão</option><option>Recorrente</option><option>Corrigido</option></select></div><div class="field" style="grid-column:1/-1"><label>Conceito correto / como evitar novamente</label><textarea id="errorConcept" placeholder="Escreva a regra, associação ou raciocínio que corrige o erro..."></textarea></div></div><button id="addError" class="btn full">Adicionar ao banco de erros</button></article>
            <article class="card"><div class="section-head"><div><h2>Erros registrados</h2><p id="errorPatternSummary">Os padrões aparecerão após os primeiros registros.</p></div><select id="errorFilter" style="max-width:180px"><option>Todos</option><option>Não corrigido</option><option>Em revisão</option><option>Recorrente</option><option>Corrigido</option></select></div><div id="errorList" class="error-list"></div></article>
          </div>
        </section>

        <section id="progresso" class="panel">
          <div class="section-head"><div><p class="eyebrow" style="color:#06b6d4!important">Projeto Angels · etapa 5</p><h2>Progresso e check-in diário</h2><p>Leia tendências, energia e capacidade real — não julgamentos.</p></div><span class="badge blue">Ciclo de 7 dias</span></div>
          <div class="plan-toolbar"><div class="stat info"><strong id="progressExecution">0%</strong><span>execução</span></div><div class="stat good"><strong id="progressHours">0h</strong><span>horas realizadas</span></div><div class="stat warn"><strong id="progressQuestions">0</strong><span>questões</span></div><div class="stat bad"><strong id="progressRecurringErrors">0</strong><span>erros recorrentes</span></div></div>
          <div class="checkin-layout"><article class="card"><h2>Check-in de hoje</h2><div class="form"><div class="field"><label>Execução percebida: <b id="checkinExecutionValue">70%</b></label><input id="checkinExecution" type="range" min="0" max="100" step="5" value="70" /></div><div class="field"><label>Energia: <b id="checkinEnergyValue">3/5</b></label><input id="checkinEnergy" type="range" min="1" max="5" value="3" /></div><div class="field"><label>Foco: <b id="checkinFocusValue">3/5</b></label><input id="checkinFocus" type="range" min="1" max="5" value="3" /></div><div class="field"><label>Maior desafio</label><input id="checkinChallenge" placeholder="O que dificultou seu estudo?" /></div><div class="field"><label>Conquista do dia</label><input id="checkinWin" placeholder="O que você conseguiu avançar?" /></div></div><button id="saveCheckin" class="btn full">Salvar check-in</button></article><article class="card"><div class="section-head"><div><h2>Execução ao longo do ciclo</h2><p>Planejado versus concluído nos sete dias.</p></div></div><div id="executionChart" class="checkin-score"></div><h3 style="margin-top:18px">Histórico de check-ins</h3><div id="checkinHistory" class="checkin-history"></div></article></div>
        </section>

        <section id="relatorio" class="panel">
          <div class="section-head"><div><p class="eyebrow" style="color:#7c3aed!important">Projeto Angels · etapa 6</p><h2>Relatório do ciclo</h2><p>Separe dados registrados, interpretações e próximos passos.</p></div><div class="actions"><button id="copyAngelsReport" class="btn soft">Copiar resumo</button><button id="exportPlanCsv" class="btn soft">Exportar CSV</button><button id="printAngelsReport" class="btn">Imprimir / PDF</button></div></div>
          <div class="report-cover"><div><span class="eyebrow">MEDCID · PROJETO ANGELS</span><h2>Relatório de recuperação acadêmica</h2><p id="reportCycleSummary">Ciclo pessoal de sete dias · dados armazenados neste dispositivo</p></div><strong><span id="reportExecutionBig">0</span><small>%</small><span>execução geral</span></strong></div>
          <article class="card report-section"><div class="report-label">01 · Dados observados</div><div id="reportStats" class="report-grid"></div><p id="reportObservedText"></p></article>
          <article class="card report-section"><div class="report-label">02 · Interpretação do sistema</div><h2 id="reportPriorityTitle">A prioridade principal ainda não foi definida</h2><p id="reportInferenceText"></p></article>
          <article class="card report-section"><div class="report-label">03 · Recomendações</div><ol id="reportRecommendations" class="report-recommendations"></ol></article>
        </section>

        <section id="horario" class="panel">
          <div class="section-head">
            <div><h2>Horário semanal</h2><p>Monte seus blocos como na planilha original: DOM a SAB, de madrugada até a noite.</p></div>
            <button id="addSchedule" class="btn">+ Adicionar bloco</button>
          </div>
          <form id="scheduleForm" class="form grid five">
            <div class="field"><label>Dia</label><select id="day"><option>DOM</option><option>SEG</option><option>TER</option><option>QUA</option><option>QUI</option><option>SEX</option><option>SAB</option></select></div>
            <div class="field"><label>Horário</label><input id="time" type="time" value="07:00" /></div>
            <div class="field"><label>Atividade</label><input id="activity" placeholder="Disciplina/atividade" /></div>
            <div class="field"><label>Tipo</label><select id="type"><option>Teoria</option><option>Questões</option><option>Revisão</option><option>Prática</option><option>Simulado</option><option>Livre</option><option>Não estudar</option><option>Trânsito</option><option>Sono</option></select></div>
            <div class="field"><label>Local</label><input id="place" placeholder="Anexo, HUGV, casa..." /></div>
          </form>
          <div class="filters">
            <button id="seedSchedule" class="btn soft">Preencher modelo do PDF</button>
            <button id="clearSchedule" class="btn ghost">Limpar horário</button>
            <span class="badge gray">Dica: arraste um bloco para outro horário.</span>
          </div>
          <div id="scheduleNow" class="schedule-now" aria-label="Indicador do horário atual">
            <span class="schedule-now-dot" aria-hidden="true"></span>
            <div><strong id="scheduleNowTitle">Localizando o horário atual...</strong><small id="scheduleNowCaption">A linha vermelha acompanha o seu dia na grade.</small></div>
            <button id="jumpScheduleNow" class="btn small soft" type="button">Ir para agora</button>
          </div>
          <div id="weekGrid" class="week-grid"></div>
          <div class="table-wrap" style="margin-top:14px"><table id="scheduleTable"></table></div>
        </section>

        <section id="disciplinas" class="panel">
          <div class="section-head">
            <div><h2>Disciplinas e assuntos</h2><p>Cadastre peso, meta, assuntos e temperatura Pareto.</p></div>
            <button id="addSubject" class="btn">+ Adicionar disciplina</button>
          </div>
          <form id="subjectForm" class="form grid five">
            <div class="field"><label>Disciplina</label><input id="subjectName" placeholder="Ex.: Anestesiologia" /></div>
            <div class="field"><label>Peso</label><input id="subjectWeight" type="number" min="1" value="8" /></div>
            <div class="field"><label>Meta h/semana</label><input id="subjectGoal" type="number" min="1" value="4" /></div>
            <div class="field"><label>Prioridade</label><select id="subjectPriority"><option>Prioritária</option><option>Complementar</option><option>Residual</option></select></div>
            <div class="field"><label>Cor</label><input id="subjectColor" type="color" value="#7c3aed" /></div>
          </form>
          <div class="filters">
            <button id="seedSubjects" class="btn soft">Preencher disciplinas do 6º período</button>
            <button id="openTopicModal" class="btn ghost">+ Adicionar assunto</button>
          </div>
          <div id="subjectCards" class="subject-grid"></div>
        </section>

        <section id="revisoes" class="panel">
          <div class="section-head">
            <div><p class="eyebrow" style="color:#16a34a!important">Memória de longo prazo</p><h2>Calendário de revisões espaçadas</h2><p>Visualize revisões, flashcards e provas em um único calendário inteligente.</p></div>
            <button id="addReview" class="btn">+ Gerar revisão</button>
          </div>
          <div class="calendar-shell">
            <article class="card"><div class="section-head"><div><h2 id="calendarMonthLabel">Calendário</h2><p><span class="badge purple">● Revisões</span> <span class="badge" style="color:#ec4899">● Flashcards</span> <span class="badge" style="color:#f59e0b">● Pré-prova</span> <span class="badge red">● Provas</span></p></div><div class="calendar-nav"><button id="prevCalendarMonth" class="btn small ghost" type="button" aria-label="Mês anterior">‹</button><button id="calendarToday" class="btn small soft today-btn" type="button">Hoje</button><button id="nextCalendarMonth" class="btn small ghost" type="button" aria-label="Próximo mês">›</button></div></div><div id="reviewCalendarGrid" class="month-grid"></div></article>
            <article class="card glow"><h2>Como funciona</h2><p>Cada resposta ajusta o próximo encontro com o conteúdo.</p><div class="review-cycle"><div class="cycle-step"><b>Revisão 1</b><span class="badge purple">+1 dia</span></div><div class="cycle-step"><b>Revisão 2</b><span class="badge purple">+4 dias</span></div><div class="cycle-step"><b>Revisão 3</b><span class="badge purple">+7 dias</span></div><div class="cycle-step"><b>Revisão 4</b><span class="badge purple">+11 dias</span></div><div class="cycle-step"><b>Revisão 5</b><span class="badge purple">+26 dias</span></div><div class="cycle-step"><b>Revisão 6</b><span class="badge purple">+56 dias</span></div></div></article>
          </div>
          <form id="reviewForm" class="form grid five">
            <div class="field"><label>Disciplina</label><input id="reviewSubject" placeholder="Disciplina" list="subjectOptions" /></div>
            <div class="field"><label>Assunto</label><input id="reviewTopic" placeholder="Assunto/tópico" /></div>
            <div class="field"><label>Primeiro contato</label><input id="reviewDate" type="date" /></div>
            <div class="field"><label>Prioridade</label><select id="reviewPriority"><option>Alta</option><option>Média</option><option>Baixa</option></select></div>
            <div class="field"><label>Atividade</label><select id="reviewKind"><option>Teoria</option><option>Questões</option><option>Resumo</option><option>Aula</option></select></div>
          </form>
          <div class="filters">
            <input id="reviewFilter" placeholder="Filtrar por disciplina, tópico ou data" />
            <select id="reviewStatus"><option value="all">Todas</option><option value="today">Hoje</option><option value="overdue">Atrasadas</option><option value="pending">Pendentes</option><option value="done">Concluídas</option></select>
            <button id="generateFromTopics" class="btn soft">Gerar revisão dos assuntos concluídos</button>
          </div>
          <div class="table-wrap"><table id="reviewTable"></table></div>
        </section>

        <section id="habitos" class="panel">
          <div class="section-head"><div><p class="eyebrow" style="color:#f97316!important">Constância</p><h2>Hábitos de estudo</h2><p>Pequenas ações repetidas todos os dias constroem resultados duradouros.</p></div><button id="addHabit" class="btn">+ Novo hábito</button></div>
          <div class="habit-summary"><div class="stat good"><strong id="habitWeekRate">0%</strong><span>conclusão semanal</span></div><div class="stat info"><strong id="habitDoneCount">0</strong><span>check-ins feitos</span></div><div class="stat warn"><strong id="habitBestStreak">0</strong><span>melhor sequência</span></div></div>
          <article class="card"><div class="section-head"><div><h2>Minha semana</h2><p>Clique nos quadrados para registrar seu progresso.</p></div><span id="habitWeekLabel" class="badge gray"></span></div><div class="habit-table-wrap"><div id="habitGrid" class="habit-grid"></div></div></article>
          <article class="card glow" style="margin-top:16px"><h2>Ritmo sustentável</h2><p>Priorize poucos hábitos que realmente aproximam você das suas metas. O dashboard considera seus check-ins para calcular a sequência de estudos.</p></article>
        </section>

        <section id="questoes" class="panel">
          <div class="section-head">
            <div><h2>Banco de questões e erros</h2><p>Registre desempenho por assunto. O site identifica pontos fracos.</p></div>
            <button id="addQuestionSession" class="btn">+ Registrar sessão</button>
          </div>
          <form id="questionForm" class="form grid five">
            <div class="field"><label>Disciplina</label><input id="qSubject" list="subjectOptions" placeholder="Disciplina" /></div>
            <div class="field"><label>Assunto</label><input id="qTopic" placeholder="Assunto" /></div>
